import Mathlib

/-! Definitions used in the Challenge statements, together with the
construction-only helper lemmas needed to elaborate their bodies. -/

section
namespace SimisFormal
open MvPolynomial
open scoped BigOperators
section SymbolicPower
variable {R : Type*} [CommRing R]
/-- The symbolic power defined by contraction from the localizations at minimal primes. -/
noncomputable def symbolicPower (I : Ideal R) (q : ℕ) : Ideal R :=
  ⨅ P : I.minimalPrimes,
    letI : P.1.IsPrime := P.2.isPrime
    Ideal.comap (algebraMap R (Localization.AtPrime P.1))
      (Ideal.map (algebraMap R (Localization.AtPrime P.1)) (I ^ q))

/-- A Simis ideal has equality of every positive symbolic and ordinary power. -/
def IsSimis (I : Ideal R) : Prop :=
  ∀ q : ℕ, 1 ≤ q → symbolicPower I q = I ^ q

/-- The componentwise expression for symbolic powers from Eq. (2). -/
noncomputable def componentSymbolic {ι : Type*} (Q : ι → Ideal R) (q : ℕ) : Ideal R :=
  ⨅ i, Q i ^ q

/-- Hypothesis packaging Eq. (2); this keeps standard input explicit when used later. -/
def HasStdSymbolicFormula (I : Ideal R) {ι : Type*} (Q : ι → Ideal R) : Prop :=
  ∀ q : ℕ, 1 ≤ q → symbolicPower I q = componentSymbolic Q q

/-- Simis relative to a chosen irreducible component family. -/
def ComponentSimis (I : Ideal R) {ι : Type*} (Q : ι → Ideal R) : Prop :=
  ∀ q : ℕ, 1 ≤ q → I ^ q = componentSymbolic Q q

end SymbolicPower
variable {σ K : Type*} [Field K] [DecidableEq σ]
/-- The monomial ideal generated by a set of exponent vectors. -/
noncomputable def monomialIdeal (S : Set (σ →₀ ℕ)) : Ideal (MvPolynomial σ K) :=
  Ideal.span ((fun e : σ →₀ ℕ => monomial e (1 : K)) '' S)

/-- A component of an irreducible monomial decomposition. -/
noncomputable def purePower (A : Finset σ) (a : σ → ℕ) : Ideal (MvPolynomial σ K) :=
  monomialIdeal {e : σ →₀ ℕ | ∃ i ∈ A, e = Finsupp.single i (a i)}

/-- The prime generated by the variables in a support set. -/
noncomputable def primeOf (A : Finset σ) : Ideal (MvPolynomial σ K) :=
  purePower A (fun _ => 1)

/-- Minimal monomial generators, as a set of exponent vectors. -/
noncomputable def minGens (I : Ideal (MvPolynomial σ K)) : Set (σ →₀ ℕ) :=
  {e | (monomial e (1 : K) : MvPolynomial σ K) ∈ I ∧
    ∀ u, (monomial u (1 : K) : MvPolynomial σ K) ∈ I → u ≤ e → u = e}

/-- The monomial support complex. -/
def supportComplex (I : Ideal (MvPolynomial σ K)) : Set (Finset σ) :=
  {A | ∃ e ∈ minGens I, e.support = A}

omit [DecidableEq σ] in
/-- A clutter is an antichain of finite vertex sets. -/
def IsClutter (H : Set (Finset σ)) : Prop :=
  ∀ A ∈ H, ∀ B ∈ H, A ⊆ B → A = B

/-- A finite vertex set meeting every edge of a clutter. -/
def IsTransversal (H : Set (Finset σ)) (T : Finset σ) : Prop :=
  ∀ E ∈ H, (E ∩ T).Nonempty

/-- The blocker consists of inclusion-minimal transversals. -/
def blocker (H : Set (Finset σ)) : Set (Finset σ) :=
  {T | IsTransversal H T ∧ ∀ U, U ⊂ T → ¬ IsTransversal H U}

/-- An ideal that admits some set of monomial generators. -/
def IsMonomialIdeal (I : Ideal (MvPolynomial σ K)) : Prop :=
  ∃ S : Set (σ →₀ ℕ), I = monomialIdeal S

omit [DecidableEq σ] in
/-- Coordinatewise multiplication of exponent vectors by a diagonal weight. -/
noncomputable def diagExp (d : σ → ℕ) (e : σ →₀ ℕ) : σ →₀ ℕ :=
  Finsupp.onFinset e.support (fun i ↦ e i * d i) (by
    intro i hi
    rw [Finsupp.mem_support_iff]
    intro hei
    exact hi (by simp [hei]))

omit [DecidableEq σ] in
/-- Coordinatewise floor division by a diagonal weight. -/
noncomputable def floorDiv (d : σ → ℕ) (e : σ →₀ ℕ) : σ →₀ ℕ :=
  Finsupp.onFinset e.support (fun i ↦ e i / d i) (by
    intro i hi
    rw [Finsupp.mem_support_iff]
    intro hei
    exact hi (by simp [hei]))

/-- The diagonal ring endomorphism \(x_i \mapsto x_i^{d_i}\). -/
noncomputable def diagHom (d : σ → ℕ) : MvPolynomial σ K →+* MvPolynomial σ K :=
  eval₂Hom C (fun i ↦ X i ^ d i)

/-- Image of an ideal under a diagonal endomorphism. -/
noncomputable def diagonal (d : σ → ℕ) (I : Ideal (MvPolynomial σ K)) :
    Ideal (MvPolynomial σ K) :=
  Ideal.map (diagHom (K := K) d) I

/-- Squarefree exponent supported on a finite variable set. -/
noncomputable def characteristicExp (A : Finset σ) : σ →₀ ℕ :=
  Finsupp.onFinset A (fun i ↦ if i ∈ A then 1 else 0) (by
    intro i hi
    by_contra hnot
    exact hi (by simp [hnot]))

/-- A squarefree monomial ideal, represented by squarefree squarefree generators. -/
def IsSquarefreeMonomialIdeal (I : Ideal (MvPolynomial σ K)) : Prop :=
  ∃ H : Set (Finset σ), I = monomialIdeal (characteristicExp '' H)

/-- Existence of a squarefree diagonal root; the root need not be Simis. -/
def HasSqRoot (I : Ideal (MvPolynomial σ K)) : Prop :=
  ∃ J d, IsSquarefreeMonomialIdeal J ∧ (∀ i, 0 < d i) ∧ diagonal d J = I

/-- Existence of a squarefree Simis diagonal root (MPV conclusion). -/
def MPVConc (I : Ideal (MvPolynomial σ K)) : Prop :=
  ∃ J d, IsSquarefreeMonomialIdeal J ∧ IsSimis J ∧ (∀ i, 0 < d i) ∧ diagonal d J = I

/-- Cyclic successor on `Fin q`. -/
def finSuccMod {q : ℕ} (i : Fin q) : Fin q :=
  if h : i.val + 1 < q then ⟨i.val + 1, h⟩
  else ⟨0, lt_of_le_of_lt (Nat.zero_le _) i.isLt⟩

/-- A clutter contains a strong `q`-cycle in the paper's incidence sense. -/
def HasStrongCycle (H : Set (Finset σ)) (q : ℕ) : Prop :=
  3 ≤ q ∧ ∃ v : Fin q → σ, Function.Injective v ∧
    ∃ E : Fin q → Finset σ, Function.Injective E ∧
      (∀ i, E i ∈ H) ∧
      ∀ i, E i ∩ (Finset.univ.image v) = {v i, v (finSuccMod i)}

/-- A strong triangle is a strong cycle of length three. -/
def HasStrongTriangle (H : Set (Finset σ)) : Prop :=
  HasStrongCycle H 3

/-- Balanced means there is no strong odd cycle. -/
def IsBalanced (H : Set (Finset σ)) : Prop :=
  ∀ q : ℕ, Odd q → ¬ HasStrongCycle H q

/-- Faridi's leaf condition on a facet-generated clutter. -/
def IsLeaf (H : Set (Finset σ)) (F : Finset σ) : Prop :=
  F ∈ H ∧
    ((∀ G ∈ H, G = F) ∨
      ∃ G ∈ H, G ≠ F ∧ ∀ H' ∈ H, H' ≠ F → H' ∩ F ⊆ F ∩ G)

/-- A simplicial forest in Faridi's facet-generated sense. -/
def IsSimplicialForest (H : Set (Finset σ)) : Prop :=
  ∀ K : Set (Finset σ), K ⊆ H → K.Nonempty → ∃ F ∈ K, IsLeaf K F

/-- Data for an irreducible decomposition \(I=\bigcap_j Q_j\). -/
def HasComponents (I : Ideal (MvPolynomial σ K)) (A : ι → Finset σ)
    (a : ι → σ → ℕ) : Prop :=
  I = ⨅ j, (purePower (A j) (a j) : Ideal (MvPolynomial σ K))

/-- The intersection of all components except the `j`th. -/
noncomputable def decompOmit (A : ι → Finset σ) (a : ι → σ → ℕ) (j : ι) :
    Ideal (MvPolynomial σ K) :=
  ⨅ k : {k : ι // k ≠ j}, purePower (A k.1) (a k.1)

/-- Irredundance of the displayed component family. -/
def IsIrredundant (A : ι → Finset σ) (a : ι → σ → ℕ) : Prop :=
  ∀ j, ¬ (decompOmit A a j : Ideal (MvPolynomial σ K)) ≤ purePower (A j) (a j)

/-- Irredundant irreducible decomposition data. -/
def IsIrredundantDecomp (I : Ideal (MvPolynomial σ K)) (A : ι → Finset σ)
    (a : ι → σ → ℕ) : Prop :=
  HasComponents I A a ∧ IsIrredundant (K := K) A a

/-- Existence of a finite irredundant irreducible decomposition, with no antichain condition. -/
def HasFiniteIrredundantDecomp (I : Ideal (MvPolynomial σ K)) : Prop :=
  ∃ (κ : Type) (_ : Fintype κ) (A : κ → Finset σ) (a : κ → σ → ℕ),
    IsIrredundantDecomp (K := K) I A a

/-- Component supports form an antichain, hence are distinct and have no embedded primes. -/
def SupportsAntichain (A : ι → Finset σ) (_a : ι → σ → ℕ) : Prop :=
  ∀ j k, A j ⊆ A k → j = k

/-- The standing MPV hypotheses used in the paper's positive criteria. -/
def MPVHypotheses (I : Ideal (MvPolynomial σ K)) (A : ι → Finset σ)
    (a : ι → σ → ℕ) : Prop :=
  IsIrredundantDecomp I A a ∧ SupportsAntichain A a ∧ IsSimis I

/-- Positive exponents occurring in a minimal generator at a variable. -/
def generatorExponents (I : Ideal (MvPolynomial σ K)) (i : σ) : Set ℕ :=
  {n | 0 < n ∧ ∃ e ∈ minGens I, e i = n}

/-- Exponents assigned to a variable by components containing it. -/
def componentExponents (A : ι → Finset σ) (a : ι → σ → ℕ) (i : σ) : Set ℕ :=
  {n | ∃ j, i ∈ A j ∧ a j i = n}

/-- Component pairs with intersecting supports and different assigned exponents. -/
def mismatchPairs (A : ι → Finset σ) (a : ι → σ → ℕ) : Set (ι × ι) :=
  {p | ∃ i, i ∈ A p.1 ∧ i ∈ A p.2 ∧ a p.1 i ≠ a p.2 i}

/-- Support preservation \(F(I)=F(\sqrt I)\). -/
def SupportPreserving (I : Ideal (MvPolynomial σ K)) : Prop :=
  supportComplex I = supportComplex I.radical

/-- Add a fresh variable `none` to every facet of a clutter. -/
def coneClutter (H : Set (Finset σ)) : Set (Finset (Option σ)) :=
  (fun E ↦ insert none (E.image some)) '' H

/-- Multiplication by a fresh variable, using `Option.none` as the new variable. -/
noncomputable def coneIdeal (I : Ideal (MvPolynomial σ K)) :
    Ideal (MvPolynomial (Option σ) K) :=
  Ideal.map (MvPolynomial.rename (Option.some : σ → Option σ)) I *
    primeOf ({none} : Finset (Option σ))

end SimisFormal
end

section
namespace SimisFormal
open MvPolynomial
open scoped BigOperators
variable {σ K ι : Type*} [Field K] [DecidableEq σ]
/-- Group the original irreducible components by equality of radicals, indexed directly
by the intrinsic minimal primes of `I`. Embedded radicals therefore have no group. -/
noncomputable def groupedComponents (I : Ideal (MvPolynomial σ K))
    (A : ι → Finset σ) (a : ι → σ → ℕ) : I.minimalPrimes → Ideal (MvPolynomial σ K) :=
  fun P ↦ ⨅ j : {j : ι // primeOf (A j) = P.1},
    (purePower (A j.1) (a j.1) : Ideal (MvPolynomial σ K))

end SimisFormal
end

section
namespace SimisFormal
variable {σ Λ : Type*} [DecidableEq σ]
/-- The facets of a clutter containing a fixed vertex. -/
abbrev lem43_facetsThrough (H : Set (Finset σ)) (z : σ) :=
  {E : Finset σ // E ∈ H ∧ z ∈ E}

end SimisFormal
end

section
namespace SimisFormal
variable {σ K ι : Type*} [Field K] [DecidableEq σ]
open MvPolynomial
open scoped BigOperators
/-- The paper's convention: all positive powers have no associated primes beyond `Ass(S/I)`. -/
def prop21NormallyTorsionFree (I : Ideal (MvPolynomial σ K)) : Prop :=
  ∀ q : ℕ, 1 ≤ q →
    associatedPrimes (MvPolynomial σ K) (MvPolynomial σ K ⧸ I ^ q) ⊆
      associatedPrimes (MvPolynomial σ K) (MvPolynomial σ K ⧸ I)

omit [Field K] [DecidableEq σ] in
/-- The paper's ordered mismatch pairs \((k,\ell)\) with \(k<\ell\). -/
def prop21_XI [LinearOrder ι] (A : ι → Finset σ) (a : ι → σ → ℕ) : Set (ι × ι) :=
  {p | p.1 < p.2 ∧ p ∈ mismatchPairs A a}

end SimisFormal
end

section
namespace SimisFormal
open MvPolynomial
open scoped BigOperators
variable {σ K ι : Type*} [Field K] [DecidableEq σ] [Fintype σ]
noncomputable section
/-- Group all pure-power components having a fixed support (equivalently, a fixed radical).

This is deliberately indexed by the *distinct* radicals.  Embedded radicals are retained; only
components with the same radical are intersected.  Thus no antichain hypothesis is implicit. -/
noncomputable def diagAssoc_groupedComponent (A : ι → Finset σ) (a : ι → σ → ℕ)
    (B : Set.range A) : Ideal (MvPolynomial σ K) :=
  ⨅ j : {j : ι // A j = B.1}, (purePower (A j.1) (a j.1) : Ideal (MvPolynomial σ K))

/-- The set obtained by grouping a pure-power family by equal radical. -/
noncomputable def diagAssoc_groupedComponents (A : ι → Finset σ) (a : ι → σ → ℕ) :
    Set (Ideal (MvPolynomial σ K)) :=
  Set.range (diagAssoc_groupedComponent (K := K) A a)

/-- A finite set of primary ideals representing a minimal primary decomposition. -/
def diagAssoc_IsCanonicalPrimarySet (I : Ideal (MvPolynomial σ K))
    (C : Set (Ideal (MvPolynomial σ K))) : Prop :=
  ∃ t : Finset (Ideal (MvPolynomial σ K)), (t : Set _) = C ∧
    Submodule.IsMinimalPrimaryDecomposition I t

end
end SimisFormal
end

section
namespace SimisFormal
open MvPolynomial
open scoped BigOperators
variable {σ K : Type*} [Field K] [DecidableEq σ]
/-- Extend an exponent vector by giving the new variable exponent zero. -/
noncomputable def extendExp (e : σ →₀ ℕ) : Option σ →₀ ℕ :=
  Finsupp.mapDomain (Option.some : σ → Option σ) e

/-- Extend an exponent vector and add one copy of the cone variable. -/
noncomputable def coneExp (e : σ →₀ ℕ) : Option σ →₀ ℕ :=
  extendExp e + Finsupp.single none 1

/-- The five variables in the counterexample of Section 3. -/
inductive Cor33Var | a | b | c | d | z deriving DecidableEq

instance : Fintype Cor33Var where
  elems := {Cor33Var.a, Cor33Var.b, Cor33Var.c, Cor33Var.d, Cor33Var.z}
  complete := by intro x; cases x <;> simp

/-- The four irreducible components of the base example. -/
inductive Cor33Comp | q1 | q2 | q3 | q4 deriving DecidableEq

/-- Compact exponent notation for the five variables. -/
noncomputable def cor33Exp (a b c d z : ℕ) : Cor33Var →₀ ℕ :=
  (Finsupp.equivFunOnFinite).symm (fun i =>
    match i with
    | Cor33Var.a => a
    | Cor33Var.b => b
    | Cor33Var.c => c
    | Cor33Var.d => d
    | Cor33Var.z => z)

/-- The weights used when \(r=s\). -/
def cor33BaseWeight (rho : ℕ) : Cor33Var → ℕ
  | Cor33Var.a | Cor33Var.b | Cor33Var.c | Cor33Var.d => 1
  | Cor33Var.z => rho

/-- The cone weight fixes the cone variable and uses the base weight elsewhere. -/
def cor33ConeWeight (rho : ℕ) : Option Cor33Var → ℕ
  | none => 1
  | some i => cor33BaseWeight rho i

/-- The four generators \(ac,bd,abz^r,cdz^s\). -/
noncomputable def cor33BaseGens (r s : ℕ) : Finset (Cor33Var →₀ ℕ) :=
  {cor33Exp 1 0 1 0 0, cor33Exp 0 1 0 1 0,
    cor33Exp 1 1 0 0 r, cor33Exp 0 0 1 1 s}

/-- The base ideal \(I_{r,s}\). -/
noncomputable def cor33BaseIdeal (r s : ℕ) : Ideal (MvPolynomial Cor33Var K) :=
  monomialIdeal (cor33BaseGens r s : Set (Cor33Var →₀ ℕ))

/-- The generator support clutter from Remark 3.2. -/
def cor33BaseClutter : Set (Finset Cor33Var) :=
  {A | A = {Cor33Var.a, Cor33Var.c} ∨ A = {Cor33Var.b, Cor33Var.d} ∨
    A = {Cor33Var.a, Cor33Var.b, Cor33Var.z} ∨
    A = {Cor33Var.c, Cor33Var.d, Cor33Var.z}}

/-- The squarefree monomial ideal from Theorem 3.1. -/
noncomputable def cor33RadicalIdeal : Ideal (MvPolynomial Cor33Var K) :=
  cor33BaseIdeal (K := K) 1 1

/-- Supports of the four displayed irreducible components. -/
def cor33ComponentSupport : Cor33Comp → Finset Cor33Var
  | Cor33Comp.q1 => {Cor33Var.a, Cor33Var.b, Cor33Var.z}
  | Cor33Comp.q2 => {Cor33Var.a, Cor33Var.d}
  | Cor33Comp.q3 => {Cor33Var.b, Cor33Var.c}
  | Cor33Comp.q4 => {Cor33Var.c, Cor33Var.d, Cor33Var.z}

/-- Exponents of the four displayed irreducible components. -/
noncomputable def cor33ComponentExp (r s : ℕ) : Cor33Comp → Cor33Var → ℕ
  | Cor33Comp.q1 => cor33Exp 1 1 0 0 s
  | Cor33Comp.q2 => cor33Exp 1 0 0 1 0
  | Cor33Comp.q3 => cor33Exp 0 1 1 0 0
  | Cor33Comp.q4 => cor33Exp 0 0 1 1 r

/-- A displayed component as an ideal. -/
noncomputable def cor33Component (r s : ℕ) (j : Cor33Comp) :
    Ideal (MvPolynomial Cor33Var K) :=
  purePower (cor33ComponentSupport j) (cor33ComponentExp r s j)

/-- Components after adjoining a cone point: `(t)` and extended old components. -/
def conePureSupport {ι : Type*} (A : ι → Finset σ) : Option ι → Finset (Option σ)
  | none => {none}
  | some j => Finset.image some (A j)

def conePureExp {ι : Type*} (a : ι → σ → ℕ) : Option ι → Option σ → ℕ
  | none => fun _ => 1
  | some j => fun x => match x with | none => 0 | some i => a j i

/-- Component clutter after coning: `{t}` together with the old component supports. -/
def cor33ConeComponentClutter : Set (Finset (Option Cor33Var)) :=
  Set.range (conePureSupport cor33ComponentSupport)

/-- The coned ideal \(K_{r,s}=tI_{r,s}R\). -/
noncomputable def cor33ConeIdeal (r s : ℕ) :
    Ideal (MvPolynomial (Option Cor33Var) K) :=
  coneIdeal (cor33BaseIdeal (K := K) r s)

/-- The cone of the squarefree root from Theorem 3.1. -/
noncomputable def cor33ConeRadicalIdeal : Ideal (MvPolynomial (Option Cor33Var) K) :=
  coneIdeal (cor33RadicalIdeal (K := K))

omit K [Field K] [DecidableEq σ] in
/-- Local geometric realization of a finite support-clutter, as probability vectors whose
positive support is contained in one of the displayed faces. -/
def cor33GeomRealization [Fintype σ] (H : Set (Finset σ)) : Set (σ → ℝ) :=
  {x | (∀ i, 0 ≤ x i) ∧ (∑ i, x i) = 1 ∧
    ∃ F ∈ H, ∀ i, 0 < x i → i ∈ F}

omit K [Field K] [DecidableEq σ] in
/-- Vertices of the local chain complex, indexed by variables occurring in some face. -/
abbrev cor33ChainVertex [Fintype σ] (H : Set (Finset σ)) : Type _ :=
  {i : σ // ∃ F ∈ H, i ∈ F}

omit K [Field K] [DecidableEq σ] in
/-- Edges of the local chain complex, oriented by the chosen strict order. -/
abbrev cor33ChainEdge [Fintype σ] [LT σ] (H : Set (Finset σ)) : Type _ :=
  {e : σ × σ // e.1 < e.2 ∧ ∃ F ∈ H, e.1 ∈ F ∧ e.2 ∈ F}

omit K [Field K] [DecidableEq σ] in
/-- Triangles of the local chain complex. The comparison between the first and third
vertices is stored explicitly so that the cone type only needs `LT (Option σ)`. -/
abbrev cor33ChainTriangle [Fintype σ] [LT σ] (H : Set (Finset σ)) : Type _ :=
  {t : σ × σ × σ // t.1 < t.2.1 ∧ t.2.1 < t.2.2 ∧ t.1 < t.2.2 ∧
    ∃ F ∈ H, t.1 ∈ F ∧ t.2.1 ∈ F ∧ t.2.2 ∈ F}

omit K [Field K] [DecidableEq σ] in
/-- Low endpoint of an oriented edge. -/
def cor33EdgeLow [Fintype σ] [LT σ] (H : Set (Finset σ))
    (e : cor33ChainEdge H) : cor33ChainVertex H :=
  ⟨e.1.1, by
    rcases e.2 with ⟨-, F, hF, hu, _⟩
    exact ⟨F, hF, hu⟩⟩

omit K [Field K] [DecidableEq σ] in
/-- High endpoint of an oriented edge. -/
def cor33EdgeHigh [Fintype σ] [LT σ] (H : Set (Finset σ))
    (e : cor33ChainEdge H) : cor33ChainVertex H :=
  ⟨e.1.2, by
    rcases e.2 with ⟨-, F, hF, _, hv⟩
    exact ⟨F, hF, hv⟩⟩

omit K [Field K] [DecidableEq σ] in
/-- The edge spanned by the first two vertices of an oriented triangle. -/
def cor33Triangle01 [Fintype σ] [LT σ] (H : Set (Finset σ))
    (t : cor33ChainTriangle H) : cor33ChainEdge H :=
  ⟨(t.1.1, t.1.2.1), by
    rcases t.2 with ⟨h01, -, -, F, hF, hu, hv, _⟩
    exact ⟨h01, F, hF, hu, hv⟩⟩

omit K [Field K] [DecidableEq σ] in
/-- The edge spanned by the first and third vertices of an oriented triangle. -/
def cor33Triangle02 [Fintype σ] [LT σ] (H : Set (Finset σ))
    (t : cor33ChainTriangle H) : cor33ChainEdge H :=
  ⟨(t.1.1, t.1.2.2), by
    rcases t.2 with ⟨-, -, h02, F, hF, hu, _, hw⟩
    exact ⟨h02, F, hF, hu, hw⟩⟩

omit K [Field K] [DecidableEq σ] in
/-- The edge spanned by the second and third vertices of an oriented triangle. -/
def cor33Triangle12 [Fintype σ] [LT σ] (H : Set (Finset σ))
    (t : cor33ChainTriangle H) : cor33ChainEdge H :=
  ⟨(t.1.2.1, t.1.2.2), by
    rcases t.2 with ⟨-, h12, -, F, hF, _, hv, hw⟩
    exact ⟨h12, F, hF, hv, hw⟩⟩

omit K [Field K] [DecidableEq σ] in
/-- The simplicial boundary from oriented edges to vertices. -/
noncomputable def cor33BoundaryOne [Fintype σ] [LT σ] (L : Type*) [Field L]
    (H : Set (Finset σ)) :
    (cor33ChainEdge H →₀ L) →ₗ[L] (cor33ChainVertex H →₀ L) := by
  classical
  exact Finsupp.linearCombination L (fun e : cor33ChainEdge H =>
    Finsupp.single (cor33EdgeHigh H e) (1 : L) -
      Finsupp.single (cor33EdgeLow H e) (1 : L))

omit K [Field K] [DecidableEq σ] in
/-- The simplicial boundary from oriented triangles to edges. -/
noncomputable def cor33BoundaryTwo [Fintype σ] [LT σ] (L : Type*) [Field L]
    (H : Set (Finset σ)) :
    (cor33ChainTriangle H →₀ L) →ₗ[L] (cor33ChainEdge H →₀ L) := by
  classical
  exact Finsupp.linearCombination L (fun t : cor33ChainTriangle H =>
    Finsupp.single (cor33Triangle12 H t) (1 : L) -
      Finsupp.single (cor33Triangle02 H t) (1 : L) +
        Finsupp.single (cor33Triangle01 H t) (1 : L))

omit K [Field K] [DecidableEq σ] in
theorem cor33BoundaryOne_single [Fintype σ] [LT σ] {L : Type*} [Field L]
    (H : Set (Finset σ)) (e : cor33ChainEdge H) (c : L) :
    cor33BoundaryOne L H (Finsupp.single e c) =
      c • (Finsupp.single (cor33EdgeHigh H e) (1 : L) -
        Finsupp.single (cor33EdgeLow H e) (1 : L)) := by
  classical
  simp [cor33BoundaryOne, Finsupp.linearCombination_apply]

omit K [Field K] [DecidableEq σ] in
theorem cor33BoundaryTwo_single [Fintype σ] [LT σ] {L : Type*} [Field L]
    (H : Set (Finset σ)) (t : cor33ChainTriangle H) (c : L) :
    cor33BoundaryTwo L H (Finsupp.single t c) =
      c • (Finsupp.single (cor33Triangle12 H t) (1 : L) -
        Finsupp.single (cor33Triangle02 H t) (1 : L) +
          Finsupp.single (cor33Triangle01 H t) (1 : L)) := by
  classical
  simp [cor33BoundaryTwo, Finsupp.linearCombination_apply]

omit K [Field K] [DecidableEq σ] in
/-- The local oriented chain groups form a chain complex through dimension two. -/
theorem cor33BoundaryOne_comp_cor33BoundaryTwo [Fintype σ] [LT σ]
    {L : Type*} [Field L] (H : Set (Finset σ)) :
    (cor33BoundaryOne L H).comp (cor33BoundaryTwo L H) = 0 := by
  apply LinearMap.ext
  intro x
  refine Finsupp.induction_linear x ?hzero ?hadd ?hsingle
  · simp
  · intro f g hf hg
    simp [map_add, hf, hg]
  · intro t c
    rw [LinearMap.comp_apply, cor33BoundaryTwo_single]
    simp only [map_add, map_sub, map_smul, cor33BoundaryOne_single]
    ext v
    simp [cor33EdgeLow, cor33EdgeHigh, cor33Triangle01, cor33Triangle02,
      cor33Triangle12]

omit K [Field K] [DecidableEq σ] in
/-- Boundaries inside the one-cycle space. -/
noncomputable def cor33Boundaries [Fintype σ] [LT σ] (L : Type*) [Field L]
    (H : Set (Finset σ)) :
    Submodule L ↥(LinearMap.ker (cor33BoundaryOne L H)) :=
  LinearMap.range
    (LinearMap.codRestrict (LinearMap.ker (cor33BoundaryOne L H))
      (cor33BoundaryTwo L H)
      (by
        intro x
        change cor33BoundaryOne L H (cor33BoundaryTwo L H x) = 0
        have hcomp := cor33BoundaryOne_comp_cor33BoundaryTwo (L := L) H
        have hx := congrArg (fun f : (cor33ChainTriangle H →₀ L) →ₗ[L]
          (cor33ChainVertex H →₀ L) => f x) hcomp
        simpa [LinearMap.comp_apply] using hx))

omit K [Field K] [DecidableEq σ] in
/-- The local first Betti number of a finite support-clutter over a field. -/
noncomputable def cor33BettiOne [Fintype σ] [LT σ] (L : Type*) [Field L]
    (H : Set (Finset σ)) : ℕ := by
  letI : AddCommGroup ↥(LinearMap.ker (cor33BoundaryOne L H)) :=
    inferInstance
  letI : Module L ↥(LinearMap.ker (cor33BoundaryOne L H)) :=
    inferInstance
  exact Module.finrank L
    (↥(LinearMap.ker (cor33BoundaryOne L H)) ⧸ cor33Boundaries L H)

/-- A rank function used only to orient the five variables in Corollary 3.3. -/
def cor33VarRank : Cor33Var → ℕ
  | Cor33Var.a => 0
  | Cor33Var.b => 1
  | Cor33Var.c => 2
  | Cor33Var.d => 3
  | Cor33Var.z => 4

instance : Max Cor33Var where
  max x y := if cor33VarRank x ≤ cor33VarRank y then y else x

instance : Min Cor33Var where
  min x y := if cor33VarRank x ≤ cor33VarRank y then x else y

instance : LinearOrder Cor33Var :=
  LinearOrder.lift cor33VarRank
    (by
      intro x y hxy
      cases x <;> cases y <;> simp [cor33VarRank] at hxy ⊢)
    (by
      intro x y
      dsimp [Max.max]
      split <;> simp_all [cor33VarRank])
    (by
      intro x y
      dsimp [Min.min]
      split <;> simp_all [cor33VarRank])

omit [DecidableEq σ] in
/-- The principal cone ideal \((t^q)\) appearing in the displayed power formula. -/
noncomputable def cor33ConeTPow (q : ℕ) :
    Ideal (MvPolynomial (Option Cor33Var) K) :=
  Ideal.span ({X none ^ q} : Set (MvPolynomial (Option Cor33Var) K))

omit [DecidableEq σ] in
/-- The extension \(Q_j^qR\) of a displayed base component power. -/
noncomputable def cor33ConedComponentPower (r s q : ℕ) (j : Cor33Comp) :
    Ideal (MvPolynomial (Option Cor33Var) K) :=
  Ideal.map (MvPolynomial.rename (R := K) (Option.some : Cor33Var → Option Cor33Var))
    ((cor33Component (K := K) r s j) ^ q)

omit [DecidableEq σ] in
/-- The extension \(I_{r,s}^qR\) of the displayed base power. -/
noncomputable def cor33ConedBasePower (r s q : ℕ) :
    Ideal (MvPolynomial (Option Cor33Var) K) :=
  Ideal.map (MvPolynomial.rename (R := K) (Option.some : Cor33Var → Option Cor33Var))
    ((cor33BaseIdeal (K := K) r s) ^ q)

omit K [Field K] [DecidableEq σ] in
/-- Complete packaged statement of Corollary 3.3. -/
structure Cor33Conclusion {K : Type*} [Field K] {r s : ℕ}
    (hr : 0 < r) (hs : 0 < s) : Prop where
  decomposition :
    IsIrredundantDecomp (cor33ConeIdeal (K := K) r s)
      (conePureSupport cor33ComponentSupport)
      (conePureExp (cor33ComponentExp r s))
  componentHeight :
    ∀ j : Option Cor33Comp,
      (purePower (conePureSupport cor33ComponentSupport j)
        (conePureExp (cor33ComponentExp r s) j) :
          Ideal (MvPolynomial (Option Cor33Var) K)).height =
        ((conePureSupport cor33ComponentSupport j).card : ℕ∞)
  componentHeightValues :
    (purePower (conePureSupport cor33ComponentSupport none)
      (conePureExp (cor33ComponentExp r s) none) :
        Ideal (MvPolynomial (Option Cor33Var) K)).height = (1 : ℕ∞) ∧
    (purePower (conePureSupport cor33ComponentSupport (some Cor33Comp.q1))
      (conePureExp (cor33ComponentExp r s) (some Cor33Comp.q1)) :
        Ideal (MvPolynomial (Option Cor33Var) K)).height = (3 : ℕ∞) ∧
    (purePower (conePureSupport cor33ComponentSupport (some Cor33Comp.q2))
      (conePureExp (cor33ComponentExp r s) (some Cor33Comp.q2)) :
        Ideal (MvPolynomial (Option Cor33Var) K)).height = (2 : ℕ∞) ∧
    (purePower (conePureSupport cor33ComponentSupport (some Cor33Comp.q3))
      (conePureExp (cor33ComponentExp r s) (some Cor33Comp.q3)) :
        Ideal (MvPolynomial (Option Cor33Var) K)).height = (2 : ℕ∞) ∧
    (purePower (conePureSupport cor33ComponentSupport (some Cor33Comp.q4))
      (conePureExp (cor33ComponentExp r s) (some Cor33Comp.q4)) :
        Ideal (MvPolynomial (Option Cor33Var) K)).height = (3 : ℕ∞)
  primeInjective :
    Function.Injective (fun j : Option Cor33Comp =>
      (primeOf (conePureSupport cor33ComponentSupport j) :
        Ideal (MvPolynomial (Option Cor33Var) K)))
  primeRangeCard :
    (Set.range (fun j : Option Cor33Comp =>
      (primeOf (conePureSupport cor33ComponentSupport j) :
        Ideal (MvPolynomial (Option Cor33Var) K)))).ncard = 5
  associatedEqMinimal :
    associatedPrimes (MvPolynomial (Option Cor33Var) K)
        (MvPolynomial (Option Cor33Var) K ⧸ cor33ConeIdeal (K := K) r s) =
      (cor33ConeIdeal (K := K) r s).minimalPrimes
  minimalEqRange :
    (cor33ConeIdeal (K := K) r s).minimalPrimes =
      Set.range (fun j : Option Cor33Comp =>
        (primeOf (conePureSupport cor33ComponentSupport j) :
          Ideal (MvPolynomial (Option Cor33Var) K)))
  associatedEqRange :
    associatedPrimes (MvPolynomial (Option Cor33Var) K)
        (MvPolynomial (Option Cor33Var) K ⧸ cor33ConeIdeal (K := K) r s) =
      Set.range (fun j : Option Cor33Comp =>
        (primeOf (conePureSupport cor33ComponentSupport j) :
          Ideal (MvPolynomial (Option Cor33Var) K)))
  associatedPowerEqRange :
    ∀ {q : ℕ}, 0 < q →
      associatedPrimes (MvPolynomial (Option Cor33Var) K)
          (MvPolynomial (Option Cor33Var) K ⧸
            (cor33ConeIdeal (K := K) r s) ^ q) =
        Set.range (fun j : Option Cor33Comp =>
          (primeOf (conePureSupport cor33ComponentSupport j) :
            Ideal (MvPolynomial (Option Cor33Var) K)))
  normallyTorsionFree :
    prop21NormallyTorsionFree (cor33ConeIdeal (K := K) r s)
  symbolicPowerFormula :
    ∀ {q : ℕ}, 0 < q →
      (symbolicPower (cor33ConeIdeal (K := K) r s) q =
        cor33ConeTPow (K := K) q ⊓
          ⨅ j : Cor33Comp, cor33ConedComponentPower (K := K) r s q j) ∧
      (cor33ConeTPow (K := K) q ⊓
          ⨅ j : Cor33Comp, cor33ConedComponentPower (K := K) r s q j =
        cor33ConeTPow (K := K) q * cor33ConedBasePower (K := K) r s q) ∧
      (cor33ConeTPow (K := K) q * cor33ConedBasePower (K := K) r s q =
        (cor33ConeIdeal (K := K) r s) ^ q) ∧
      symbolicPower (cor33ConeIdeal (K := K) r s) q =
        (cor33ConeIdeal (K := K) r s) ^ q
  radical :
    (cor33ConeIdeal (K := K) r s).radical = cor33ConeRadicalIdeal (K := K)
  supportPreserving :
    SupportPreserving (cor33ConeIdeal (K := K) r s)
  supportComplexEqCone :
    supportComplex (cor33ConeIdeal (K := K) r s) = coneClutter cor33BaseClutter
  contractible :
    ContractibleSpace ↥(cor33GeomRealization
      (supportComplex (cor33ConeIdeal (K := K) r s)))
  bettiOne :
    ∀ {F : Type*} [Field F],
      cor33BettiOne F (supportComplex (cor33ConeIdeal (K := K) r s)) = 0
  squarefreeRootCriterion :
    HasSqRoot (cor33ConeIdeal (K := K) r s) ↔ r = s
  equalRoot :
    r = s →
      IsSquarefreeMonomialIdeal (cor33ConeRadicalIdeal (K := K)) ∧
      (∀ i, 0 < cor33ConeWeight r i) ∧
      diagonal (cor33ConeWeight r) (cor33ConeRadicalIdeal (K := K)) =
        cor33ConeIdeal (K := K) r s
  equalRootSimis :
    r = s → MPVConc (cor33ConeIdeal (K := K) r s)
  equalRootUnique :
    r = s →
      ∀ {J : Ideal (MvPolynomial (Option Cor33Var) K)} {d : Option Cor33Var → ℕ},
        IsSquarefreeMonomialIdeal J →
        (∀ i, 0 < d i) →
        diagonal d J = cor33ConeIdeal (K := K) r s →
        J = cor33ConeRadicalIdeal (K := K) ∧ d = cor33ConeWeight r
  counterexample :
    ∀ {F : Type*} [Field F], r ≠ s →
      MPVHypotheses (cor33ConeIdeal (K := K) r s)
        (conePureSupport cor33ComponentSupport)
        (conePureExp (cor33ComponentExp r s)) ∧
      SupportPreserving (cor33ConeIdeal (K := K) r s) ∧
      supportComplex (cor33ConeIdeal (K := K) r s) = coneClutter cor33BaseClutter ∧
      ContractibleSpace ↥(cor33GeomRealization
        (supportComplex (cor33ConeIdeal (K := K) r s))) ∧
      cor33BettiOne F (supportComplex (cor33ConeIdeal (K := K) r s)) = 0 ∧
      cor33BettiOne F (supportComplex (cor33ConeIdeal (K := K) r s)) ≤ 1 ∧
      ¬ MPVConc (cor33ConeIdeal (K := K) r s)

end SimisFormal
end

section
namespace SimisFormal
open MvPolynomial
open scoped BigOperators
/-- Variables \(x_i,y_i,z_i\), with \(i\in\mathbb Z/(2m)\), encoded by a finite product. -/
abbrev prop61_var (m : ℕ) := Fin 3 × Fin (2 * m)

/-- The \(x_i\) variable. -/
def prop61_x {m : ℕ} (i : Fin (2 * m)) : prop61_var m := (0, i)

/-- The \(y_i\) variable, private to the \(i\)-th facet. -/
def prop61_y {m : ℕ} (i : Fin (2 * m)) : prop61_var m := (1, i)

/-- The \(z_i\) variable, private to the \(i\)-th facet. -/
def prop61_z {m : ℕ} (i : Fin (2 * m)) : prop61_var m := (2, i)

/-- The facet \(E_i=\{x_i,x_{i+1},y_i,z_i\}\). -/
noncomputable def prop61_edge {m : ℕ} (i : Fin (2 * m)) : Finset (prop61_var m) :=
  {prop61_x i, prop61_x (finSuccMod i), prop61_y i, prop61_z i}

/-- The facet set of the even-cycle clutter. -/
def prop61_H (m : ℕ) : Set (Finset (prop61_var m)) := Set.range (@prop61_edge m)

section Prop61BlockerHelpers
variable {σ : Type*} [DecidableEq σ]
end Prop61BlockerHelpers
section Prop61ExponentHelpers
variable {σ : Type*} [DecidableEq σ]
end Prop61ExponentHelpers
section Prop61PowGensHelpers
variable {σ : Type*}
end Prop61PowGensHelpers
section Prop61PowGensPrimeHelpers
variable {σ : Type*} [DecidableEq σ]
end Prop61PowGensPrimeHelpers
section Prop61CountPowGensHelpers
variable {σ ι : Type*} [Fintype ι] [DecidableEq ι]
end Prop61CountPowGensHelpers
section Prop61MonomialHelper
variable {σ K : Type*} [Field K] [DecidableEq σ]
end Prop61MonomialHelper
section Prop61Ideals
variable {K : Type*} [Field K]
/-- The squarefree ideal generated by the displayed facets. -/
noncomputable def prop61_J (m : ℕ) : Ideal (MvPolynomial (prop61_var m) K) :=
  monomialIdeal (characteristicExp '' prop61_H m)

/-- The positive diagonal weighting of `prop61_J`. -/
noncomputable def prop61_I (m : ℕ) (d : prop61_var m → ℕ) :
    Ideal (MvPolynomial (prop61_var m) K) :=
  monomialIdeal (diagExp d '' (characteristicExp '' prop61_H m))

/-- Minimal covers, used as the paper's component index. -/
noncomputable def prop61_componentIndex (m : ℕ) :=
  {C : Finset (prop61_var m) // C ∈ blocker (prop61_H m)}

/-- Packaging of the paper’s displayed irredundant blocker decomposition. -/
def prop61_DecompositionInput (m : ℕ) (d : prop61_var m → ℕ) : Prop :=
  HasComponents (prop61_J (K := K) m) (fun C : prop61_componentIndex m => C.1) (fun _ _ => 1) ∧
    IsIrredundant (K := K) (fun C : prop61_componentIndex m => C.1) (fun _ _ => 1) ∧
    SupportsAntichain (fun C : prop61_componentIndex m => C.1) (fun _ _ => 1) ∧
  HasComponents (prop61_I (K := K) m d) (fun C : prop61_componentIndex m => C.1) (fun _ i => d i) ∧
    IsIrredundant (K := K) (fun C : prop61_componentIndex m => C.1) (fun _ i => d i) ∧
    SupportsAntichain (fun C : prop61_componentIndex m => C.1) (fun _ i => d i)

end Prop61Ideals
end SimisFormal
end

section
namespace SimisFormal
open MvPolynomial
open scoped BigOperators
variable {σ K ι : Type*} [Field K] [DecidableEq σ] [Fintype σ] [Fintype ι]
/-- The hypotheses of Proposition 6.2: the blocks are pairwise disjoint, nonempty, and cover the
ambient variables. -/
def prop62_BlockFamily (B : ι → Finset σ) : Prop :=
  (∀ h, (B h).Nonempty) ∧
    (∀ j k x, x ∈ B j → x ∈ B k → j = k) ∧
      ∀ x : σ, ∃ h, x ∈ B h

/-- The exponent of the squarefree transversal obtained by choosing `z h` from every block. -/
noncomputable def prop62_transversalExp (z : ι → σ) : σ →₀ ℕ :=
  ∑ h, Finsupp.single (z h) 1

/-- The exponent of the diagonally weighted transversal obtained from a block choice. -/
noncomputable def prop62_weightedTransversalExp (a : σ → ℕ) (z : ι → σ) : σ →₀ ℕ :=
  ∑ h, Finsupp.single (z h) (a (z h))

/-- The supports of all squarefree transversals. -/
def prop62_facets (B : ι → Finset σ) : Set (Finset σ) :=
  {T | ∃ z : ι → σ, (∀ h, z h ∈ B h) ∧ T = Finset.univ.image z}

/-- The squarefree transversal generators of the ideal in Proposition 6.2. -/
def prop62_transversalGens (B : ι → Finset σ) : Set (σ →₀ ℕ) :=
  {e | ∃ z : ι → σ, (∀ h, z h ∈ B h) ∧ e = prop62_transversalExp z}

/-- The weighted transversal generators of the ideal in Proposition 6.2. -/
def prop62_weightedTransversalGens (B : ι → Finset σ) (a : σ → ℕ) : Set (σ →₀ ℕ) :=
  {e | ∃ z : ι → σ, (∀ h, z h ∈ B h) ∧ e = prop62_weightedTransversalExp a z}

/-- The squarefree intersection of block primes. -/
noncomputable def prop62_rootIdeal (B : ι → Finset σ) : Ideal (MvPolynomial σ K) :=
  ⨅ h, primeOf (B h)

/-- The weighted intersection of pure-power block components. -/
noncomputable def prop62_weightedIdeal (B : ι → Finset σ) (a : σ → ℕ) :
    Ideal (MvPolynomial σ K) :=
  ⨅ h, purePower (B h) a

/-- At least two blocks have cardinality at least two. -/
def prop62_twoLargeBlocks (B : ι → Finset σ) : Prop :=
  ∃ j k, j ≠ k ∧ 2 ≤ (B j).card ∧ 2 ≤ (B k).card

/-- At least three blocks have cardinality at least two. -/
def prop62_threeLargeBlocks (B : ι → Finset σ) : Prop :=
  ∃ i j k, i ≠ j ∧ j ≠ k ∧ k ≠ i ∧
    2 ≤ (B i).card ∧ 2 ≤ (B j).card ∧ 2 ≤ (B k).card

omit [Fintype ι] in
/-- The paper's intervenor set: components lying strictly between a chosen pair. -/
def prop62_intervenorSet (B : ι → Finset σ) (k l : ι) : Set ι :=
  {j | j ≠ k ∧ j ≠ l ∧ B j ⊆ B k ∪ B l}

end SimisFormal
end

section
namespace SimisFormal
open MvPolynomial
open scoped BigOperators
variable {K : Type*} [Field K]
/-- The five variables used in Remark 3.2. -/
inductive rem32_var | a | b | c | d | z deriving DecidableEq

open rem32_var
def rem32_ac : Finset rem32_var := {a, c}
def rem32_bd : Finset rem32_var := {b, d}
def rem32_ab : Finset rem32_var := {a, b}
def rem32_cd : Finset rem32_var := {c, d}
def rem32_ad : Finset rem32_var := {a, d}
def rem32_bc : Finset rem32_var := {b, c}
def rem32_abz : Finset rem32_var := {a, b, z}
def rem32_cdz : Finset rem32_var := {c, d, z}

/-- The generator clutter \(H=\{\{a,c\},\{b,d\},\{a,b,z\},\{c,d,z\}\}\). -/
def rem32_generatorClutter : Set (Finset rem32_var) :=
  {rem32_ac, rem32_bd, rem32_abz, rem32_cdz}

/-- The component clutter \(A=\{\{a,b,z\},\{a,d\},\{b,c\},\{c,d,z\}\}\). -/
def rem32_componentClutter : Set (Finset rem32_var) :=
  {rem32_abz, rem32_ad, rem32_bc, rem32_cdz}

/-- The erroneous candidate obtained by omitting `z` from the last two root facets. -/
def rem32_omittedClutter : Set (Finset rem32_var) :=
  {rem32_ac, rem32_bd, rem32_ab, rem32_cd}

/-- Witness vertices \(a,c,z\) for the generator-clutter triangle. -/
def rem32_generatorCycleVertices : Fin 3 → rem32_var := ![a, c, z]

/-- Witness vertices \(a,d,z\) for the component-clutter triangle. -/
def rem32_componentCycleVertices : Fin 3 → rem32_var := ![a, d, z]

noncomputable def rem32_abzExp (r : ℕ) : rem32_var →₀ ℕ :=
  Finsupp.single a 1 + Finsupp.single b 1 + Finsupp.single z r

noncomputable def rem32_cdzExp (s : ℕ) : rem32_var →₀ ℕ :=
  Finsupp.single c 1 + Finsupp.single d 1 + Finsupp.single z s

/-- Explicit monomial generators of \(I_{r,s}=(ac,bd,abz^r,cdz^s)\). -/
noncomputable def rem32_familyExps (r s : ℕ) : Set (rem32_var →₀ ℕ) :=
  {characteristicExp rem32_ac, characteristicExp rem32_bd, rem32_abzExp r, rem32_cdzExp s}

noncomputable def rem32_familyIdeal (r s : ℕ) : Ideal (MvPolynomial rem32_var K) :=
  monomialIdeal (rem32_familyExps r s)

/-- The squarefree candidate \((ac,bd,ab,cd)\) from the first sentence of Remark 3.2. -/
noncomputable def rem32_omittedRootIdeal : Ideal (MvPolynomial rem32_var K) :=
  monomialIdeal (characteristicExp '' rem32_omittedClutter)

/-- The diagonal weight \(\delta(1,1,1,1,t)\) from the first sentence of Remark 3.2. -/
def rem32_omittedWeight (t : ℕ) : rem32_var → ℕ
  | a => 1
  | b => 1
  | c => 1
  | d => 1
  | z => t

end SimisFormal
end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
open MvPolynomial
open SimisFormal
open scoped BigOperators
abbrev thm31_var := Fin 5

abbrev thm31_a : thm31_var := ⟨0, by decide⟩
abbrev thm31_b : thm31_var := ⟨1, by decide⟩
abbrev thm31_c : thm31_var := ⟨2, by decide⟩
abbrev thm31_d : thm31_var := ⟨3, by decide⟩
abbrev thm31_z : thm31_var := ⟨4, by decide⟩

variable {K : Type*} [Field K]
/-- The degree-one monomial \(ac\). -/
noncomputable def thm31_gAC : thm31_var →₀ ℕ :=
  Finsupp.single thm31_a 1 + Finsupp.single thm31_c 1

/-- The degree-one monomial \(bd\). -/
noncomputable def thm31_gBD : thm31_var →₀ ℕ :=
  Finsupp.single thm31_b 1 + Finsupp.single thm31_d 1

/-- The generator \(abz^r\). -/
noncomputable def thm31_gABZ (r : ℕ) : thm31_var →₀ ℕ :=
  Finsupp.single thm31_a 1 + Finsupp.single thm31_b 1 + Finsupp.single thm31_z r

/-- The generator \(cdz^s\). -/
noncomputable def thm31_gCDZ (s : ℕ) : thm31_var →₀ ℕ :=
  Finsupp.single thm31_c 1 + Finsupp.single thm31_d 1 + Finsupp.single thm31_z s

/-- Minimal exponent generators of \(I_{r,s}\). -/
def thm31_gens (r s : ℕ) : Set (thm31_var →₀ ℕ) :=
  {thm31_gAC, thm31_gBD, thm31_gABZ r, thm31_gCDZ s}

/-- The ideal of Theorem 3.1. -/
noncomputable def thm31_I (r s : ℕ) : Ideal (MvPolynomial thm31_var K) :=
  monomialIdeal (K := K) (thm31_gens r s)

/-- Supports of the four irreducible components, indexed in the order of (5). -/
def thm31_support : Fin 4 → Finset thm31_var := fun j ↦
  match j.val with
  | 0 => {thm31_a, thm31_b, thm31_z}
  | 1 => {thm31_a, thm31_d}
  | 2 => {thm31_b, thm31_c}
  | _ => {thm31_c, thm31_d, thm31_z}

/-- Exponents of the four irreducible components in (5). -/
def thm31_componentExp (r s : ℕ) : Fin 4 → thm31_var → ℕ := fun j ↦
  match j.val with
  | 0 => fun i ↦ match i.val with
    | 0 => 1 | 1 => 1 | 2 => 0 | 3 => 0 | _ => s
  | 1 => fun i ↦ match i.val with
    | 0 => 1 | 1 => 0 | 2 => 0 | 3 => 1 | _ => 0
  | 2 => fun i ↦ match i.val with
    | 0 => 0 | 1 => 1 | 2 => 1 | 3 => 0 | _ => 0
  | _ => fun i ↦ match i.val with
    | 0 => 0 | 1 => 0 | 2 => 1 | 3 => 1 | _ => r

/-- The component family \(Q_1,\dots,Q_4\) of (5). -/
noncomputable def thm31_component (r s : ℕ) (j : Fin 4) :
    Ideal (MvPolynomial thm31_var K) :=
  purePower (K := K) (thm31_support j) (thm31_componentExp r s j)

/-- The common radical \(M=(ac,bd,abz,cdz)\). -/
noncomputable def thm31_M : Ideal (MvPolynomial thm31_var K) := thm31_I (K := K) 1 1

/-- Weight vector \((1,1,1,1,t)\) in the order \((a,b,c,d,z)\). -/
def thm31_weight (t : ℕ) : thm31_var → ℕ := fun i ↦
  match i.val with
  | 0 => 1
  | 1 => 1
  | 2 => 1
  | 3 => 1
  | _ => t

end

section
namespace SimisFormal
open MvPolynomial
open scoped BigOperators
variable {σ K : Type*} [Field K] [DecidableEq σ]
/-- Lemma 4.2(i), kept explicit because it is formalized in a parallel file. -/
def thm41_lem42OneGenerator (I : Ideal (MvPolynomial σ K)) : Prop :=
  ∀ F ∈ supportComplex I, ∃! e : σ →₀ ℕ, e ∈ minGens I ∧ e.support = F

variable {ι : Type*}
/-- Coherence of all positive occurrence exponents at each variable. -/
def thm41_generatorCoherence (I : Ideal (MvPolynomial σ K)) : Prop :=
  ∀ ⦃i : σ⦄ ⦃u v : σ →₀ ℕ⦄, u ∈ minGens I → v ∈ minGens I →
    i ∈ u.support → i ∈ v.support → u i = v i

/-- The squarefree ideal generated by the characteristic monomials of the support complex. -/
noncomputable def thm41_squarefreeRoot (I : Ideal (MvPolynomial σ K)) :
    Ideal (MvPolynomial σ K) :=
  monomialIdeal (characteristicExp '' supportComplex I)

end SimisFormal
end

section
open MvPolynomial
open SimisFormal
open scoped BigOperators
variable {σ ι : Type*} [DecidableEq σ]
/-- A component strictly between `k` and `l`, with support inside their union. -/
def thm52_isIntervenor (A : ι → Finset σ) (k l j : ι) : Prop :=
  j ≠ k ∧ j ≠ l ∧ A j ⊆ A k ∪ A l

/-- The incidence bound for one pair, expressed as uniqueness rather than cardinality. -/
def thm52_AtMostOneIntervenor (A : ι → Finset σ) (k l : ι) : Prop :=
  ∀ {j₁ j₂}, thm52_isIntervenor A k l j₁ → thm52_isIntervenor A k l j₂ → j₁ = j₂

/-- Condition (11), in its symmetric pairwise-uniqueness form. -/
def thm52_IncidenceBound (A : ι → Finset σ) : Prop :=
  ∀ {k l}, k ≠ l → (A k ∩ A l).Nonempty → thm52_AtMostOneIntervenor A k l

variable {K : Type*} [Field K] [Fintype σ] [Fintype ι]
/-- The squarefree root is generated by the inclusion-minimal data encoded by
transversals of the component-support clutter. -/
noncomputable def thm52_root (A : ι → Finset σ) : Ideal (MvPolynomial σ K) :=
  monomialIdeal (K := K)
    (characteristicExp '' {T : Finset σ | IsTransversal (Set.range A) T})

/-- The incidence bound for one pair, with two allowed intervening components. -/
def thm52_AtMostTwoIntervenor (A : ι → Finset σ) (k l : ι) : Prop :=
  ∀ {j₁ j₂ j₃}, thm52_isIntervenor A k l j₁ → thm52_isIntervenor A k l j₂ →
    thm52_isIntervenor A k l j₃ → j₁ = j₂ ∨ j₁ = j₃ ∨ j₂ = j₃

/-- Condition obtained from (11) by replacing the bound one with the bound two. -/
def thm52_TwoIntervenorBound (A : ι → Finset σ) : Prop :=
  ∀ {k l}, k ≠ l → (A k ∩ A l).Nonempty → thm52_AtMostTwoIntervenor A k l

end

section
namespace SimisFormal
open MvPolynomial
open scoped BigOperators
noncomputable section
variable {σ K ι : Type*} [Field K] [DecidableEq σ]
/-- Variables occurring in at least one member of a finite support family. -/
noncomputable def comparison51_usedVariables [Fintype ι] (A : ι → Finset σ) : Finset σ :=
  Finset.univ.biUnion A

/-- A support family restricted to a finite set of ambient variables. -/
noncomputable def comparison51_restrictFinset (U : Finset σ) (A : ι → Finset σ) (j : ι) :
    Finset {x : σ // x ∈ U} :=
  Finset.univ.filter (fun x ↦ x.1 ∈ A j)

/-- Component weights restricted to the selected variables. -/
def comparison51_restrictWeight (U : Finset σ) (a : ι → σ → ℕ) (j : ι) :
    {x : σ // x ∈ U} → ℕ :=
  fun x ↦ a j x.1

/-- The intersection obtained by restricting a displayed pure-power decomposition. -/
noncomputable def comparison51_restrictIdeal
    [Fintype ι] (U : Finset σ) (A : ι → Finset σ) (a : ι → σ → ℕ) :
    Ideal (MvPolynomial {x : σ // x ∈ U} K) :=
  ⨅ j, (purePower (K := K) (comparison51_restrictFinset U A j)
    (comparison51_restrictWeight U a j) : Ideal (MvPolynomial {x : σ // x ∈ U} K))

end
end SimisFormal
end

section
namespace SimisFormal
open MvPolynomial
variable {σ K ι : Type*} [Field K] [DecidableEq σ]
/-- Intervening components \(N(k,\ell)\) from manuscript §5.1. -/
noncomputable def comparison51_N [Fintype ι] [DecidableEq ι] (A : ι → Finset σ) (j k : ι) :
    Finset ι :=
  Finset.univ.filter fun l ↦ l ≠ j ∧ l ≠ k ∧ A l ⊆ A j ∪ A k

/-- Condition (13): every ordered mismatch pair has no intervening component. -/
def comparison51_Condition13 [Fintype ι] [LinearOrder ι] [DecidableEq ι] (A : ι → Finset σ)
    (a : ι → σ → ℕ) : Prop :=
  ∀ p ∈ prop21_XI A a, comparison51_N A p.1 p.2 = ∅

/-- The two equal supports in the sharpness example \((x,y)^2=(x^2,y)\cap(x,y^2)\). -/
abbrev comparison51_A : Fin 2 → Finset (Fin 2) := fun _ ↦ Finset.univ

/-- The unequal occurrence-exponent vectors \((2,1)\) and \((1,2)\). -/
abbrev comparison51_a : Fin 2 → Fin 2 → ℕ := ![![2, 1], ![1, 2]]

/-- The displayed irredundant intersection with equal component radicals. -/
noncomputable def comparison51_I : Ideal (MvPolynomial (Fin 2) K) :=
  (purePower (comparison51_A 0) (comparison51_a 0) : Ideal (MvPolynomial (Fin 2) K)) ⊓
    purePower (comparison51_A 1) (comparison51_a 1)

end SimisFormal
end

section
namespace SimisFormal
open MvPolynomial
open scoped BigOperators
variable {σ K ι : Type*} [Field K] [DecidableEq σ]
/-- The components other than `k` and `ℓ` whose support lies in `A k ∪ A ℓ`. -/
noncomputable def cor53_intervenorSet [Fintype ι] (A : ι → Finset σ) (k ℓ : ι) : Finset ι := by
  classical
  exact Finset.univ.filter (fun j ↦ j ≠ k ∧ j ≠ ℓ ∧ A j ⊆ A k ∪ A ℓ)

/-- Incidence hypothesis (11): at most one intervenor for each pair of distinct intersecting
component supports. -/
def cor53_AtMostOneIntervenor [Fintype ι] (A : ι → Finset σ) : Prop :=
  ∀ k ℓ, k ≠ ℓ → (A k ∩ A ℓ).Nonempty → (cor53_intervenorSet A k ℓ).card ≤ 1

/-- The structural hypotheses of Theorem 5.2, expressed through the displayed irredundant
pure-power decomposition.  `SupportsAntichain` packages distinct radicals and the absence of
embedded primes in the situation considered in the paper. -/
def cor53_StructuralHypotheses (I : Ideal (MvPolynomial σ K))
    (A : ι → Finset σ) (a : ι → σ → ℕ) : Prop :=
  I ≠ ⊥ ∧ I ≠ ⊤ ∧ (∀ j, (A j).Nonempty) ∧
    (∀ j i, i ∈ A j → 0 < a j i) ∧
      IsIrredundantDecomp I A a ∧ SupportsAntichain A a

end SimisFormal
end

section
open MvPolynomial
open SimisFormal
open scoped BigOperators
/-- The ambient variables, encoded so that the four blocks are syntactically disjoint. -/
abbrev ex63_var := Sum (Sum (Fin 3) (Fin 2)) (Sum (Fin 2) (Fin 2))

/-- Inclusion of the first block. -/
def ex63_in1 (i : Fin 3) : ex63_var := Sum.inl (Sum.inl i)

/-- Inclusion of the second block. -/
def ex63_in2 (i : Fin 2) : ex63_var := Sum.inl (Sum.inr i)

/-- Inclusion of the third block. -/
def ex63_in3 (i : Fin 2) : ex63_var := Sum.inr (Sum.inl i)

/-- Inclusion of the fourth block. -/
def ex63_in4 (i : Fin 2) : ex63_var := Sum.inr (Sum.inr i)

abbrev ex63_u1 : ex63_var := ex63_in1 (0 : Fin 3)
abbrev ex63_u2 : ex63_var := ex63_in2 (0 : Fin 2)
abbrev ex63_u3 : ex63_var := ex63_in3 (0 : Fin 2)
/-- The four blocks of Example 6.3. -/
def ex63_B1 : Finset ex63_var := Finset.univ.image ex63_in1
def ex63_B2 : Finset ex63_var := Finset.univ.image ex63_in2
def ex63_B3 : Finset ex63_var := Finset.univ.image ex63_in3
def ex63_B4 : Finset ex63_var := Finset.univ.image ex63_in4

/-- Block family indexed by `Fin 4`. -/
def ex63_block (j : Fin 4) : Finset ex63_var :=
  match j.val with
  | 0 => ex63_B1
  | 1 => ex63_B2
  | 2 => ex63_B3
  | _ => ex63_B4

/-- A tuple of one selected variable from each block. -/
abbrev ex63_choice := Fin 3 × Fin 2 × Fin 2 × Fin 2

/-- The exponent vector of a transversal product, with uniform weight `w`. -/
noncomputable def ex63_transExpWeight (w : ℕ) (c : ex63_choice) : ex63_var →₀ ℕ :=
  (((Finsupp.single (ex63_in1 c.1) w + Finsupp.single (ex63_in2 c.2.1) w) +
      Finsupp.single (ex63_in3 c.2.2.1) w) +
    Finsupp.single (ex63_in4 c.2.2.2) w)

/-- Finite set of all transversal exponent vectors of uniform weight `w`. -/
noncomputable def ex63_transversalGens (w : ℕ) : Finset (ex63_var →₀ ℕ) :=
  Finset.univ.image (ex63_transExpWeight w)

/-- Support of a transversal. -/
def ex63_facet (c : ex63_choice) : Finset ex63_var :=
  {ex63_in1 c.1, ex63_in2 c.2.1, ex63_in3 c.2.2.1, ex63_in4 c.2.2.2}

/-- The generator clutter, as a finite set of supports. -/
def ex63_facets : Finset (Finset ex63_var) := Finset.univ.image ex63_facet

/-- The component clutter, as the set of supports of the four components. -/
def ex63_componentFacets : Finset (Finset ex63_var) := Finset.univ.image ex63_block

variable {K : Type*} [Field K]
/-- The displayed product of pure powers with a common positive exponent `w`. -/
noncomputable def ex63_blockProduct (w : ℕ) : Ideal (MvPolynomial ex63_var K) :=
  ((purePower (K := K) ex63_B1 (fun _ => w) * purePower (K := K) ex63_B2 (fun _ => w)) *
      purePower (K := K) ex63_B3 (fun _ => w)) *
    purePower (K := K) ex63_B4 (fun _ => w)

/-- The constant weight vector with value two. -/
def ex63_weight (_ : ex63_var) : ℕ := 2

/-- The squarefree root \(J\) of Example 6.3, in displayed product form. -/
noncomputable def ex63_J : Ideal (MvPolynomial ex63_var K) :=
  ((primeOf (K := K) ex63_B1 * primeOf (K := K) ex63_B2) *
      primeOf (K := K) ex63_B3) *
    primeOf (K := K) ex63_B4

/-- The weighted ideal \(I_a\) of Example 6.3. -/
noncomputable def ex63_I : Ideal (MvPolynomial ex63_var K) :=
  diagonal (K := K) ex63_weight ex63_J

/-- The three choices of edges in the displayed strong triangle. -/
abbrev ex63_triangleChoice0 : ex63_choice := (0, 0, 1, 0)
abbrev ex63_triangleChoice1 : ex63_choice := (1, 0, 0, 0)
abbrev ex63_triangleChoice2 : ex63_choice := (0, 1, 0, 0)

/-- The cycle vertices \(u_1,u_2,u_3\), in this order. -/
def ex63_triangleVertices : Fin 3 → ex63_var := fun i =>
  match i.val with
  | 0 => ex63_u1
  | 1 => ex63_u2
  | _ => ex63_u3

/-- The three facets displayed in Example 6.3. -/
def ex63_triangleEdges : Fin 3 → Finset ex63_var := fun i =>
  match i.val with
  | 0 => ex63_facet ex63_triangleChoice0
  | 1 => ex63_facet ex63_triangleChoice1
  | _ => ex63_facet ex63_triangleChoice2

/-- The paper's ordered mismatch-index set \(X_{I_a}\). -/
def ex63_XI : Set (Fin 4 × Fin 4) :=
  {p | p.1 < p.2 ∧ p ∈ mismatchPairs ex63_block (fun _ _ => 2)}

/-- The intervening-component set \(N(k,\ell)\) from condition (11). -/
def ex63_intervenors (k l : Fin 4) : Finset (Fin 4) :=
  Finset.univ.filter fun j =>
    j ∉ ({k, l} : Finset (Fin 4)) ∧ ex63_block j ⊆ ex63_block k ∪ ex63_block l

/-- Local form of the disjoint-block hypothesis of Proposition 6.2. -/
def ex63_BlockFamily : Prop :=
  (∀ j : Fin 4, (ex63_block j).Nonempty) ∧
    (∀ j k : Fin 4, ∀ x : ex63_var, x ∈ ex63_block j → x ∈ ex63_block k → j = k) ∧
      ∀ x : ex63_var, ∃ j : Fin 4, x ∈ ex63_block j

/-- Local copy of the intervenor predicate used in Theorem 5.2. -/
def ex63_isIntervenor (k l j : Fin 4) : Prop :=
  j ≠ k ∧ j ≠ l ∧ ex63_block j ⊆ ex63_block k ∪ ex63_block l

/-- Local copy of the uniqueness formulation of at-most-one intervenor. -/
def ex63_AtMostOneIntervenor (k l : Fin 4) : Prop :=
  ∀ {j₁ j₂ : Fin 4}, ex63_isIntervenor k l j₁ → ex63_isIntervenor k l j₂ → j₁ = j₂

/-- Local copy of condition (11), avoiding an import of the concurrent `Thm5_2`. -/
def ex63_IncidenceBound : Prop :=
  ∀ {k l : Fin 4}, k ≠ l → (ex63_block k ∩ ex63_block l).Nonempty →
    ex63_AtMostOneIntervenor k l

/-- The combinatorial assertions of Example 6.3, packaged for the final theorem. -/
abbrev ex63_MainCombinatorics : Prop :=
  ex63_BlockFamily ∧
    ex63_componentFacets = {ex63_B1, ex63_B2, ex63_B3, ex63_B4} ∧
    (ex63_B1.card, ex63_B2.card, ex63_B3.card, ex63_B4.card) = (3, 2, 2, 2) ∧
    (minGens (K := K) (ex63_J (K := K))).ncard = 24 ∧
    (minGens (K := K) (ex63_I (K := K))).ncard = 24 ∧
    (∀ F ∈ supportComplex (ex63_J (K := K)), F.card = 4) ∧
    (∀ F ∈ supportComplex (ex63_I (K := K)), F.card = 4) ∧
    ((primeOf (K := K) ex63_B1 : Ideal (MvPolynomial ex63_var K)).height,
      (primeOf (K := K) ex63_B2 : Ideal (MvPolynomial ex63_var K)).height,
      (primeOf (K := K) ex63_B3 : Ideal (MvPolynomial ex63_var K)).height,
      (primeOf (K := K) ex63_B4 : Ideal (MvPolynomial ex63_var K)).height) =
        ((3 : ℕ∞), (2 : ℕ∞), (2 : ℕ∞), (2 : ℕ∞)) ∧
    ((purePower (K := K) ex63_B1 (fun _ ↦ 2) : Ideal (MvPolynomial ex63_var K)).height,
      (purePower (K := K) ex63_B2 (fun _ ↦ 2) : Ideal (MvPolynomial ex63_var K)).height,
      (purePower (K := K) ex63_B3 (fun _ ↦ 2) : Ideal (MvPolynomial ex63_var K)).height,
      (purePower (K := K) ex63_B4 (fun _ ↦ 2) : Ideal (MvPolynomial ex63_var K)).height) =
        ((3 : ℕ∞), (2 : ℕ∞), (2 : ℕ∞), (2 : ℕ∞)) ∧
    HasStrongTriangle (supportComplex (ex63_J (K := K))) ∧
    HasStrongTriangle (supportComplex (ex63_I (K := K))) ∧
    ¬ IsSimplicialForest (supportComplex (ex63_J (K := K))) ∧
    ¬ IsSimplicialForest (supportComplex (ex63_I (K := K))) ∧
    ¬ IsBalanced (supportComplex (ex63_J (K := K))) ∧
    ¬ IsBalanced (supportComplex (ex63_I (K := K))) ∧
    ¬ (¬ HasStrongTriangle (supportComplex (ex63_J (K := K)))) ∧
    ¬ (¬ HasStrongTriangle (supportComplex (ex63_I (K := K)))) ∧
    ¬ (∀ F ∈ supportComplex (ex63_J (K := K)), F.card ≤ 3) ∧
    ¬ (∀ F ∈ supportComplex (ex63_I (K := K)), F.card ≤ 3) ∧
    ¬ (∀ j : Fin 4,
      (primeOf (K := K) (ex63_block j) : Ideal (MvPolynomial ex63_var K)).height ≤
        (2 : ℕ∞)) ∧
    ¬ (∀ j : Fin 4,
      (purePower (K := K) (ex63_block j) (fun _ ↦ 2) :
        Ideal (MvPolynomial ex63_var K)).height ≤ (2 : ℕ∞)) ∧
    ¬ (∀ j : Fin 4, (ex63_block j).card ≤ 2) ∧
    ex63_XI = ∅ ∧
    mismatchPairs ex63_block (fun _ _ ↦ 2) = ∅ ∧
    (∀ k l : Fin 4, ex63_intervenors k l = ∅) ∧
    ¬ ex63_XI.Nonempty

/-- The algebraic assertions, including the component criterion for \(I_a\). -/
abbrev ex63_MainAlgebra : Prop :=
  ex63_J (K := K) =
      monomialIdeal (K := K) (Set.range (ex63_transExpWeight 1)) ∧
    ex63_I (K := K) = ex63_blockProduct (K := K) 2 ∧
    IsSquarefreeMonomialIdeal (ex63_J (K := K)) ∧
    ¬ IsSquarefreeMonomialIdeal (ex63_I (K := K)) ∧
    IsIrredundantDecomp (K := K) (ex63_J (K := K))
      ex63_block (fun _ _ ↦ (1 : ℕ)) ∧
    IsIrredundantDecomp (K := K) (ex63_I (K := K))
      ex63_block (fun _ _ ↦ (2 : ℕ)) ∧
    SupportsAntichain ex63_block (fun _ _ ↦ (1 : ℕ)) ∧
    SupportsAntichain ex63_block (fun _ _ ↦ (2 : ℕ)) ∧
    IsSimis (ex63_J (K := K)) ∧
    IsSimis (ex63_I (K := K)) ∧
    MPVConc (ex63_I (K := K)) ∧
    ex63_I (K := K) ≠ ⊥ ∧
    ex63_I (K := K) ≠ ⊤ ∧
    IsIrredundantDecomp (K := K) (ex63_I (K := K))
      ex63_block (fun _ _ ↦ (2 : ℕ)) ∧
    SupportsAntichain ex63_block (fun _ _ ↦ (2 : ℕ)) ∧
    ex63_IncidenceBound ∧
    symbolicPower (ex63_I (K := K)) 2 = ex63_I (K := K) ^ 2

end
