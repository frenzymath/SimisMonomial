namespace SimisFormal
open MvPolynomial
open scoped BigOperators
variable {σ K : Type*} [Field K] [DecidableEq σ]
/-- Lemma 4.2(ii), kept explicit because it is formalized in a parallel file. -/
def thm41_lem42Isolated (I : Ideal (MvPolynomial σ K)) : Prop :=
  ∀ F G : Finset σ, F ∈ supportComplex I → G ∈ supportComplex I → F ≠ G →
    ({E : Finset σ | E ∈ supportComplex I ∧ E ⊆ F ∪ G} = {F, G}) →
      ∀ u v : σ →₀ ℕ, u ∈ minGens I → v ∈ minGens I →
        u.support = F → v.support = G →
          ∀ i, i ∈ F → i ∈ G → u i = v i

/-- Lemma 4.3, stated as a reusable contract. It is proved below from `IsClutter`
and the absence of a strong triangle. -/
def thm41_lem43Isolation (H : Set (Finset σ)) : Prop :=
  ∀ z : σ, ∀ ell : {F : Finset σ // F ∈ H ∧ z ∈ F} → ℕ,
    (∃ A B, ell A ≠ ell B) →
      ∃ A B, ell A ≠ ell B ∧
        ({E : Finset σ | E ∈ H ∧ E ⊆ A.1 ∪ B.1} = {A.1, B.1})

/-- Equation (4), reflection in the direction used by Theorem 4.1. -/
def thm41_eq4 : Prop :=
  ∀ (J : Ideal (MvPolynomial σ K)) (d : σ → ℕ), (∀ i, 0 < d i) →
    (IsSimis J ↔ IsSimis (diagonal d J))

/-- A minimal generator of a radical monomial ideal has squarefree exponents. -/
theorem thm41_radical_minGen_eq_characteristic {I : Ideal (MvPolynomial σ K)}
    {e : σ →₀ ℕ} (he : e ∈ minGens I.radical) :
    e = characteristicExp e.support := by
  classical
  let c : σ →₀ ℕ := characteristicExp e.support
  let N : ℕ := e.sum fun _ n => n
  have hle : e ≤ N • c := by
    rw [Finsupp.le_def]
    intro j
    by_cases hj : j ∈ e.support
    · have hbound : e j ≤ e.sum (fun _ n => n) :=
        Finsupp.single_eval_le_sum e (g := fun n => n) (by rfl)
          (by intro n; exact Nat.zero_le n) j
      simpa [N, c, Finsupp.nsmul_apply, characteristicExp_apply, hj] using hbound
    · have hj0 : e j = 0 := by simpa [Finsupp.mem_support_iff] using hj
      simp [N, c, Finsupp.nsmul_apply, characteristicExp_apply, hj, hj0]
  have hce : c ≤ e := by
    rw [Finsupp.le_def]
    intro j
    by_cases hj : j ∈ e.support
    · have hjpos : 0 < e j := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hj)
      simp [c, characteristicExp_apply, hj, Nat.succ_le_iff]
      exact hjpos
    · simp [c, characteristicExp_apply, hj]
  let r : σ →₀ ℕ := N • c - e
  have hr : e + r = N • c := by
    ext j
    simpa [r] using Nat.add_sub_of_le (hle j)
  have heR : (monomial e (1 : K) : MvPolynomial σ K) ∈ I.radical :=
    (mem_minGens.mp he).1
  have hmul : (monomial e (1 : K) : MvPolynomial σ K) * monomial r (1 : K) ∈ I.radical :=
    Ideal.mul_mem_right (monomial r (1 : K)) I.radical heR
  have hpow : (monomial c (1 : K) : MvPolynomial σ K) ^ N ∈ I.radical := by
    rw [MvPolynomial.monomial_pow]
    simpa [MvPolynomial.monomial_mul, hr] using hmul
  have hcR : (monomial c (1 : K) : MvPolynomial σ K) ∈ I.radical :=
    Ideal.mem_radical_of_pow_mem (m := N) hpow
  exact ((mem_minGens.mp he).2 c hcR hce).symm

/-- Support preservation makes the generator-support complex a clutter. -/
theorem thm41_isClutter_of_supportPreserving {I : Ideal (MvPolynomial σ K)}
    (hsp : SupportPreserving I) : IsClutter (supportComplex I) := by
  intro A hA B hB hAB
  have hsp' : supportComplex I = supportComplex I.radical := hsp
  have hAr : A ∈ supportComplex I.radical := hsp' ▸ hA
  have hBr : B ∈ supportComplex I.radical := hsp' ▸ hB
  rcases hAr with ⟨u, hu, huA⟩
  rcases hBr with ⟨v, hv, hvB⟩
  have hsub : u.support ⊆ v.support := by
    intro i hi
    have hiA : i ∈ A := by simpa [← huA] using hi
    have hiB : i ∈ B := hAB hiA
    simpa [← hvB] using hiB
  have huv : u ≤ v := by
    rw [thm41_radical_minGen_eq_characteristic hu,
      thm41_radical_minGen_eq_characteristic hv]
    rw [Finsupp.le_def]
    intro i
    by_cases hi : i ∈ u.support
    · have hi' : i ∈ v.support := hsub hi
      simp [characteristicExp_apply, hi, hi']
    · simp [characteristicExp_apply, hi]
  have heq : u = v := (mem_minGens.mp hv).2 u (mem_minGens.mp hu).1 huv
  calc
    A = u.support := huA.symm
    _ = v.support := congrArg Finsupp.support heq
    _ = B := hvB

/-- Any monomial ideal is generated by its minimal monomial generators. -/
theorem thm41_eq_minGens_of_isMonomialIdeal {I : Ideal (MvPolynomial σ K)}
    (hI : IsMonomialIdeal I) : I = monomialIdeal (minGens I) := by
  rcases hI with ⟨S, hS⟩
  rw [hS]
  apply monomialIdeal_eq_iff.mpr
  intro e
  constructor
  · rintro ⟨s, hsS, hse⟩
    rcases exists_minGens_le
        (I := (monomialIdeal S : Ideal (MvPolynomial σ K)))
        (monomial_mem_monomialIdeal.mpr ⟨s, hsS, le_rfl⟩) with ⟨u, hu, huse⟩
    exact ⟨u, hu, huse.trans hse⟩
  · rintro ⟨u, hu, hue⟩
    have huI : (monomial u (1 : K) : MvPolynomial σ K) ∈
        (monomialIdeal S : Ideal (MvPolynomial σ K)) := (mem_minGens.mp hu).1
    rcases monomial_mem_monomialIdeal.mp huI with ⟨s, hsS, hsu⟩
    exact ⟨s, hsS, hsu.trans hue⟩

variable {ι : Type*}
/-- A finite irreducible decomposition is, in particular, a monomial generating system. -/
theorem thm41_isMonomialIdeal_of_hasComponents [Fintype ι]
    {I : Ideal (MvPolynomial σ K)} {A : ι → Finset σ} {a : ι → σ → ℕ}
    (hcomp : HasComponents I A a) : IsMonomialIdeal I := by
  let S : ι → Set (σ →₀ ℕ) :=
    fun j => {e : σ →₀ ℕ | ∃ i ∈ A j, e = Finsupp.single i (a j i)}
  refine ⟨iInfGens S, hcomp.trans ?_⟩
  simpa [S, purePower] using (monomialIdeal_iInf (K := K) S)

/-- Combinatorial Lemma 4.3: a nonconstant incidence labeling has an isolated unequal pair. -/
theorem thm41_lem43_isolation_of_clutter_noTriangle {H : Set (Finset σ)}
    (hcl : IsClutter H) (hno : ¬ HasStrongTriangle H) : thm41_lem43Isolation H := by
  intro z ell hnonconst
  simpa [lem43_facetsThrough] using
    (lem43_isolation_of_nonconstant (H := H) (z := z) (Λ := ℕ)
      hcl hno ell hnonconst)

/-- The unique minimal generator above a facet of the support complex. -/
noncomputable def thm41_facetGen (I : Ideal (MvPolynomial σ K))
    (hOne : thm41_lem42OneGenerator I) (F : {A : Finset σ // A ∈ supportComplex I}) :
    σ →₀ ℕ :=
  Classical.choose (hOne F.1 F.2)

omit [DecidableEq σ] in
theorem thm41_facetGen_spec (I : Ideal (MvPolynomial σ K))
    (hOne : thm41_lem42OneGenerator I) (F : {A : Finset σ // A ∈ supportComplex I}) :
    thm41_facetGen I hOne F ∈ minGens I ∧ (thm41_facetGen I hOne F).support = F.1 := by
  change Classical.choose (hOne F.1 F.2) ∈ minGens I ∧
    (Classical.choose (hOne F.1 F.2)).support = F.1
  exact (Classical.choose_spec (hOne F.1 F.2)).1

omit [DecidableEq σ] in
theorem thm41_eq_facetGen {I : Ideal (MvPolynomial σ K)}
    {hOne : thm41_lem42OneGenerator I} {F : {A : Finset σ // A ∈ supportComplex I}}
    {u : σ →₀ ℕ} (hu : u ∈ minGens I) (hs : u.support = F.1) :
    u = thm41_facetGen I hOne F := by
  change u = Classical.choose (hOne F.1 F.2)
  exact (Classical.choose_spec (hOne F.1 F.2)).2 u ⟨hu, hs⟩

/-- Lemmas 4.2(ii) and 4.3 force the positive occurrence exponent at a variable to be unique. -/
theorem thm41_generatorCoherence_of_lem42_lem43 {I : Ideal (MvPolynomial σ K)}
    (hOne : thm41_lem42OneGenerator I) (hIso : thm41_lem42Isolated I)
    (h43 : thm41_lem43Isolation (supportComplex I)) : thm41_generatorCoherence I := by
  classical
  intro i u v hu hv hiu hiv
  by_contra hne
  have hU : u.support ∈ supportComplex I := ⟨u, hu, rfl⟩
  have hV : v.support ∈ supportComplex I := ⟨v, hv, rfl⟩
  let U : {F : Finset σ // F ∈ supportComplex I ∧ i ∈ F} := ⟨u.support, hU, hiu⟩
  let V : {F : Finset σ // F ∈ supportComplex I ∧ i ∈ F} := ⟨v.support, hV, hiv⟩
  let ell : {F : Finset σ // F ∈ supportComplex I ∧ i ∈ F} → ℕ :=
    fun F => thm41_facetGen I hOne ⟨F.1, F.2.1⟩ i
  have hnon : ∃ A B, ell A ≠ ell B := by
    refine ⟨U, V, ?_⟩
    change thm41_facetGen I hOne ⟨U.1, U.2.1⟩ i ≠
      thm41_facetGen I hOne ⟨V.1, V.2.1⟩ i
    have huChosen : thm41_facetGen I hOne ⟨U.1, U.2.1⟩ = u :=
      (thm41_eq_facetGen (hOne := hOne) hu rfl).symm
    have hvChosen : thm41_facetGen I hOne ⟨V.1, V.2.1⟩ = v :=
      (thm41_eq_facetGen (hOne := hOne) hv rfl).symm
    simpa [huChosen, hvChosen] using hne
  rcases h43 i ell hnon with ⟨A, B, hABlab, hIsoSet⟩
  have hAB : A.1 ≠ B.1 := by
    intro h
    exact hABlab (congrArg ell (Subtype.ext h))
  let AF : {F : Finset σ // F ∈ supportComplex I} := ⟨A.1, A.2.1⟩
  let BF : {F : Finset σ // F ∈ supportComplex I} := ⟨B.1, B.2.1⟩
  have hEq := hIso A.1 B.1 A.2.1 B.2.1 hAB hIsoSet
    (thm41_facetGen I hOne AF) (thm41_facetGen I hOne BF)
    (thm41_facetGen_spec I hOne AF).1 (thm41_facetGen_spec I hOne BF).1
    (thm41_facetGen_spec I hOne AF).2 (thm41_facetGen_spec I hOne BF).2 i A.2.2 B.2.2
  exact hABlab (by simpa [ell, AF, BF] using hEq)

/-- Forced diagonal weights: the common positive exponent, and one on unused variables. -/
noncomputable def thm41_weight (I : Ideal (MvPolynomial σ K))
    (hOne : thm41_lem42OneGenerator I) (i : σ) : ℕ := by
  classical
  exact if h : ∃ F : {A : Finset σ // A ∈ supportComplex I}, i ∈ F.1 then
    thm41_facetGen I hOne (Classical.choose h) i
  else 1

omit [DecidableEq σ] in
theorem thm41_weight_pos {I : Ideal (MvPolynomial σ K)}
    {hOne : thm41_lem42OneGenerator I} : ∀ i, 0 < thm41_weight I hOne i := by
  intro i
  classical
  rw [thm41_weight]
  split_ifs with h
  · let F := Classical.choose h
    have hi : i ∈ (thm41_facetGen I hOne F).support := by
      simpa [F, (thm41_facetGen_spec I hOne F).2] using Classical.choose_spec h
    exact Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hi)
  · exact Nat.zero_lt_one

omit [DecidableEq σ] in
theorem thm41_weight_eq_facetGen {I : Ideal (MvPolynomial σ K)}
    {hOne : thm41_lem42OneGenerator I} (hcoh : thm41_generatorCoherence I)
    (F : {A : Finset σ // A ∈ supportComplex I}) {i : σ} (hi : i ∈ F.1) :
    thm41_weight I hOne i = thm41_facetGen I hOne F i := by
  classical
  rw [thm41_weight]
  split_ifs with h
  · let G := Classical.choose h
    have hiG : i ∈ G.1 := Classical.choose_spec h
    exact hcoh (thm41_facetGen_spec I hOne G).1 (thm41_facetGen_spec I hOne F).1
      (by simpa [G, (thm41_facetGen_spec I hOne G).2] using hiG)
      (by simpa [(thm41_facetGen_spec I hOne F).2] using hi)
  · exact (h ⟨F, hi⟩).elim

theorem thm41_diagExp_characteristic_eq_facetGen {I : Ideal (MvPolynomial σ K)}
    {hOne : thm41_lem42OneGenerator I} (hcoh : thm41_generatorCoherence I)
    (F : {A : Finset σ // A ∈ supportComplex I}) :
    diagExp (thm41_weight I hOne) (characteristicExp F.1) = thm41_facetGen I hOne F := by
  classical
  ext i
  by_cases hi : i ∈ F.1
  · simpa [diagExp_apply, characteristicExp_apply, hi] using
      (thm41_weight_eq_facetGen hcoh F hi)
  · have hni : i ∉ (thm41_facetGen I hOne F).support := by
      simpa [(thm41_facetGen_spec I hOne F).2] using hi
    have hi0 : thm41_facetGen I hOne F i = 0 := by
      simpa [Finsupp.mem_support_iff] using hni
    simp [diagExp_apply, characteristicExp_apply, hi, hi0]

/-- Once positive occurrence exponents are coherent, the forced weighting of the
squarefree support root recovers the original ideal. -/
theorem thm41_diagonal_squarefreeRoot_eq [Fintype σ]
    {I : Ideal (MvPolynomial σ K)} {hOne : thm41_lem42OneGenerator I}
    (hMono : IsMonomialIdeal I) (hcoh : thm41_generatorCoherence I) :
    diagonal (thm41_weight I hOne) (thm41_squarefreeRoot I) = I := by
  classical
  let d : σ → ℕ := thm41_weight I hOne
  have hminEq := thm41_eq_minGens_of_isMonomialIdeal hMono
  change diagonal d (monomialIdeal (characteristicExp '' supportComplex I)) = I
  rw [diagonal_monomialIdeal]
  refine Eq.trans ?_ hminEq.symm
  apply monomialIdeal_eq_iff.mpr
  intro e
  constructor
  · rintro ⟨z, hzImg, hzle⟩
    rcases hzImg with ⟨c, hc, rfl⟩
    rcases hc with ⟨F, hFH, rfl⟩
    let FS : {E : Finset σ // E ∈ supportComplex I} := ⟨F, hFH⟩
    have heq : diagExp d (characteristicExp F) = thm41_facetGen I hOne FS := by
      simpa [d, FS] using thm41_diagExp_characteristic_eq_facetGen hcoh FS
    exact ⟨thm41_facetGen I hOne FS, (thm41_facetGen_spec I hOne FS).1, heq ▸ hzle⟩
  · rintro ⟨u, hu, hue⟩
    let F : {E : Finset σ // E ∈ supportComplex I} := ⟨u.support, ⟨u, hu, rfl⟩⟩
    have hueq : u = thm41_facetGen I hOne F :=
      thm41_eq_facetGen (hOne := hOne) hu rfl
    have heq : diagExp d (characteristicExp u.support) = thm41_facetGen I hOne F := by
      simpa [d, F] using thm41_diagExp_characteristic_eq_facetGen hcoh F
    refine ⟨diagExp d (characteristicExp u.support), ?_, ?_⟩
    · exact ⟨characteristicExp u.support,
        ⟨u.support, ⟨u, hu, rfl⟩, rfl⟩, rfl⟩
    · rw [heq, ← hueq]
      exact hue

omit [DecidableEq σ] in
/-- An ideal containing a monomial contains every multiple by a monomial. -/
theorem thm41_monomial_mem_of_le {J : Ideal (MvPolynomial σ K)}
    {z e : σ →₀ ℕ} (hz : z ≤ e)
    (hmem : (monomial z (1 : K) : MvPolynomial σ K) ∈ J) :
    (monomial e (1 : K) : MvPolynomial σ K) ∈ J := by
  let r : σ →₀ ℕ := e - z
  have hr : z + r = e := by
    ext i
    simpa [r] using Nat.add_sub_of_le (hz i)
  have heq : (monomial e (1 : K) : MvPolynomial σ K) =
      monomial r (1 : K) * monomial z (1 : K) := by
    rw [MvPolynomial.monomial_mul]
    simp only [one_mul]
    rw [add_comm r z, hr]
  rw [heq]
  exact Ideal.mul_mem_left J (monomial r (1 : K)) hmem

/-- The standard isolated-pair witness exponent from Equation (9). -/
noncomputable def thm41_obstructionExp [Fintype σ] (u v : σ →₀ ℕ) : σ →₀ ℕ :=
  Finsupp.onFinset (Finset.univ : Finset σ) (fun i =>
    if i ∈ u.support then
      if i ∈ v.support then max (2 * min (u i) (v i)) (max (u i) (v i))
      else u i
    else v i) (by intro i _; simp)

theorem thm41_obstructionExp_apply [Fintype σ] (u v : σ →₀ ℕ) (i : σ) :
    thm41_obstructionExp u v i =
      if i ∈ u.support then
        if i ∈ v.support then max (2 * min (u i) (v i)) (max (u i) (v i))
        else u i
      else v i := by
  unfold thm41_obstructionExp
  rw [Finsupp.onFinset_apply]

theorem thm41_mem_support_obstructionExp [Fintype σ] {u v : σ →₀ ℕ} {i : σ} :
    i ∈ (thm41_obstructionExp u v).support ↔ i ∈ u.support ∨ i ∈ v.support := by
  rw [Finsupp.mem_support_iff]
  by_cases hiu : i ∈ u.support <;> by_cases hiv : i ∈ v.support
  · rw [thm41_obstructionExp_apply, if_pos hiu, if_pos hiv]
    constructor
    · intro _
      exact Or.inl hiu
    · intro _
      have hup : 0 < u i := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hiu)
      have hvp : 0 < v i := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hiv)
      omega
  · rw [thm41_obstructionExp_apply, if_pos hiu, if_neg hiv]
    constructor
    · intro _
      exact Or.inl hiu
    · intro _
      exact Finsupp.mem_support_iff.mp hiu
  · rw [thm41_obstructionExp_apply, if_neg hiu]
    constructor
    · intro _
      exact Or.inr hiv
    · intro _
      exact Finsupp.mem_support_iff.mp hiv
  · rw [thm41_obstructionExp_apply, if_neg hiu]
    have hiv0 : v i = 0 := by simpa [Finsupp.mem_support_iff] using hiv
    constructor
    · intro h
      exact (h hiv0).elim
    · intro h
      rcases h with h | h
      · exact (hiu h).elim
      · exact (hiv h).elim

theorem thm41_le_obstructionExp_left [Fintype σ] (u v : σ →₀ ℕ) :
    u ≤ thm41_obstructionExp u v := by
  rw [Finsupp.le_def]
  intro i
  by_cases hiu : i ∈ u.support
  · by_cases hiv : i ∈ v.support
    · rw [thm41_obstructionExp_apply, if_pos hiu, if_pos hiv]
      exact (Nat.le_max_left (u i) (v i)).trans
        (Nat.le_max_right (2 * min (u i) (v i)) (max (u i) (v i)))
    · rw [thm41_obstructionExp_apply, if_pos hiu, if_neg hiv]
  · have hiu0 : u i = 0 := by simpa [Finsupp.mem_support_iff] using hiu
    rw [thm41_obstructionExp_apply, if_neg hiu]
    simp [hiu0]

theorem thm41_le_obstructionExp_right [Fintype σ] (u v : σ →₀ ℕ) :
    v ≤ thm41_obstructionExp u v := by
  rw [Finsupp.le_def]
  intro i
  by_cases hiv : i ∈ v.support
  · by_cases hiu : i ∈ u.support
    · rw [thm41_obstructionExp_apply, if_pos hiu, if_pos hiv]
      exact (Nat.le_max_right (u i) (v i)).trans
        (Nat.le_max_right (2 * min (u i) (v i)) (max (u i) (v i)))
    · rw [thm41_obstructionExp_apply, if_neg hiu]
  · have hiv0 : v i = 0 := by simpa [Finsupp.mem_support_iff] using hiv
    simp [thm41_obstructionExp_apply, hiv0]

/-- The elementary arithmetic obstruction used for a mismatching shared exponent. -/
theorem thm41_add_not_le_max_two_min_max {a b : ℕ}
    (ha : 0 < a) (hb : 0 < b) (hne : a ≠ b) :
    ¬ a + b ≤ max (2 * min a b) (max a b) := by
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · rw [Nat.min_eq_left (Nat.le_of_lt hlt), Nat.max_eq_right (Nat.le_of_lt hlt)]
    omega
  · rw [Nat.min_eq_right (Nat.le_of_lt hgt), Nat.max_eq_left (Nat.le_of_lt hgt)]
    omega

/-- BDK isolated-pair obstruction, derived here from Eq. (2), Simisness, and Lemma 4.2(i). -/
theorem thm41_lem42Isolated_of_std [Fintype σ]
    {I : Ideal (MvPolynomial σ K)} {A : ι → Finset σ} {a : ι → σ → ℕ}
    (hOne : thm41_lem42OneGenerator I) (hMono : IsMonomialIdeal I)
    (hComp : HasComponents I A a) (hStd : HasStdSymbolicFormula I (fun j => purePower (A j) (a j)))
    (hSimis : IsSimis I) (hcl : IsClutter (supportComplex I)) :
    thm41_lem42Isolated I := by
  classical
  intro F G hF hG hFG hIso u₀ v₀ hu₀ hv₀ hsupU hsupV
  let UF : {E : Finset σ // E ∈ supportComplex I} := ⟨F, hF⟩
  let VG : {E : Finset σ // E ∈ supportComplex I} := ⟨G, hG⟩
  let u := thm41_facetGen I hOne UF
  let v := thm41_facetGen I hOne VG
  have hu₀eq : u₀ = u := thm41_eq_facetGen hu₀ (by simpa [UF] using hsupU)
  have hv₀eq : v₀ = v := thm41_eq_facetGen hv₀ (by simpa [VG] using hsupV)
  rw [hu₀eq, hv₀eq]
  intro k hkF hkG
  by_contra hdiff
  have hUspec := thm41_facetGen_spec I hOne UF
  have hVspec := thm41_facetGen_spec I hOne VG
  have hUmem : u ∈ minGens I := by simpa only [u] using hUspec.1
  have hVmem : v ∈ minGens I := by simpa only [v] using hVspec.1
  have hUsupp : u.support = F := by simpa only [u, UF] using hUspec.2
  have hVsupp : v.support = G := by simpa only [v, VG] using hVspec.2
  have hFpriv : ∃ p, p ∈ F ∧ p ∉ G := by
    by_contra h
    have hsub : F ⊆ G := by
      intro x hx
      by_contra hxG
      exact h ⟨x, hx, hxG⟩
    exact hFG (hcl F hF G hG hsub)
  have hGpriv : ∃ q, q ∈ G ∧ q ∉ F := by
    by_contra h
    have hsub : G ⊆ F := by
      intro x hx
      by_contra hxF
      exact h ⟨x, hx, hxF⟩
    exact hFG (hcl G hG F hF hsub).symm
  rcases hFpriv with ⟨p, hpF, hpG⟩
  rcases hGpriv with ⟨q, hqG, hqF⟩
  let o := thm41_obstructionExp u v
  have hsupportO : o.support = F ∪ G := by
    ext i
    simpa only [o, hUsupp, hVsupp, Finset.mem_union] using
      (thm41_mem_support_obstructionExp (u := u) (v := v) (i := i))
  have hnotUU : ¬ u + u ≤ o := by
    intro hle
    have hpU : p ∈ u.support := by simpa only [hUsupp] using hpF
    have hpV : p ∉ v.support := by simpa only [hVsupp] using hpG
    have hppos : 0 < u p := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hpU)
    have hcoord : u p + u p ≤ u p := by
      simpa [o, thm41_obstructionExp_apply, hpU, hpV] using hle p
    omega
  have hnotVV : ¬ v + v ≤ o := by
    intro hle
    have hqV : q ∈ v.support := by simpa only [hVsupp] using hqG
    have hqU : q ∉ u.support := by simpa only [hUsupp] using hqF
    have hqpos : 0 < v q := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hqV)
    have hcoord : v q + v q ≤ v q := by
      simpa [o, thm41_obstructionExp_apply, hqU, hqV] using hle q
    omega
  have hnotUV : ¬ u + v ≤ o := by
    intro hle
    have hkU : k ∈ u.support := by simpa only [hUsupp] using hkF
    have hkV : k ∈ v.support := by simpa only [hVsupp] using hkG
    have hkupos : 0 < u k := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hkU)
    have hkvpos : 0 < v k := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hkV)
    have hcoord : u k + v k ≤ max (2 * min (u k) (v k)) (max (u k) (v k)) := by
      simpa [o, thm41_obstructionExp_apply, hkU, hkV] using hle k
    exact thm41_add_not_le_max_two_min_max hkupos hkvpos hdiff hcoord
  have hminEq := thm41_eq_minGens_of_isMonomialIdeal hMono
  have hnotI2 : (monomial o (1 : K) : MvPolynomial σ K) ∉ I ^ 2 := by
    intro hmem
    have hmemMul : (monomial o (1 : K) : MvPolynomial σ K) ∈ I * I := by
      simpa [pow_two] using hmem
    rw [hminEq] at hmemMul
    rw [monomialIdeal_mul] at hmemMul
    rcases monomial_mem_monomialIdeal.mp hmemMul with ⟨w, hw, hwo⟩
    rcases hw with ⟨u', hu', v', hv', rfl⟩
    have huleo : u' ≤ o := by
      have hleadd : u' ≤ u' + v' := by
        rw [Finsupp.le_def]
        intro i
        simp
      exact hleadd.trans hwo
    have hvleo : v' ≤ o := by
      have hleadd : v' ≤ u' + v' := by
        rw [Finsupp.le_def]
        intro i
        simp
      exact hleadd.trans hwo
    have huSub : u'.support ⊆ F ∪ G := by
      simpa [hsupportO] using Finsupp.support_mono huleo
    have hvSub : v'.support ⊆ F ∪ G := by
      simpa [hsupportO] using Finsupp.support_mono hvleo
    have huSet : u'.support ∈
        ({E : Finset σ | E ∈ supportComplex I ∧ E ⊆ F ∪ G} : Set (Finset σ)) :=
      ⟨⟨u', hu', rfl⟩, huSub⟩
    have hvSet : v'.support ∈
        ({E : Finset σ | E ∈ supportComplex I ∧ E ⊆ F ∪ G} : Set (Finset σ)) :=
      ⟨⟨v', hv', rfl⟩, hvSub⟩
    rw [hIso] at huSet hvSet
    have huCases : u'.support = F ∨ u'.support = G := by simpa using huSet
    have hvCases : v'.support = F ∨ v'.support = G := by simpa using hvSet
    rcases huCases with huF | huG
    · have hueq : u' = u := thm41_eq_facetGen (hOne := hOne) hu' (by simpa [UF] using huF)
      subst u'
      rcases hvCases with hvF | hvG
      · have hveq : v' = u := thm41_eq_facetGen (hOne := hOne) hv' (by simpa [UF] using hvF)
        subst v'
        exact hnotUU hwo
      · have hveq : v' = v := thm41_eq_facetGen (hOne := hOne) hv' (by simpa [VG] using hvG)
        subst v'
        exact hnotUV hwo
    · have hueq : u' = v := thm41_eq_facetGen (hOne := hOne) hu' (by simpa [VG] using huG)
      subst u'
      rcases hvCases with hvF | hvG
      · have hveq : v' = u := thm41_eq_facetGen (hOne := hOne) hv' (by simpa [UF] using hvF)
        subst v'
        have hwo' : u + v ≤ o := by
          calc
            u + v = v + u := add_comm _ _
            _ ≤ o := hwo
        exact hnotUV hwo'
      · have hveq : v' = v := thm41_eq_facetGen (hOne := hOne) hv' (by simpa [VG] using hvG)
        subst v'
        exact hnotVV hwo
  have hComp' : I = ⨅ j, (purePower (A j) (a j) : Ideal (MvPolynomial σ K)) := hComp
  have hCompMem : (monomial o (1 : K) : MvPolynomial σ K) ∈
      componentSymbolic (fun j => purePower (A j) (a j)) 2 := by
    rw [componentSymbolic]
    refine Ideal.mem_iInf.mpr ?_
    intro j
    have huInt : (monomial u (1 : K) : MvPolynomial σ K) ∈
        ⨅ k, (purePower (A k) (a k) : Ideal (MvPolynomial σ K)) := by
      rw [← hComp']
      exact (mem_minGens.mp hUmem).1
    have hvInt : (monomial v (1 : K) : MvPolynomial σ K) ∈
        ⨅ k, (purePower (A k) (a k) : Ideal (MvPolynomial σ K)) := by
      rw [← hComp']
      exact (mem_minGens.mp hVmem).1
    rcases monomial_mem_purePower.mp (Ideal.mem_iInf.mp huInt j) with ⟨r, hrA, hrle⟩
    rcases monomial_mem_purePower.mp (Ideal.mem_iInf.mp hvInt j) with ⟨s, hsA, hsle⟩
    let x : σ →₀ ℕ := Finsupp.single r (a j r)
    let y : σ →₀ ℕ := Finsupp.single s (a j s)
    have hxQ : (monomial x (1 : K) : MvPolynomial σ K) ∈ purePower (A j) (a j) := by
      exact monomial_mem_purePower.mpr ⟨r, hrA, by simp [x]⟩
    have hyQ : (monomial y (1 : K) : MvPolynomial σ K) ∈ purePower (A j) (a j) := by
      exact monomial_mem_purePower.mpr ⟨s, hsA, by simp [y]⟩
    by_cases hrs : r = s
    · subst s
      have hx2mul : (monomial (x + x) (1 : K) : MvPolynomial σ K) ∈
          purePower (A j) (a j) * purePower (A j) (a j) := by
        simpa [MvPolynomial.monomial_mul] using Ideal.mul_mem_mul hxQ hxQ
      have hx2 : (monomial (x + x) (1 : K) : MvPolynomial σ K) ∈
          purePower (A j) (a j) ^ 2 := by
        simpa [pow_two] using hx2mul
      apply thm41_monomial_mem_of_le (z := x + x) (e := o) ?_ hx2
      rw [Finsupp.le_def]
      intro t
      by_cases htr : t = r
      · subst t
        have hxcoef : (x + x) r = a j r + a j r := by simp [x]
        rw [hxcoef]
        change a j r + a j r ≤ thm41_obstructionExp u v r
        by_cases hUr : r ∈ u.support <;> by_cases hVr : r ∈ v.support
        · rw [thm41_obstructionExp_apply, if_pos hUr, if_pos hVr]
          omega
        · have hvr0 : v r = 0 := by simpa [Finsupp.mem_support_iff] using hVr
          rw [thm41_obstructionExp_apply, if_pos hUr, if_neg hVr]
          omega
        · have hur0 : u r = 0 := by simpa [Finsupp.mem_support_iff] using hUr
          rw [thm41_obstructionExp_apply, if_neg hUr]
          omega
        · have hur0 : u r = 0 := by simpa [Finsupp.mem_support_iff] using hUr
          have hvr0 : v r = 0 := by simpa [Finsupp.mem_support_iff] using hVr
          rw [thm41_obstructionExp_apply, if_neg hUr]
          omega
      · simp [x, htr]
    · have hxleu : x ≤ u := Finsupp.single_le_iff.mpr hrle
      have hylev : y ≤ v := Finsupp.single_le_iff.mpr hsle
      have hxleo : x ≤ o := hxleu.trans (thm41_le_obstructionExp_left u v)
      have hyleo : y ≤ o := hylev.trans (thm41_le_obstructionExp_right u v)
      have hprod : (monomial (x + y) (1 : K) : MvPolynomial σ K) ∈
          purePower (A j) (a j) * purePower (A j) (a j) := by
        simpa [MvPolynomial.monomial_mul] using Ideal.mul_mem_mul hxQ hyQ
      have hpow : (monomial (x + y) (1 : K) : MvPolynomial σ K) ∈
          purePower (A j) (a j) ^ 2 := by
        simpa [pow_two] using hprod
      apply thm41_monomial_mem_of_le (z := x + y) (e := o) ?_ hpow
      rw [Finsupp.le_def]
      intro t
      by_cases htr : t = r
      · subst t
        have hsr : s ≠ r := fun h => hrs h.symm
        simpa [x, y, hsr] using hxleo r
      · by_cases hts : t = s
        · subst t
          simpa [x, y, hrs] using hyleo s
        · have hrt : r ≠ t := fun h => htr h.symm
          have hst : s ≠ t := fun h => hts h.symm
          simp [x, y, hrt, hst]
  have hpowEq : I ^ 2 = componentSymbolic (fun j => purePower (A j) (a j)) 2 := by
    calc
      I ^ 2 = symbolicPower I 2 := (hSimis 2 (by norm_num)).symm
      _ = componentSymbolic (fun j => purePower (A j) (a j)) 2 := hStd 2 (by norm_num)
  exact hnotI2 (by simpa [hpowEq] using hCompMem)

/-- Theorem 4.1 in a form with its standard external inputs explicit: BDK Lemma 4.2(i),
Eq. (2), and Eq. (4). Lemma 4.2(ii) and Lemma 4.3 are proved above. -/
theorem thm41_main [Fintype σ] [Fintype ι]
    {I : Ideal (MvPolynomial σ K)} {A : ι → Finset σ} {a : ι → σ → ℕ}
    (hMPV : MPVHypotheses I A a) (hsp : SupportPreserving I)
    (hno : ¬ HasStrongTriangle (supportComplex I))
    (hOne : thm41_lem42OneGenerator I)
    (hStd : HasStdSymbolicFormula I (fun j => purePower (A j) (a j)))
    (heq4 : thm41_eq4 (σ := σ) (K := K)) : MPVConc I := by
  classical
  have hcl : IsClutter (supportComplex I) := thm41_isClutter_of_supportPreserving hsp
  have h43 : thm41_lem43Isolation (supportComplex I) :=
    thm41_lem43_isolation_of_clutter_noTriangle hcl hno
  have hMono : IsMonomialIdeal I :=
    thm41_isMonomialIdeal_of_hasComponents hMPV.1.1
  have hIso : thm41_lem42Isolated I :=
    thm41_lem42Isolated_of_std hOne hMono hMPV.1.1 hStd hMPV.2.2 hcl
  have hcoh : thm41_generatorCoherence I :=
    thm41_generatorCoherence_of_lem42_lem43 hOne hIso h43
  let d : σ → ℕ := thm41_weight I hOne
  let J : Ideal (MvPolynomial σ K) :=
    monomialIdeal (characteristicExp '' supportComplex I)
  have hd : ∀ i, 0 < d i := by
    intro i
    simpa [d] using thm41_weight_pos (I := I) (hOne := hOne) i
  have hdiag : diagonal d J = I := by
    have hminEq := thm41_eq_minGens_of_isMonomialIdeal hMono
    dsimp [J]
    rw [diagonal_monomialIdeal]
    refine Eq.trans ?_ hminEq.symm
    apply monomialIdeal_eq_iff.mpr
    intro e
    constructor
    · rintro ⟨z, hzImg, hzle⟩
      rcases hzImg with ⟨c, hc, rfl⟩
      rcases hc with ⟨F, hFH, rfl⟩
      let FS : {E : Finset σ // E ∈ supportComplex I} := ⟨F, hFH⟩
      have heq : diagExp d (characteristicExp F) = thm41_facetGen I hOne FS := by
        simpa [d, FS] using thm41_diagExp_characteristic_eq_facetGen hcoh FS
      exact ⟨thm41_facetGen I hOne FS, (thm41_facetGen_spec I hOne FS).1, heq ▸ hzle⟩
    · rintro ⟨u, hu, hue⟩
      let F : {E : Finset σ // E ∈ supportComplex I} := ⟨u.support, ⟨u, hu, rfl⟩⟩
      have hueq : u = thm41_facetGen I hOne F :=
        thm41_eq_facetGen (hOne := hOne) hu rfl
      have heq : diagExp d (characteristicExp u.support) = thm41_facetGen I hOne F := by
        simpa [d, F] using thm41_diagExp_characteristic_eq_facetGen hcoh F
      refine ⟨diagExp d (characteristicExp u.support), ?_, ?_⟩
      · exact ⟨characteristicExp u.support,
          ⟨u.support, ⟨u, hu, rfl⟩, rfl⟩, rfl⟩
      · rw [heq, ← hueq]
        exact hue
  have hJsquare : IsSquarefreeMonomialIdeal J := by
    exact ⟨supportComplex I, rfl⟩
  have hIsI : IsSimis I := hMPV.2.2
  have hIsDiag : IsSimis (diagonal d J) := by simpa [hdiag] using hIsI
  have hJsimis : IsSimis J := (heq4 J d hd).mpr hIsDiag
  exact ⟨J, d, hJsquare, hJsimis, hd, hdiag⟩

/-- Balanced support clutters have no strong triangle, giving the stated corollary. -/
theorem thm41_of_balanced [Fintype σ] [Fintype ι]
    {I : Ideal (MvPolynomial σ K)} {A : ι → Finset σ} {a : ι → σ → ℕ}
    (hMPV : MPVHypotheses I A a) (hsp : SupportPreserving I)
    (hbal : IsBalanced (supportComplex I))
    (hOne : thm41_lem42OneGenerator I)
    (hStd : HasStdSymbolicFormula I (fun j => purePower (A j) (a j)))
    (heq4 : thm41_eq4 (σ := σ) (K := K)) : MPVConc I := by
  apply thm41_main hMPV hsp ?_ hOne hStd heq4
  intro ht
  exact hbal 3 (by norm_num) ht

/-- Theorem 4.1 with Eq. (2), BDK Lemma 4.2, and Eq. (4) all discharged by imports.
The root's irredundant prime decomposition is obtained from Proposition 2.1, after which the
unconditional componentwise wrapper in `Eq4_DiagonalSimis` applies. -/
theorem thm41_main_proved [Fintype σ] [Fintype ι]
    {I : Ideal (MvPolynomial σ K)} {A : ι → Finset σ} {a : ι → σ → ℕ}
    (hMPV : MPVHypotheses I A a) (hsp : SupportPreserving I)
    (hno : ¬ HasStrongTriangle (supportComplex I)) : MPVConc I := by
  classical
  have hStd : HasStdSymbolicFormula I (fun j => purePower (A j) (a j)) :=
    eq2_standardSymbolic hMPV.1 hMPV.2.1
  have h42 := lem42 (K := K) hMPV hsp hStd
  have hOne : thm41_lem42OneGenerator I := by
    simpa [thm41_lem42OneGenerator] using h42.1
  have hcl : IsClutter (supportComplex I) := thm41_isClutter_of_supportPreserving hsp
  have h43 : thm41_lem43Isolation (supportComplex I) :=
    thm41_lem43_isolation_of_clutter_noTriangle hcl hno
  have hMono : IsMonomialIdeal I :=
    thm41_isMonomialIdeal_of_hasComponents hMPV.1.1
  have hIso : thm41_lem42Isolated I := by
    intro F G hF hG hFG hIsoSet u v hu hv hsuppU hsuppV i hiF hiG
    exact h42.2 F G hF hG hFG hIsoSet u v hu hv hsuppU hsuppV i hiF hiG
  have hcoh : thm41_generatorCoherence I :=
    thm41_generatorCoherence_of_lem42_lem43 hOne hIso h43
  let d : σ → ℕ := thm41_weight I hOne
  let J : Ideal (MvPolynomial σ K) := thm41_squarefreeRoot I
  have hd : ∀ i, 0 < d i := by
    intro i
    simpa [d] using thm41_weight_pos (I := I) (hOne := hOne) i
  have hdiag : diagonal d J = I := by
    simpa [d, J] using
      (thm41_diagonal_squarefreeRoot_eq (I := I) (hOne := hOne) hMono hcoh)
  have hJsquare : IsSquarefreeMonomialIdeal J := by
    exact ⟨supportComplex I, rfl⟩
  have hJcomp : HasComponents J A (fun (_ : ι) (_ : σ) => 1) := by
    simpa [HasComponents, primeOf] using
      (prop21_sqRoot_eq_iInf_primeOf (K := K) hMPV.1.1 hMPV.1.2 hJsquare hd hdiag)
  have hJirr : IsIrredundant (K := K) A (fun (_ : ι) (_ : σ) => 1) := by
    exact prop21_isIrredundant_primeOf_of_hasSqRoot hMPV.1.1 hMPV.1.2
      ⟨J, d, hJsquare, hd, hdiag⟩
  have hJanti : SupportsAntichain A (fun (_ : ι) (_ : σ) => 1) := by
    intro j k hsub
    exact hMPV.2.1 j k hsub
  have heq4J : IsSimis J ↔ IsSimis (diagonal d J) :=
    eq4_isSimis_diagonal_iff_of_irredundantDecomp
      (K := K) (J := J) (A := A) (a := fun (_ : ι) (_ : σ) => 1) (d := d)
      hd ⟨hJcomp, hJirr⟩ hJanti
  have hIsI : IsSimis I := hMPV.2.2
  have hIsDiag : IsSimis (diagonal d J) := by simpa [hdiag] using hIsI
  have hJsimis : IsSimis J := heq4J.mpr hIsDiag
  exact ⟨J, d, hJsquare, hJsimis, hd, hdiag⟩

/-- Balanced corollary with all three algebraic ingredients discharged by imports. -/
theorem thm41_of_balanced_proved [Fintype σ] [Fintype ι]
    {I : Ideal (MvPolynomial σ K)} {A : ι → Finset σ} {a : ι → σ → ℕ}
    (hMPV : MPVHypotheses I A a) (hsp : SupportPreserving I)
    (hbal : IsBalanced (supportComplex I)) : MPVConc I := by
  apply thm41_main_proved hMPV hsp
  intro ht
  exact hbal 3 (by norm_num) ht

/-- The support root is the radical once coherence supplies the forced diagonal model. -/
theorem thm41_squarefreeRoot_eq_radical [Fintype σ] [Fintype ι]
    {I : Ideal (MvPolynomial σ K)} {A : ι → Finset σ} {a : ι → σ → ℕ}
    {hOne : thm41_lem42OneGenerator I} (hMPV : MPVHypotheses I A a)
    (hcoh : thm41_generatorCoherence I) :
    thm41_squarefreeRoot I = I.radical := by
  classical
  let d : σ → ℕ := thm41_weight I hOne
  have hd : ∀ i, 0 < d i := by
    intro i
    simpa [d] using thm41_weight_pos (I := I) (hOne := hOne) i
  have hMono : IsMonomialIdeal I :=
    thm41_isMonomialIdeal_of_hasComponents hMPV.1.1
  have hdiag : diagonal d (thm41_squarefreeRoot I) = I := by
    simpa [d] using
      (thm41_diagonal_squarefreeRoot_eq (I := I) (hOne := hOne) hMono hcoh)
  have hSquare : IsSquarefreeMonomialIdeal (thm41_squarefreeRoot I) :=
    ⟨supportComplex I, rfl⟩
  exact prop21_sqRoot_eq_radical (I := I) (J := thm41_squarefreeRoot I) (A := A) (a := a)
    (d := d) hMPV.1.1 hMPV.1.2 hSquare hd hdiag

/-- Theorem 4.1 with all intermediate conclusions packaged. `MPVHypotheses` does not record
the paper's nonzero and proper assumptions, so they are explicit here. -/
theorem thm41_full [Fintype σ] [Fintype ι]
    {I : Ideal (MvPolynomial σ K)} {A : ι → Finset σ} {a : ι → σ → ℕ}
    (hI0 : I ≠ ⊥) (hIproper : I ≠ ⊤) (hMPV : MPVHypotheses I A a)
    (hsp : SupportPreserving I) (hno : ¬ HasStrongTriangle (supportComplex I)) :
    thm41_lem42OneGenerator I ∧
      thm41_generatorCoherence I ∧
        ∃ d : σ → ℕ,
          (∀ i, 0 < d i) ∧
            (∀ (i : σ) (F : Finset σ) (u : σ →₀ ℕ), F ∈ supportComplex I → i ∈ F →
              u ∈ minGens I → u.support = F → d i = u i) ∧
            (∀ i : σ, (∀ F : Finset σ, F ∈ supportComplex I → i ∉ F) → d i = 1) ∧
            IsSquarefreeMonomialIdeal (thm41_squarefreeRoot I) ∧
            thm41_squarefreeRoot I = I.radical ∧
            I = diagonal d (thm41_squarefreeRoot I) ∧
            IsSimis (thm41_squarefreeRoot I) := by
  classical
  by_cases hbot : I = ⊥
  · exact (hI0 hbot).elim
  by_cases htop : I = ⊤
  · exact (hIproper htop).elim
  have hStd : HasStdSymbolicFormula I (fun j => purePower (A j) (a j)) :=
    eq2_standardSymbolic hMPV.1 hMPV.2.1
  have h42 := lem42 (K := K) hMPV hsp hStd
  have hOne : thm41_lem42OneGenerator I := by
    simpa [thm41_lem42OneGenerator] using h42.1
  have hcl : IsClutter (supportComplex I) := thm41_isClutter_of_supportPreserving hsp
  have h43 : thm41_lem43Isolation (supportComplex I) :=
    thm41_lem43_isolation_of_clutter_noTriangle hcl hno
  have hMono : IsMonomialIdeal I :=
    thm41_isMonomialIdeal_of_hasComponents hMPV.1.1
  have hIso : thm41_lem42Isolated I := by
    intro F G hF hG hFG hIsoSet u v hu hv hsuppU hsuppV i hiF hiG
    exact h42.2 F G hF hG hFG hIsoSet u v hu hv hsuppU hsuppV i hiF hiG
  have hcoh : thm41_generatorCoherence I :=
    thm41_generatorCoherence_of_lem42_lem43 hOne hIso h43
  let d : σ → ℕ := thm41_weight I hOne
  let J : Ideal (MvPolynomial σ K) := thm41_squarefreeRoot I
  have hd : ∀ i, 0 < d i := by
    intro i
    simpa [d] using thm41_weight_pos (I := I) (hOne := hOne) i
  have hdiag : diagonal d J = I := by
    simpa [d, J] using
      (thm41_diagonal_squarefreeRoot_eq (I := I) (hOne := hOne) hMono hcoh)
  have hJsquare : IsSquarefreeMonomialIdeal J :=
    ⟨supportComplex I, rfl⟩
  have hJrad : J = I.radical := by
    simpa [J] using
      (thm41_squarefreeRoot_eq_radical (I := I) (A := A) (a := a) (hOne := hOne)
        hMPV hcoh)
  have hUsed : ∀ (i : σ) (F : Finset σ) (u : σ →₀ ℕ),
      F ∈ supportComplex I → i ∈ F →
      u ∈ minGens I → u.support = F → d i = u i := by
    intro i F u hF hi hu hsupp
    let FS : {E : Finset σ // E ∈ supportComplex I} := ⟨F, hF⟩
    have hW : d i = thm41_facetGen I hOne FS i := by
      simpa [d, FS] using (thm41_weight_eq_facetGen hcoh FS hi)
    have hU : u = thm41_facetGen I hOne FS :=
      thm41_eq_facetGen (hOne := hOne) hu hsupp
    simpa [hU] using hW
  have hUnused : ∀ i : σ, (∀ F : Finset σ, F ∈ supportComplex I → i ∉ F) →
      d i = 1 := by
    intro i hi
    dsimp [d, thm41_weight]
    split_ifs with h
    · rcases h with ⟨F, hiF⟩
      exact (hi F.1 F.2 hiF).elim
    · rfl
  have hJsimis : IsSimis J := by
    rcases thm41_main_proved hMPV hsp hno with
      ⟨J₀, d₀, hJ₀square, hJ₀simis, hd₀, hdiag₀⟩
    have hJ₀rad : J₀ = I.radical :=
      prop21_sqRoot_eq_radical (I := I) (J := J₀) (A := A) (a := a) (d := d₀)
        hMPV.1.1 hMPV.1.2 hJ₀square hd₀ hdiag₀
    have hJJ₀ : J = J₀ := hJrad.trans hJ₀rad.symm
    simpa [hJJ₀] using hJ₀simis
  refine ⟨hOne, hcoh, d, hd, hUsed, hUnused, hJsquare, hJrad, ?_, hJsimis⟩
  simpa [J] using hdiag.symm

/-- The same full statement when the support complex is balanced. -/
theorem thm41_full_of_balanced [Fintype σ] [Fintype ι]
    {I : Ideal (MvPolynomial σ K)} {A : ι → Finset σ} {a : ι → σ → ℕ}
    (hI0 : I ≠ ⊥) (hIproper : I ≠ ⊤) (hMPV : MPVHypotheses I A a)
    (hsp : SupportPreserving I) (hbal : IsBalanced (supportComplex I)) :
    thm41_lem42OneGenerator I ∧
      thm41_generatorCoherence I ∧
        ∃ d : σ → ℕ,
          (∀ i, 0 < d i) ∧
            (∀ (i : σ) (F : Finset σ) (u : σ →₀ ℕ), F ∈ supportComplex I → i ∈ F →
              u ∈ minGens I → u.support = F → d i = u i) ∧
            (∀ i : σ, (∀ F : Finset σ, F ∈ supportComplex I → i ∉ F) → d i = 1) ∧
            IsSquarefreeMonomialIdeal (thm41_squarefreeRoot I) ∧
            thm41_squarefreeRoot I = I.radical ∧
            I = diagonal d (thm41_squarefreeRoot I) ∧
            IsSimis (thm41_squarefreeRoot I) := by
  apply thm41_full hI0 hIproper hMPV hsp
  intro ht
  exact hbal 3 (by norm_num) ht

end SimisFormal
