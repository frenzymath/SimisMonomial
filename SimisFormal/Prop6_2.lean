  · rintro ⟨e, he, hsupp⟩
    rcases he with ⟨z, hz, hez⟩
    refine ⟨z, hz, ?_⟩
    calc
      T = e.support := hsupp.symm
      _ = (prop62_weightedTransversalExp a z).support := by rw [hez]
      _ = Finset.univ.image z := prop62_weightedTransversalExp_support hB ha hz
  · rintro ⟨z, hz, hT⟩
    refine ⟨prop62_weightedTransversalExp a z, ⟨z, hz, rfl⟩, ?_⟩
    exact (prop62_weightedTransversalExp_support hB ha hz).trans hT.symm

