/-- The root has the displayed irredundant irreducible decomposition. -/
theorem prop62_isIrredundantDecomp_root {B : ι → Finset σ} (hB : prop62_BlockFamily B) :
    IsIrredundantDecomp (prop62_rootIdeal (K := K) B) B
      (fun _ : ι ↦ fun _ : σ ↦ 1) :=
  ⟨prop62_hasComponents_root (K := K) B, prop62_isIrredundant_root (K := K) hB⟩

/-- Any positive squarefree diagonal root of \(I_a\) is the displayed radical. -/
theorem prop62_sqRoot_eq_root {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    {a : σ → ℕ} (ha : ∀ x, 0 < a x) {J : Ideal (MvPolynomial σ K)} {d : σ → ℕ}
    (hJ : IsSquarefreeMonomialIdeal J) (hd : ∀ x, 0 < d x)
    (hdiag : diagonal d J = prop62_weightedIdeal (K := K) B a) :
    J = prop62_rootIdeal (K := K) B := by
  simpa [prop62_rootIdeal] using
    (prop21_sqRoot_eq_iInf_primeOf (K := K)
      (I := prop62_weightedIdeal (K := K) B a)
      (A := B) (a := fun _ : ι ↦ a) (d := d)
      (prop62_hasComponents_weighted (K := K) (B := B) (a := a))
      (prop62_isIrredundant (K := K) hB ha) hJ hd hdiag)

/-- The positive squarefree diagonal root is unique for \(I_a\). -/
theorem prop62_sqRoot_unique {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    {J₁ J₂ : Ideal (MvPolynomial σ K)} {d₁ d₂ : σ → ℕ}
    (hJ₁ : IsSquarefreeMonomialIdeal J₁) (hd₁ : ∀ x, 0 < d₁ x)
    (hdiag₁ : diagonal d₁ J₁ = prop62_weightedIdeal (K := K) B a)
    (hJ₂ : IsSquarefreeMonomialIdeal J₂) (hd₂ : ∀ x, 0 < d₂ x)
    (hdiag₂ : diagonal d₂ J₂ = prop62_weightedIdeal (K := K) B a) : J₁ = J₂ :=
  (prop62_sqRoot_eq_root (K := K) hB ha hJ₁ hd₁ hdiag₁).trans
    (prop62_sqRoot_eq_root (K := K) hB ha hJ₂ hd₂ hdiag₂).symm

/-- A second positive weighting is forced to agree with \(a\) on every used variable. -/
theorem prop62_sqRoot_forcedWeights_on_blocks {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    {J : Ideal (MvPolynomial σ K)} (hJ : IsSquarefreeMonomialIdeal J) {d : σ → ℕ}
    (hd : ∀ x, 0 < d x) (hdiag : diagonal d J = prop62_weightedIdeal (K := K) B a) :
    ∀ h x, x ∈ B h → d x = a x := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  choose z₀ hz₀ using hne
  have hBz : prop62_BlockFamily B :=
    ⟨fun h ↦ ⟨z₀ h, hz₀ h⟩, hdisj, hcover⟩
  intro h x hxB
  let z : ι → σ := fun k ↦ if k = h then x else z₀ k
  have hz : ∀ k, z k ∈ B k := by
    intro k
    by_cases hk : k = h
    · simpa [z, hk] using hxB
    · simpa [z, hk] using hz₀ k
  let e : σ →₀ ℕ := prop62_weightedTransversalExp a z
  have heMin : e ∈ minGens (prop62_weightedIdeal (K := K) B a) := by
    rw [prop62_minGens_weightedIdeal (K := K) hBz ha]
    exact ⟨z, hz, rfl⟩
  have hzh : z h = x := by simp [z]
  have hcoord : e (z h) = a (z h) := by
    change prop62_weightedTransversalExp a z (z h) = a (z h)
    exact prop62_weightedTransversalExp_apply_choice hdisj hz h
  have hcoordx : e x = a x := by simpa [hzh] using hcoord
  have hpos : 0 < e x := by simpa [hcoordx] using ha x
  have hdcoord := prop21_minGen_coordinate_eq_weight (K := K) hJ hd hdiag heMin hpos
  exact hdcoord.symm.trans hcoordx

/-- Because the blocks cover all variables, all weights of any competing root are forced. -/
theorem prop62_sqRoot_forcedWeights {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    {J : Ideal (MvPolynomial σ K)} (hJ : IsSquarefreeMonomialIdeal J) {d : σ → ℕ}
    (hd : ∀ x, 0 < d x) (hdiag : diagonal d J = prop62_weightedIdeal (K := K) B a) :
    d = a := by
  funext x
  rcases hB.2.2 x with ⟨h, hx⟩
  exact prop62_sqRoot_forcedWeights_on_blocks (K := K) hB ha hJ hd hdiag h x hx

/-- The canonical root and its weights are both uniquely determined. -/
theorem prop62_sqRoot_eq_root_and_forcedWeights {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    {J : Ideal (MvPolynomial σ K)} (hJ : IsSquarefreeMonomialIdeal J) {d : σ → ℕ}
    (hd : ∀ x, 0 < d x) (hdiag : diagonal d J = prop62_weightedIdeal (K := K) B a) :
    J = prop62_rootIdeal (K := K) B ∧ d = a :=
  ⟨prop62_sqRoot_eq_root (K := K) hB ha hJ hd hdiag,
    prop62_sqRoot_forcedWeights (K := K) hB ha hJ hd hdiag⟩

/-- Proposition 6.2, packaged with all algebraic and combinatorial clauses. -/
theorem prop62_main {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    {a : σ → ℕ} (ha : ∀ x, 0 < a x) :
    let R := MvPolynomial σ K
    let I : Ideal R := prop62_weightedIdeal (K := K) B a
    let J : Ideal R := prop62_rootIdeal (K := K) B
    let A : ι → σ → ℕ := fun _ ↦ a
    let O : ι → σ → ℕ := fun _ ↦ fun _ ↦ 1
    let Q : ι → Ideal R := fun h ↦ purePower (B h) a
    let P : ι → Ideal R := fun h ↦ primeOf (B h)
    HasComponents I B A ∧
      HasComponents J B O ∧
      IsIrredundant (K := K) B A ∧
      IsIrredundant (K := K) B O ∧
      IsIrredundantDecomp I B A ∧
      IsIrredundantDecomp J B O ∧
      SupportsAntichain B A ∧
      SupportsAntichain B O ∧
      (∀ h, (P h).height = ((B h).card : ℕ∞)) ∧
      (∀ h, (Q h).height = ((B h).card : ℕ∞)) ∧
      minGens I = prop62_weightedTransversalGens B a ∧
      minGens J = prop62_transversalGens B ∧
      (∀ q : ℕ, I ^ q = componentSymbolic Q q) ∧
      (∀ q : ℕ, J ^ q = componentSymbolic P q) ∧
      HasStdSymbolicFormula I Q ∧
      HasStdSymbolicFormula J P ∧
      IsSimis I ∧
      IsSimis J ∧
      MPVConc I ∧
      associatedPrimes R (R ⧸ I) = Set.range P ∧
      associatedPrimes R (R ⧸ J) = Set.range P ∧
      (∀ q : ℕ, 1 ≤ q → associatedPrimes R (R ⧸ I ^ q) = Set.range P) ∧
      (∀ q : ℕ, 1 ≤ q → associatedPrimes R (R ⧸ J ^ q) = Set.range P) ∧
      prop21NormallyTorsionFree I ∧
      prop21NormallyTorsionFree J ∧
      SupportPreserving I ∧
      I.radical = J ∧
      diagonal a J = I ∧
      IsSquarefreeMonomialIdeal J ∧
      supportComplex I = prop62_facets B ∧
      supportComplex J = prop62_facets B ∧
      mismatchPairs B A = ∅ ∧
      (∀ k l, prop62_intervenorSet B k l = ∅) ∧
      (prop62_twoLargeBlocks B → ¬ ∃ F, IsLeaf (prop62_facets B) F) ∧
      (prop62_threeLargeBlocks B → HasStrongTriangle (prop62_facets B)) ∧
      (IsSquarefreeMonomialIdeal I ↔ a = fun _ : σ ↦ 1) ∧
      (∀ {J' : Ideal R} {d : σ → ℕ}, IsSquarefreeMonomialIdeal J' →
        (∀ x, 0 < d x) → diagonal d J' = I → J' = J ∧ d = a) ∧
      (∀ {J₁ J₂ : Ideal R} {d₁ d₂ : σ → ℕ},
        IsSquarefreeMonomialIdeal J₁ → (∀ x, 0 < d₁ x) → diagonal d₁ J₁ = I →
        IsSquarefreeMonomialIdeal J₂ → (∀ x, 0 < d₂ x) → diagonal d₂ J₂ = I →
          J₁ = J₂) ∧
      ∀ {J' : Ideal R} {d : σ → ℕ}, IsSquarefreeMonomialIdeal J' →
        (∀ x, 0 < d x) → diagonal d J' = I → ∀ h x, x ∈ B h → d x = a x := by
  classical
  dsimp only
  refine ⟨prop62_hasComponents_weighted (K := K) (B := B) (a := a), ?_⟩
  refine ⟨prop62_hasComponents_root (K := K) B, ?_⟩
  refine ⟨prop62_isIrredundant (K := K) hB ha, ?_⟩
  refine ⟨prop62_isIrredundant_root (K := K) hB, ?_⟩
  refine ⟨prop62_isIrredundantDecomp (K := K) hB ha, ?_⟩
  refine ⟨prop62_isIrredundantDecomp_root (K := K) hB, ?_⟩
  refine ⟨prop62_supportsAntichain (a := a) hB, ?_⟩
  refine ⟨prop62_supportsAntichain (a := fun _ : σ ↦ 1) hB, ?_⟩
  refine ⟨fun h ↦ prop62_height_primeOf (K := K) hB h, ?_⟩
  refine ⟨fun h ↦ prop62_height_purePower (K := K) hB ha h, ?_⟩
  refine ⟨prop62_minGens_weightedIdeal (K := K) hB ha, ?_⟩
  refine ⟨prop62_minGens_rootIdeal (K := K) hB, ?_⟩
  refine ⟨fun q ↦ prop62_weightedIdeal_pow_eq_componentSymbolic (K := K) hB q, ?_⟩
  refine ⟨fun q ↦ prop62_rootIdeal_pow_eq_componentSymbolic (K := K) hB q, ?_⟩
  refine ⟨prop62_weighted_hasStdSymbolicFormula (K := K) hB ha, ?_⟩
  refine ⟨prop62_root_hasStdSymbolicFormula (K := K) hB, ?_⟩
  refine ⟨prop62_weighted_isSimis (K := K) hB ha, ?_⟩
  refine ⟨prop62_root_isSimis (K := K) hB, ?_⟩
  refine ⟨(prop62_simis_and_MPVConc (K := K) hB ha).2, ?_⟩
  refine ⟨prop62_associatedPrimes_weighted_eq_range (K := K) hB ha, ?_⟩
  refine ⟨prop62_associatedPrimes_root_eq_range (K := K) hB, ?_⟩
  refine ⟨fun q hq ↦
    prop62_weighted_associatedPrimes_pow_eq_range (K := K) hB ha hq, ?_⟩
  refine ⟨fun q hq ↦
    prop62_root_associatedPrimes_pow_eq_range (K := K) hB hq, ?_⟩
  refine ⟨prop62_weighted_isNormallyTorsionFree (K := K) hB ha, ?_⟩
  refine ⟨prop62_root_isNormallyTorsionFree (K := K) hB, ?_⟩
  refine ⟨prop62_supportPreserving (K := K) hB ha, ?_⟩
  refine ⟨prop62_weightedIdeal_radical_eq (K := K) ha, ?_⟩
  refine ⟨prop62_weightedIdeal_eq_diagonal_rootIdeal (K := K) hB, ?_⟩
  refine ⟨prop62_rootIdeal_isSquarefree (K := K) hB, ?_⟩
  refine ⟨prop62_supportComplex_weighted (K := K) hB ha, ?_⟩
  refine ⟨prop62_supportComplex_root (K := K) hB, ?_⟩
  refine ⟨prop62_mismatchPairs_eq_empty B a, ?_⟩
  refine ⟨fun k l ↦ prop62_intervenorSet_eq_empty hB k l, ?_⟩
  refine ⟨fun htwo ↦ prop62_noLeaf_of_twoLargeBlocks hB htwo, ?_⟩
  refine ⟨fun hthree ↦
