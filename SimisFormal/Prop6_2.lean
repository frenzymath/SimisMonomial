/-- The displayed prime decomposition of the root is irredundant. -/
theorem prop62_isIrredundant_root {B : ι → Finset σ} (hB : prop62_BlockFamily B) :
    IsIrredundant (K := K) B (fun _ : ι ↦ fun _ : σ ↦ 1) := by
  change IsIrredundant (K := K) B (fun _ : ι ↦ fun _ : σ ↦ 1)
  exact prop62_isIrredundant (K := K) hB (a := fun _ : σ ↦ 1)
    (fun _ ↦ Nat.zero_lt_one)

