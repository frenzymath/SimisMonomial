/-- Since the blocks are disjoint and nonempty, no component can intervene between another pair. -/
theorem prop62_intervenorSet_eq_empty {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    (k l : ι) : prop62_intervenorSet B k l = ∅ := by
  rcases hB with ⟨hne, hdisj, hcover⟩
  ext j
  simp only [prop62_intervenorSet, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
  rintro ⟨hjk, hjl, hsub⟩
  rcases hne j with ⟨x, hx⟩
  rcases Finset.mem_union.mp (hsub hx) with hxk | hxl
  · exact hjk (hdisj j k x hx hxk)
  · exact hjl (hdisj j l x hx hxl)

