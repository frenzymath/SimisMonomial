variable {σ K ι : Type*} [Field K] [DecidableEq σ] [Fintype σ] [Fintype ι]
omit [DecidableEq σ] [Fintype σ] in
/-- Two exponent vectors with disjoint supports have joint equal to sum. -/
theorem prop62_sup_eq_add_of_disjoint_support {u v : σ →₀ ℕ}
    (huv : Disjoint u.support v.support) : u ⊔ v = u + v := by
  ext x
  rw [Finsupp.sup_apply]
  by_cases hu : u x = 0
  · simp [hu]
  · by_cases hv : v x = 0
    · simp [hv]
    · exfalso
      exact (Finset.disjoint_left.mp huv (by simpa [Finsupp.mem_support_iff] using hu))
        (by simpa [Finsupp.mem_support_iff] using hv)

omit [DecidableEq σ] [Fintype σ] in
/-- A finite supremum of exponent vectors with pairwise disjoint supports is their sum. -/
theorem prop62_finset_sup_eq_sum_of_disjoint_support {B : ι → Finset σ}
    (hdisj : ∀ j k x, x ∈ B j → x ∈ B k → j = k)
    {c : ι → σ →₀ ℕ} (hc : ∀ h, (c h).support ⊆ B h) :
    Finset.univ.sup c = ∑ h, c h := by
  classical
  have hgen : ∀ s : Finset ι, s.sup c = ∑ h ∈ s, c h := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
        apply le_antisymm
        · exact bot_le
        · rw [Finsupp.le_def]
          intro x
          exact Nat.zero_le _
    | @insert j s hjs ih =>
        rw [Finset.sup_insert, Finset.sum_insert hjs, ih]
        apply prop62_sup_eq_add_of_disjoint_support
        refine Finset.disjoint_left.mpr ?_
        intro x hx hsum
        rcases Finsupp.mem_support_finsetSum x hsum with ⟨k, hks, hxk⟩
        have hjk : j = k := hdisj j k x (hc j hx) (hc k hxk)
        exact hjs (by simpa [hjk] using hks)
  simpa using hgen (Finset.univ : Finset ι)

omit [DecidableEq σ] [Fintype σ] in
/-- A transversal exponent vanishes away from its chosen vertices. -/
theorem prop62_weightedTransversalExp_apply_eq_zero
    {z : ι → σ} {a : σ → ℕ} {x : σ} (hx : ∀ h, z h ≠ x) :
    prop62_weightedTransversalExp a z x = 0 := by
  rw [prop62_weightedTransversalExp, Finset.sum_apply' x]
  refine Finset.sum_eq_zero ?_
  intro h hh
  simp [hx h]

omit [DecidableEq σ] [Fintype σ] in
/-- A weighted transversal exponent has the prescribed exponent at a chosen vertex. -/
theorem prop62_weightedTransversalExp_apply_choice {B : ι → Finset σ}
    (hdisj : ∀ j k x, x ∈ B j → x ∈ B k → j = k)
    {z : ι → σ} (hz : ∀ h, z h ∈ B h) {a : σ → ℕ} (j : ι) :
    prop62_weightedTransversalExp a z (z j) = a (z j) := by
  classical
  rw [prop62_weightedTransversalExp, Finset.sum_apply' (z j)]
  calc
    ∑ k, Finsupp.single (z k) (a (z k)) (z j) =
        ∑ k, if k = j then a (z j) else 0 := by
      refine Finset.sum_congr rfl ?_
      intro k hk
      by_cases hkj : k = j
      · subst k
        simp
      · have hne : z k ≠ z j := by
          intro heq
          exact hkj (hdisj k j (z k) (hz k) (by simpa [heq] using hz j))
        simp [hkj, hne]
    _ = a (z j) := by simp

omit [Fintype σ] in
/-- The support of a positive weighted transversal is exactly its chosen vertex set. -/
theorem prop62_weightedTransversalExp_support {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    {a : σ → ℕ} (ha : ∀ x, 0 < a x) {z : ι → σ} (hz : ∀ h, z h ∈ B h) :
    (prop62_weightedTransversalExp a z).support = Finset.univ.image z := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  ext x
  rw [Finsupp.mem_support_iff]
  constructor
  · intro hx
    by_contra hxnot
    have hxall : ∀ h, z h ≠ x := by
      intro h heq
      apply hxnot
      rw [Finset.mem_image]
      exact ⟨h, by simp, heq⟩
    exact hx (prop62_weightedTransversalExp_apply_eq_zero hxall)
  · intro hx
    rcases (by simpa using hx : ∃ h, z h = x) with ⟨h, rfl⟩
    rw [prop62_weightedTransversalExp_apply_choice hdisj hz h]
    exact ne_of_gt (ha (z h))

omit [Fintype σ] in
/-- The weighted intersection is generated by weighted transversals. -/
theorem prop62_weightedIdeal_eq_monomialIdeal {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} :
    (prop62_weightedIdeal (K := K) B a : Ideal (MvPolynomial σ K)) =
      (monomialIdeal (K := K) (prop62_weightedTransversalGens B a) :
        Ideal (MvPolynomial σ K)) := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  let S : ι → Set (σ →₀ ℕ) := fun h ↦
    {e | ∃ i ∈ B h, e = Finsupp.single i (a i)}
  have hiInf : (prop62_weightedIdeal (K := K) B a : Ideal (MvPolynomial σ K)) =
      (monomialIdeal (K := K) (iInfGens S) : Ideal (MvPolynomial σ K)) := by
    simpa [prop62_weightedIdeal, S, purePower] using
      (monomialIdeal_iInf (K := K) S)
  rw [hiInf]
  apply monomialIdeal_eq_iff.mpr
  intro e
  constructor
  · rintro ⟨u, hu, hue⟩
    rcases hu with ⟨c, hcS, rfl⟩
    have hcdata : ∀ h, ∃ i, i ∈ B h ∧ c h = Finsupp.single i (a i) := by
      simpa [S] using hcS
    choose z hzB hcz using hcdata
    have hcsupport : ∀ h, (c h).support ⊆ B h := by
      intro h x hx
      rw [hcz h] at hx
      have hxnonzero : Finsupp.single (z h) (a (z h)) x ≠ 0 := by
        simpa [Finsupp.mem_support_iff] using hx
      have hxi : x = z h := by
        by_contra hnex
        exact hxnonzero (by simp [hnex])
      simpa [hxi] using hzB h
    have hsup : Finset.univ.sup c = prop62_weightedTransversalExp a z := by
      calc
        Finset.univ.sup c = ∑ h, c h :=
          prop62_finset_sup_eq_sum_of_disjoint_support hdisj hcsupport
        _ = prop62_weightedTransversalExp a z := by
          rw [prop62_weightedTransversalExp]
          refine Finset.sum_congr rfl ?_
          intro h hh
          exact hcz h
    refine ⟨prop62_weightedTransversalExp a z, ⟨z, hzB, rfl⟩, ?_⟩
    simpa [← hsup] using hue
  · rintro ⟨v, hv, hve⟩
    rcases hv with ⟨z, hzB, rfl⟩
    let c : ι → σ →₀ ℕ := fun h ↦ Finsupp.single (z h) (a (z h))
    have hcS : ∀ h, c h ∈ S h := by
      intro h
      exact ⟨z h, hzB h, rfl⟩
    have hcsupport : ∀ h, (c h).support ⊆ B h := by
      intro h x hx
      have hxnonzero : c h x ≠ 0 := by
        simpa [Finsupp.mem_support_iff] using hx
      have hxi : x = z h := by
        by_contra hnex
        exact hxnonzero (by simp [c, hnex])
      simpa [hxi] using hzB h
    have hsup : Finset.univ.sup c = prop62_weightedTransversalExp a z := by
      calc
        Finset.univ.sup c = ∑ h, c h :=
          prop62_finset_sup_eq_sum_of_disjoint_support hdisj hcsupport
        _ = prop62_weightedTransversalExp a z := by
          rfl
    refine ⟨Finset.univ.sup c, ⟨c, hcS, rfl⟩, ?_⟩
    simpa [hsup] using hve

omit [Fintype σ] in
/-- The displayed weighted transversals are precisely the minimal monomial generators. -/
theorem prop62_minGens_weightedIdeal {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    {a : σ → ℕ} (ha : ∀ x, 0 < a x) :
    minGens (prop62_weightedIdeal (K := K) B a) =
      prop62_weightedTransversalGens B a := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  have hIdeal := prop62_weightedIdeal_eq_monomialIdeal (K := K) (B := B) ⟨hne, hdisj, hcover⟩
    (a := a)
  ext e
  constructor
  · intro he
    rw [mem_minGens] at he
    have he' : (monomial e (1 : K) : MvPolynomial σ K) ∈
        monomialIdeal (prop62_weightedTransversalGens B a) := by
      simpa [hIdeal] using he.1
    rcases monomial_mem_monomialIdeal.mp he' with ⟨u, huS, hue⟩
    have huI : (monomial u (1 : K) : MvPolynomial σ K) ∈ prop62_weightedIdeal B a := by
      rw [hIdeal]
      exact monomial_mem_monomialIdeal.mpr ⟨u, huS, le_rfl⟩
    have huet : u = e := he.2 u huI hue
    simpa [← huet] using huS
  · rintro ⟨z, hzB, rfl⟩
    rw [mem_minGens]
    constructor
    · rw [hIdeal]
      exact monomial_mem_monomialIdeal.mpr
        ⟨prop62_weightedTransversalExp a z, ⟨z, hzB, rfl⟩, le_rfl⟩
    · intro u huI hue
      apply le_antisymm hue
      rw [Finsupp.le_def]
      intro x
      by_cases hx : ∃ h, z h = x
      · rcases hx with ⟨h, rfl⟩
        rw [prop62_weightedTransversalExp_apply_choice hdisj hzB h]
        rcases monomial_mem_purePower.mp ((Ideal.mem_iInf.mp huI) h) with
          ⟨i, hiB, hai⟩
        have hieq : i = z h := by
          by_contra hneiz
          have hnotchoice : ∀ k, z k ≠ i := by
            intro k hki
            have hkh : k = h := hdisj k h (z k) (hzB k) (by simpa [hki] using hiB)
            have hzhi : z h = i := by simpa [hkh] using hki
            exact hneiz hzhi.symm
          have hei : prop62_weightedTransversalExp a z i = 0 :=
            prop62_weightedTransversalExp_apply_eq_zero hnotchoice
          have hzero : a i ≤ 0 := hai.trans ((hue i).trans_eq hei)
          exact (not_le_of_gt (ha i)) hzero
        simpa [hieq] using hai
      · have hnotchoice : ∀ h, z h ≠ x := by
          intro h heq
          exact hx ⟨h, heq⟩
        rw [prop62_weightedTransversalExp_apply_eq_zero hnotchoice]
        exact Nat.zero_le _

omit [DecidableEq σ] [Fintype σ] in
/-- Unit weights give the ordinary squarefree transversal exponent. -/
theorem prop62_weightedTransversalExp_one {z : ι → σ} :
    prop62_weightedTransversalExp (fun _ : σ ↦ 1) z = prop62_transversalExp z := by
  rfl

omit [DecidableEq σ] [Fintype σ] in
/-- Unit weights give the set of ordinary squarefree transversal generators. -/
theorem prop62_weightedTransversalGens_one (B : ι → Finset σ) :
    prop62_weightedTransversalGens B (fun _ : σ ↦ 1) = prop62_transversalGens B := by
  ext e
  simp [prop62_weightedTransversalGens, prop62_transversalGens,
    prop62_weightedTransversalExp_one]

omit [DecidableEq σ] [Fintype σ] [Fintype ι] in
/-- Unit weights turn the weighted ideal into the intersection of block primes. -/
theorem prop62_weightedIdeal_one (B : ι → Finset σ) :
    (prop62_weightedIdeal (K := K) B (fun _ : σ ↦ 1) : Ideal (MvPolynomial σ K)) =
      prop62_rootIdeal (K := K) B := by
  rfl

omit [Fintype σ] in
/-- The root ideal is generated by squarefree transversals. -/
theorem prop62_rootIdeal_eq_monomialIdeal {B : ι → Finset σ} (hB : prop62_BlockFamily B) :
    (prop62_rootIdeal (K := K) B : Ideal (MvPolynomial σ K)) =
      (monomialIdeal (K := K) (prop62_transversalGens B) : Ideal (MvPolynomial σ K)) := by
  calc
    prop62_rootIdeal (K := K) B = prop62_weightedIdeal (K := K) B (fun _ : σ ↦ 1) := by rfl
    _ = monomialIdeal (prop62_weightedTransversalGens B (fun _ : σ ↦ 1)) :=
      prop62_weightedIdeal_eq_monomialIdeal (K := K) hB (a := fun _ : σ ↦ 1)
    _ = monomialIdeal (prop62_transversalGens B) := by
      rw [prop62_weightedTransversalGens_one]

omit [Fintype σ] in
/-- The displayed squarefree transversals are the minimal generators of the root. -/
theorem prop62_minGens_rootIdeal {B : ι → Finset σ} (hB : prop62_BlockFamily B) :
    minGens (prop62_rootIdeal (K := K) B) = prop62_transversalGens B := by
  change minGens (prop62_weightedIdeal (K := K) B (fun _ : σ ↦ 1)) =
    prop62_transversalGens B
  calc
    minGens (prop62_weightedIdeal (K := K) B (fun _ : σ ↦ 1)) =
        prop62_weightedTransversalGens B (fun _ : σ ↦ 1) :=
      prop62_minGens_weightedIdeal (K := K) hB (a := fun _ : σ ↦ 1) (fun _ ↦ Nat.zero_lt_one)
    _ = prop62_transversalGens B := prop62_weightedTransversalGens_one B

omit [Fintype σ] in
/-- A squarefree transversal exponent is the characteristic vector of its chosen set. -/
theorem prop62_transversalExp_eq_characteristicExp {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {z : ι → σ} (hz : ∀ h, z h ∈ B h) :
    prop62_transversalExp z = characteristicExp (Finset.univ.image z) := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  ext x
  by_cases hx : x ∈ Finset.univ.image z
  · rcases Finset.mem_image.mp hx with ⟨h, hh, hzx⟩
    subst x
    have hcoord : prop62_transversalExp z (z h) = 1 := by
      change prop62_weightedTransversalExp (fun _ : σ ↦ 1) z (z h) = 1
      exact prop62_weightedTransversalExp_apply_choice hdisj hz h
    have himg : z h ∈ Finset.univ.image z := Finset.mem_image.mpr ⟨h, by simp, rfl⟩
    simpa [characteristicExp_apply, himg] using hcoord
  · have hnot : ∀ h, z h ≠ x := by
      intro h heq
      exact hx (Finset.mem_image.mpr ⟨h, by simp, heq⟩)
    have hcoord : prop62_transversalExp z x = 0 := by
      change prop62_weightedTransversalExp (fun _ : σ ↦ 1) z x = 0
      exact prop62_weightedTransversalExp_apply_eq_zero hnot
    simpa [characteristicExp_apply, hx] using hcoord

omit [Fintype σ] in
/-- Squarefree transversal generators are exactly characteristic vectors of facets. -/
theorem prop62_transversalGens_eq_characteristicExp_facets {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) :
    prop62_transversalGens B = characteristicExp '' prop62_facets B := by
  ext e
  constructor
  · rintro ⟨z, hz, rfl⟩
    refine ⟨Finset.univ.image z, ⟨z, hz, rfl⟩, ?_⟩
    exact (prop62_transversalExp_eq_characteristicExp hB hz).symm
  · rintro ⟨T, hT, hTe⟩
    rcases hT with ⟨z, hz, rfl⟩
    refine ⟨z, hz, ?_⟩
    exact hTe.symm.trans (prop62_transversalExp_eq_characteristicExp hB hz).symm

omit [Fintype σ] in
/-- The block-prime intersection has an explicitly squarefree monomial representation. -/
theorem prop62_rootIdeal_isSquarefree {B : ι → Finset σ} (hB : prop62_BlockFamily B) :
    IsSquarefreeMonomialIdeal (prop62_rootIdeal (K := K) B) := by
  refine ⟨prop62_facets B, ?_⟩
  calc
    prop62_rootIdeal (K := K) B = monomialIdeal (prop62_transversalGens B) :=
      prop62_rootIdeal_eq_monomialIdeal (K := K) hB
    _ = monomialIdeal (characteristicExp '' prop62_facets B) := by
      rw [prop62_transversalGens_eq_characteristicExp_facets hB]

omit [Fintype σ] in
/-- Diagonal weighting carries a squarefree transversal to the weighted one. -/
theorem prop62_diagExp_transversalExp {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    {z : ι → σ} (hz : ∀ h, z h ∈ B h) {a : σ → ℕ} :
    diagExp a (prop62_transversalExp z) = prop62_weightedTransversalExp a z := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  ext x
  by_cases hx : ∃ h, z h = x
  · rcases hx with ⟨h, rfl⟩
    have hsquare : prop62_transversalExp z (z h) = 1 := by
      change prop62_weightedTransversalExp (fun _ : σ ↦ 1) z (z h) = 1
      exact prop62_weightedTransversalExp_apply_choice hdisj hz h
    have hweighted := prop62_weightedTransversalExp_apply_choice hdisj hz (a := a) h
    simp [diagExp_apply, hsquare, hweighted]
  · have hnot : ∀ h, z h ≠ x := by
      intro h heq
      exact hx ⟨h, heq⟩
    have hsquare : prop62_transversalExp z x = 0 := by
      change prop62_weightedTransversalExp (fun _ : σ ↦ 1) z x = 0
      exact prop62_weightedTransversalExp_apply_eq_zero hnot
    have hweighted := prop62_weightedTransversalExp_apply_eq_zero (a := a) hnot
    simp [diagExp_apply, hsquare, hweighted]

omit [Fintype σ] in
/-- The weighted generators are the diagonal image of the squarefree generators. -/
theorem prop62_weightedTransversalGens_eq_diagExp_image {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} :
    prop62_weightedTransversalGens B a = diagExp a '' prop62_transversalGens B := by
  ext e
  constructor
  · rintro ⟨z, hz, rfl⟩
    refine ⟨prop62_transversalExp z, ⟨z, hz, rfl⟩, ?_⟩
    exact prop62_diagExp_transversalExp hB hz
  · rintro ⟨u, hu, rfl⟩
    rcases hu with ⟨z, hz, rfl⟩
    refine ⟨z, hz, ?_⟩
    exact prop62_diagExp_transversalExp hB hz

/-- Proposition 6.2's diagonal representation \(I_a=J^{\delta_a}\). -/
theorem prop62_weightedIdeal_eq_diagonal_rootIdeal {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} :
    diagonal a (prop62_rootIdeal (K := K) B) = prop62_weightedIdeal (K := K) B a := by
  have hroot : (prop62_rootIdeal (K := K) B : Ideal (MvPolynomial σ K)) =
      (monomialIdeal (K := K) (prop62_transversalGens B) :
        Ideal (MvPolynomial σ K)) :=
    prop62_rootIdeal_eq_monomialIdeal (K := K) hB
  have hgens : prop62_weightedTransversalGens B a = diagExp a '' prop62_transversalGens B :=
    prop62_weightedTransversalGens_eq_diagExp_image hB
  have hweighted : (prop62_weightedIdeal (K := K) B a : Ideal (MvPolynomial σ K)) =
      (monomialIdeal (K := K) (prop62_weightedTransversalGens B a) :
        Ideal (MvPolynomial σ K)) :=
    prop62_weightedIdeal_eq_monomialIdeal (K := K) hB
  calc
    diagonal a (prop62_rootIdeal (K := K) B) =
        diagonal a (monomialIdeal (prop62_transversalGens B) :
          Ideal (MvPolynomial σ K)) := by rw [hroot]
    _ = monomialIdeal (diagExp a '' prop62_transversalGens B) :=
      diagonal_monomialIdeal a (prop62_transversalGens B)
    _ = monomialIdeal (prop62_weightedTransversalGens B a) := by rw [← hgens]
    _ = prop62_weightedIdeal (K := K) B a := hweighted.symm

omit [Fintype σ] [Fintype ι] in
/-- A monomial whose exponent is a finite sum belongs to the corresponding ideal product. -/
theorem prop62_monomial_sum_mem_finsetProd {S : ι → Set (σ →₀ ℕ)} {c : ι → σ →₀ ℕ}
    {s : Finset ι} (hc : ∀ h ∈ s, c h ∈ S h) :
    (monomial (∑ h ∈ s, c h) (1 : K) : MvPolynomial σ K) ∈
      ∏ h ∈ s, (monomialIdeal (K := K) (S h) : Ideal (MvPolynomial σ K)) := by
  classical
  induction s using Finset.induction_on generalizing c with
  | empty => simp
  | @insert j s hjs ih =>
      rw [Finset.prod_insert hjs, Finset.sum_insert hjs]
      have hgenj : (monomial (c j) (1 : K) : MvPolynomial σ K) ∈
          (monomialIdeal (K := K) (S j) : Ideal (MvPolynomial σ K)) :=
        monomial_mem_monomialIdeal.mpr ⟨c j, hc j (by simp), le_rfl⟩
      have hgens : (monomial (∑ h ∈ s, c h) (1 : K) : MvPolynomial σ K) ∈
          ∏ h ∈ s, (monomialIdeal (K := K) (S h) : Ideal (MvPolynomial σ K)) :=
        ih (fun h hh ↦ hc h (by simp [hh]))
      have hmul := Ideal.mul_mem_mul hgenj hgens
      simpa [monomial_mul] using hmul

omit [Fintype σ] in
/-- On pairwise disjoint supports, a finite monomial-ideal intersection is a product. -/
theorem prop62_iInf_eq_finsetProd_monomialIdeal {B : ι → Finset σ}
    (hdisj : ∀ j k x, x ∈ B j → x ∈ B k → j = k)
    {S : ι → Set (σ →₀ ℕ)} (hsupp : ∀ h e, e ∈ S h → e.support ⊆ B h) :
    (⨅ h, (monomialIdeal (K := K) (S h) : Ideal (MvPolynomial σ K))) =
      ∏ h, (monomialIdeal (K := K) (S h) : Ideal (MvPolynomial σ K)) := by
  classical
  have hiInf : (⨅ h, (monomialIdeal (K := K) (S h) : Ideal (MvPolynomial σ K))) =
      (monomialIdeal (K := K) (iInfGens S) : Ideal (MvPolynomial σ K)) :=
    monomialIdeal_iInf S
  apply le_antisymm
  · rw [hiInf, monomialIdeal, Ideal.span_le]
    rintro y ⟨z, hz, rfl⟩
    rcases hz with ⟨c, hcS, rfl⟩
    have hsup : Finset.univ.sup c = ∑ h, c h :=
      prop62_finset_sup_eq_sum_of_disjoint_support hdisj
        (fun h ↦ hsupp h (c h) (hcS h))
    simpa [hsup] using
      (prop62_monomial_sum_mem_finsetProd (K := K) (s := (Finset.univ : Finset ι))
        (fun h hh ↦ hcS h))
  · refine le_iInf fun j ↦ ?_
    rw [Finset.prod_eq_mul_prod_sdiff_singleton j
      (fun h ↦ (monomialIdeal (K := K) (S h) : Ideal (MvPolynomial σ K)))
      (by intro hj; exact (hj (by simp)).elim)]
    exact Ideal.mul_le_left

omit [DecidableEq σ] [Fintype σ] in
/-- Support bounds propagate from monomial ideal generators to all `powGens`. -/
theorem prop62_powGens_support_subset {A : Finset σ} {S : Set (σ →₀ ℕ)}
    (hsupp : ∀ e ∈ S, e.support ⊆ A) :
    ∀ n e, e ∈ powGens S n → e.support ⊆ A := by
  intro n
  induction n with
  | zero =>
      intro e he
      simp only [powGens] at he
      subst e
      intro x hx
      simp at hx
  | succ n ih =>
      intro e he
      simp only [powGens] at he
      rcases he with ⟨u, hu, v, hv, rfl⟩
      intro x hx
      have hxuv : u x + v x ≠ 0 := by
        simpa [Finsupp.mem_support_iff] using hx
      by_cases hux : u x = 0
      · have hvx : v x ≠ 0 := by
          intro hvx
          exact hxuv (by simp [hux, hvx])
        exact hsupp v hv (by simpa [Finsupp.mem_support_iff] using hvx)
      · exact ih u hu (by simpa [Finsupp.mem_support_iff] using hux)

