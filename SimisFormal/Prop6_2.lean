theorem prop62_root_associatedPrimes_pow_eq_range_of_powerAss {B : ι → Finset σ}
    (hB : prop62_BlockFamily B)
    (hpow : prop62_hasRootPowerAssociatedPrimes (K := K) B)
    {q : ℕ} (hq : 1 ≤ q) :
    associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ prop62_rootIdeal (K := K) B ^ q) =
      Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K))) := by
  by_cases hq1 : q = 1
  · subst q
    rw [pow_one]
    exact prop62_associatedPrimes_root_eq_range (K := K) hB
  · exact hpow q (by omega)

/-- Normal torsion-freeness of \(I_a\) follows from the explicit power-Ass input. -/
theorem prop62_weighted_isNormallyTorsionFree_of_powerAss {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    (hpow : prop62_hasWeightedPowerAssociatedPrimes (K := K) B a) :
    prop21NormallyTorsionFree (prop62_weightedIdeal (K := K) B a) := by
  intro q hq
  exact le_of_eq
    ((prop62_weighted_associatedPrimes_pow_eq_range_of_powerAss (K := K) hB ha hpow hq).trans
      (prop62_associatedPrimes_weighted_eq_range (K := K) hB ha).symm)

/-- Normal torsion-freeness of \(J\) follows from the explicit power-Ass input. -/
theorem prop62_root_isNormallyTorsionFree_of_powerAss {B : ι → Finset σ}
    (hB : prop62_BlockFamily B)
    (hpow : prop62_hasRootPowerAssociatedPrimes (K := K) B) :
    prop21NormallyTorsionFree (prop62_rootIdeal (K := K) B) := by
  intro q hq
  exact le_of_eq
    ((prop62_root_associatedPrimes_pow_eq_range_of_powerAss (K := K) hB hpow hq).trans
