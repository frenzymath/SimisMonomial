/-- A block choice is injective when the blocks are pairwise disjoint. -/
theorem prop62_choice_injective {B : ι → Finset σ}
    (hdisj : ∀ j k x, x ∈ B j → x ∈ B k → j = k) {z : ι → σ} (hz : ∀ h, z h ∈ B h) :
    Function.Injective z := by
  intro j k hjk
  exact hdisj j k (z j) (hz j) (by simpa [hjk] using hz k)

omit [Fintype σ] in
/-- A finite set of cardinality at least two has a second element. -/
theorem prop62_exists_ne_of_two_le_card {A : Finset σ} (hcard : 2 ≤ A.card)
    {x : σ} (_hx : x ∈ A) : ∃ y ∈ A, y ≠ x := by
  classical
  by_contra h
  have hsub : A ⊆ {x} := by
    intro y hy
    have hyx : y = x := by
      by_contra hyx
      exact h ⟨y, hy, hyx⟩
    simp [hyx]
  have hcardle : A.card ≤ ({x} : Finset σ).card := Finset.card_le_card hsub
  simp at hcardle
  omega

omit [Fintype σ] in
/-- Replacing one entry of a transversal changes its facet at exactly that entry. -/
theorem prop62_facet_update_eq {B : ι → Finset σ} [DecidableEq ι]
    (hdisj : ∀ j k x, x ∈ B j → x ∈ B k → j = k) {z : ι → σ} (hz : ∀ h, z h ∈ B h)
    (k : ι) (w : σ) :
    Finset.univ.image (fun h ↦ if h = k then w else z h) =
      insert w ((Finset.univ.image z).erase (z k)) := by
  classical
  have hzinj : Function.Injective z := prop62_choice_injective hdisj hz
  ext x
  constructor
  · intro hx
    rcases Finset.mem_image.mp hx with ⟨j, hj, hjx⟩
    by_cases hjk : j = k
    · have hwx : w = x := by simpa [hjk] using hjx
      exact Finset.mem_insert.mpr (Or.inl hwx.symm)
    · have hzjx : z j = x := by simpa [hjk] using hjx
      have hxF : x ∈ Finset.univ.image z :=
        Finset.mem_image.mpr ⟨j, by simp, hzjx⟩
      have hxne : x ≠ z k := by
        intro hxz
        exact hjk (hzinj (hzjx.trans hxz))
      exact Finset.mem_insert.mpr
        (Or.inr (Finset.mem_erase.mpr ⟨hxne, hxF⟩))
  · intro hx
    rcases Finset.mem_insert.mp hx with hxw | hxer
    · exact Finset.mem_image.mpr ⟨k, by simp, by simpa using hxw.symm⟩
    · rcases Finset.mem_erase.mp hxer with ⟨hxne, hxF⟩
      rcases Finset.mem_image.mp hxF with ⟨j, hj, hjx⟩
      have hjk : j ≠ k := by
        intro heq
        subst j
        exact hxne hjx.symm
      exact Finset.mem_image.mpr ⟨j, by simp, by simpa [hjk] using hjx⟩

omit [Fintype σ] in
/-- Changing one entry of a block choice yields another transversal facet. -/
theorem prop62_facet_update_mem {B : ι → Finset σ} [DecidableEq ι] {z : ι → σ}
    (hz : ∀ h, z h ∈ B h)
    {k : ι} {w : σ} (hw : w ∈ B k) :
    Finset.univ.image (fun h ↦ if h = k then w else z h) ∈ prop62_facets B := by
  classical
  refine ⟨fun h ↦ if h = k then w else z h, ?_, rfl⟩
  intro h
  by_cases hhk : h = k
  · simpa [hhk] using hw
  · simpa [hhk] using hz h

omit [Fintype σ] in
/-- The transversal facet complex has no leaf once two blocks have at least two elements. -/
theorem prop62_noLeaf_of_twoLargeBlocks {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    (hlarge : prop62_twoLargeBlocks B) : ¬ ∃ F, IsLeaf (prop62_facets B) F := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  rcases hlarge with ⟨j₀, k₀, hj₀k₀, hcardj₀, hcardk₀⟩
  rintro ⟨F, hFleaf⟩
  rcases hFleaf with ⟨hF, hleaf⟩
  rcases hF with ⟨z, hz, hF⟩
  subst F
  rcases hleaf with hall | hjoint
  · obtain ⟨w, hwB, hwne⟩ :=
      prop62_exists_ne_of_two_le_card hcardj₀ (hz j₀)
    let z' : ι → σ := fun h ↦ if h = j₀ then w else z h
    have hH : Finset.univ.image z' ∈ prop62_facets B := by
      simpa [z'] using prop62_facet_update_mem (B := B) hz hwB
    have hzmem : z j₀ ∈ Finset.univ.image z :=
      Finset.mem_image.mpr ⟨j₀, by simp, rfl⟩
    have hzmem' : z j₀ ∉ Finset.univ.image z' := by
      rw [show Finset.univ.image z' = insert w ((Finset.univ.image z).erase (z j₀)) by
        simpa [z'] using prop62_facet_update_eq hdisj hz j₀ w]
      simp [hwne.symm]
    have hHne : Finset.univ.image z' ≠ Finset.univ.image z := by
      intro heq
      exact hzmem' (by rw [heq]; exact hzmem)
    exact hHne (hall (Finset.univ.image z') hH)
  · rcases hjoint with ⟨G, hG, hGF, hjoint⟩
    rcases hG with ⟨y, hy, hG⟩
    subst G
    have hdiff : ∃ d, z d ≠ y d := by
      by_contra hn
      apply hGF
      have hzy : z = y := by
        funext d
        by_contra hd
        exact hn ⟨d, hd⟩
      rw [hzy]
    rcases hdiff with ⟨d, hdzy⟩
    have hsecond : ∃ l, l ≠ d ∧ 2 ≤ (B l).card := by
      by_cases hjd : j₀ = d
      · refine ⟨k₀, ?_, hcardk₀⟩
        intro hkd
        exact hj₀k₀ (hjd.trans hkd.symm)
      · exact ⟨j₀, hjd, hcardj₀⟩
    rcases hsecond with ⟨l, hld, hcardl⟩
    obtain ⟨w, hwB, hwne⟩ :=
      prop62_exists_ne_of_two_le_card hcardl (hz l)
    let z' : ι → σ := fun h ↦ if h = l then w else z h
    have hH : Finset.univ.image z' ∈ prop62_facets B := by
      simpa [z'] using prop62_facet_update_mem (B := B) hz hwB
    have hzmem : z l ∈ Finset.univ.image z :=
      Finset.mem_image.mpr ⟨l, by simp, rfl⟩
    have hzmem' : z l ∉ Finset.univ.image z' := by
      rw [show Finset.univ.image z' = insert w ((Finset.univ.image z).erase (z l)) by
        simpa [z'] using prop62_facet_update_eq hdisj hz l w]
      simp [hwne.symm]
    have hHne : Finset.univ.image z' ≠ Finset.univ.image z := by
      intro heq
      exact hzmem' (by rw [heq]; exact hzmem)
    have hzdF : z d ∈ Finset.univ.image z :=
      Finset.mem_image.mpr ⟨d, by simp, rfl⟩
    have hzdH : z d ∈ Finset.univ.image z' := by
      refine Finset.mem_image.mpr ⟨d, by simp, ?_⟩
      simp [hld.symm, z']
    have hnotG : z d ∉ Finset.univ.image y := by
      intro hxd
      rcases Finset.mem_image.mp hxd with ⟨r, hr, hrx⟩
      have hrd : r = d :=
        hdisj r d (y r) (hy r) (by simpa [hrx] using hz d)
      subst r
      exact hdzy hrx.symm
    have hxJoint : z d ∈ Finset.univ.image z' ∩ Finset.univ.image z := by
      exact Finset.mem_inter.mpr ⟨hzdH, hzdF⟩
    have hxFG := hjoint (Finset.univ.image z') hH hHne hxJoint
    exact hnotG (Finset.mem_inter.mp hxFG).2

/-- Cyclic permutation of a three-element finset. -/
theorem prop62_insert_rotate {α : Type*} [DecidableEq α] (x y z : α) :
    ({x, y, z} : Finset α) = {y, z, x} := by
  ext t
  simp only [Finset.mem_insert, Finset.mem_singleton]
  aesop

omit [Fintype σ] in
/-- A one-entry replacement meets a three-block transversal in the other two entries. -/
theorem prop62_facet_update_inter_triple {B : ι → Finset σ} [DecidableEq ι]
    (hdisj : ∀ j k x, x ∈ B j → x ∈ B k → j = k) {z : ι → σ} (hz : ∀ h, z h ∈ B h)
    {i j k : ι} (_hij : i ≠ j) (hjk : j ≠ k) (hki : k ≠ i)
    {w : σ} (hwne : w ≠ z k) :
    Finset.univ.image (fun h ↦ if h = k then w else z h) ∩ {z i, z j, z k} =
      {z i, z j} := by
  classical
  have hzinj : Function.Injective z := prop62_choice_injective hdisj hz
  ext x
  constructor
  · intro hx
    rcases Finset.mem_inter.mp hx with ⟨hxU, hxT⟩
    rcases Finset.mem_insert.mp hxT with hxi | hxT
    · exact Finset.mem_insert.mpr (Or.inl hxi)
    · rcases Finset.mem_insert.mp hxT with hxj | hxk'
      · exact Finset.mem_insert.mpr
          (Or.inr (Finset.mem_singleton.mpr hxj))
      · have hxk : x = z k := Finset.mem_singleton.mp hxk'
        rcases Finset.mem_image.mp hxU with ⟨l, hl, hlx⟩
        by_cases hlk : l = k
        · have hwx : w = x := by simpa [hlk] using hlx
          exact (hwne (hwx.trans hxk)).elim
        · have hzlx : z l = x := by simpa [hlk] using hlx
          exact (hlk (hzinj (hzlx.trans hxk))).elim
  · intro hx
    rcases Finset.mem_insert.mp hx with hxi | hxj'
    · have hik : i ≠ k := hki.symm
      have hxU : z i ∈ Finset.univ.image (fun h ↦ if h = k then w else z h) :=
        Finset.mem_image.mpr ⟨i, by simp, by simp [hik]⟩
      exact Finset.mem_inter.mpr
        ⟨by simpa [hxi] using hxU, by simp [hxi]⟩
    · have hxj : x = z j := Finset.mem_singleton.mp hxj'
      have hxU : z j ∈ Finset.univ.image (fun h ↦ if h = k then w else z h) :=
        Finset.mem_image.mpr ⟨j, by simp, by simp [hjk]⟩
      exact Finset.mem_inter.mpr
        ⟨by simpa [hxj] using hxU, by simp [hxj]⟩

/-- The three edges of a strong cycle of length three determine their indices. -/
theorem prop62_fin3_strongCyclePairs_injective {α : Type*} [DecidableEq α]
    {v : Fin 3 → α} (hv : Function.Injective v) :
    Function.Injective (fun i : Fin 3 ↦ ({v i, v (finSuccMod i)} : Finset α)) := by
  classical
  let P : Fin 3 → Finset α := fun i ↦ {v i, v (finSuccMod i)}
  change Function.Injective P
  have h01 : v (0 : Fin 3) ≠ v (1 : Fin 3) := by
    intro h
    exact (by decide : (0 : Fin 3) ≠ 1) (hv h)
  have h02 : v (0 : Fin 3) ≠ v (2 : Fin 3) := by
    intro h
    exact (by decide : (0 : Fin 3) ≠ 2) (hv h)
  have h12 : v (1 : Fin 3) ≠ v (2 : Fin 3) := by
    intro h
    exact (by decide : (1 : Fin 3) ≠ 2) (hv h)
  have hP01 : P 0 ≠ P 1 := by
    intro h
    have hm : v 0 ∈ P 1 := by
      rw [← h]
      simp [P, finSuccMod]
    rcases (by simpa [P, finSuccMod] using hm :
      v (0 : Fin 3) = v (1 : Fin 3) ∨ v (0 : Fin 3) = v (2 : Fin 3)) with h0 | h0
    · exact h01 h0
    · exact h02 h0
  have hP02 : P 0 ≠ P 2 := by
    intro h
    have hm : v 1 ∈ P 2 := by
      rw [← h]
      simp [P, finSuccMod]
    rcases (by simpa [P, finSuccMod] using hm :
      v (1 : Fin 3) = v (2 : Fin 3) ∨ v (1 : Fin 3) = v (0 : Fin 3)) with h1 | h1
    · exact h12 h1
    · exact h01 h1.symm
  have hP12 : P 1 ≠ P 2 := by
    intro h
    have hm : v 1 ∈ P 2 := by
      rw [← h]
      simp [P, finSuccMod]
    rcases (by simpa [P, finSuccMod] using hm :
      v (1 : Fin 3) = v (2 : Fin 3) ∨ v (1 : Fin 3) = v (0 : Fin 3)) with h1 | h1
    · exact h12 h1
    · exact h01 h1.symm
  have hP10 : P 1 ≠ P 0 := fun h ↦ hP01 h.symm
  have hP20 : P 2 ≠ P 0 := fun h ↦ hP02 h.symm
  have hP21 : P 2 ≠ P 1 := fun h ↦ hP12 h.symm
  intro a b h
  by_contra hab
  fin_cases a <;> fin_cases b <;> simp at hab
  all_goals first
    | exact hP01 h
    | exact hP02 h
    | exact hP10 h
    | exact hP12 h
    | exact hP20 h
    | exact hP21 h

omit [Fintype σ] in
/-- Three blocks of cardinality at least two produce a strong triangle of transversals. -/
theorem prop62_hasStrongTriangle_of_threeLargeBlocks {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) (hlarge : prop62_threeLargeBlocks B) :
    HasStrongTriangle (prop62_facets B) := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  rcases hlarge with ⟨i, j, k, hij, hjk, hki, hcardi, hcardj, hcardk⟩
  choose z hz using hne
  obtain ⟨qi, hqiB, hqine⟩ := prop62_exists_ne_of_two_le_card hcardi (hz i)
  obtain ⟨qj, hqjB, hqjne⟩ := prop62_exists_ne_of_two_le_card hcardj (hz j)
  obtain ⟨qk, hqkB, hqkne⟩ := prop62_exists_ne_of_two_le_card hcardk (hz k)
  let C : Fin 3 → ι → σ := fun t h ↦
    if t = 0 then (if h = k then qk else z h)
    else if t = 1 then (if h = i then qi else z h)
    else if h = j then qj else z h
  let E : Fin 3 → Finset σ := fun t ↦ Finset.univ.image (C t)
  let v : Fin 3 → σ := fun t ↦
    if t = 0 then z i else if t = 1 then z j else z k
  have hEmem : ∀ t, E t ∈ prop62_facets B := by
    intro t
    refine ⟨C t, ?_, rfl⟩
    intro h
    fin_cases t
    · by_cases hh : h = k
      · simpa [C, hh] using hqkB
      · simpa [C, hh] using hz h
    · by_cases hh : h = i
      · simpa [C, hh] using hqiB
      · simpa [C, hh] using hz h
    · by_cases hh : h = j
      · simpa [C, hh] using hqjB
      · simpa [C, hh] using hz h
  have hV : Finset.univ.image v = {z i, z j, z k} := by
    ext x
    constructor
    · intro hx
      rcases Finset.mem_image.mp hx with ⟨t, ht, htx⟩
      fin_cases t
      · have hxi : z i = x := by simpa [v] using htx
        rw [← hxi]
        simp
      · have hxj : z j = x := by simpa [v] using htx
        rw [← hxj]
        simp
      · have hxk : z k = x := by simpa [v] using htx
        rw [← hxk]
        simp
    · intro hx
      rcases Finset.mem_insert.mp hx with hxi | hx
      · refine Finset.mem_image.mpr ⟨0, by simp, ?_⟩
        simp [hxi, v]
      · rcases Finset.mem_insert.mp hx with hxj | hxk'
        · refine Finset.mem_image.mpr ⟨1, by simp, ?_⟩
          simp [hxj, v]
        · have hxk : x = z k := Finset.mem_singleton.mp hxk'
          refine Finset.mem_image.mpr ⟨2, by simp, ?_⟩
          simp [hxk, v]
  have hzinj : Function.Injective z := prop62_choice_injective hdisj hz
  have hvij : z i ≠ z j := fun h ↦ hij (hzinj h)
  have hvik : z i ≠ z k := fun h ↦ hki (hzinj h).symm
  have hvjk : z j ≠ z k := fun h ↦ hjk (hzinj h)
  have hvinj : Function.Injective v := by
    intro a b hab
    fin_cases a <;> fin_cases b
    · rfl
    · exfalso; exact hvij (by simpa [v] using hab)
    · exfalso; exact hvik (by simpa [v] using hab)
    · exfalso; exact hvij (by simpa [v] using hab.symm)
    · rfl
    · exfalso; exact hvjk (by simpa [v] using hab)
    · exfalso; exact hvik (by simpa [v] using hab.symm)
    · exfalso; exact hvjk (by simpa [v] using hab.symm)
    · rfl
  have hE0 :
      E 0 ∩ Finset.univ.image v = {z i, z j} := by
    rw [hV]
    simpa [E, C] using
      (prop62_facet_update_inter_triple (B := B) hdisj hz
        (i := i) (j := j) (k := k) hij hjk hki hqkne)
  have hE1 :
      E 1 ∩ Finset.univ.image v = {z j, z k} := by
    rw [hV, prop62_insert_rotate (z i) (z j) (z k)]
    simpa [E, C] using
      (prop62_facet_update_inter_triple (B := B) hdisj hz
        (i := j) (j := k) (k := i) hjk hki hij hqine)
  have hE2 :
      E 2 ∩ Finset.univ.image v = {z k, z i} := by
    rw [hV, prop62_insert_rotate (z i) (z j) (z k),
      prop62_insert_rotate (z j) (z k) (z i)]
    simpa [E, C] using
      (prop62_facet_update_inter_triple (B := B) hdisj hz
        (i := k) (j := i) (k := j) hki hij hjk hqjne)
  have hInter : ∀ t, E t ∩ Finset.univ.image v = {v t, v (finSuccMod t)} := by
    intro t
    fin_cases t
    · simpa [v, finSuccMod, hV] using hE0
    · simpa [v, finSuccMod, hV] using hE1
    · simpa [v, finSuccMod, hV] using hE2
  have hPairInj := prop62_fin3_strongCyclePairs_injective hvinj
  have hEinj : Function.Injective E := by
    intro a b hab
    apply hPairInj
    calc
      ({v a, v (finSuccMod a)} : Finset σ) = E a ∩ Finset.univ.image v :=
        (hInter a).symm
      _ = E b ∩ Finset.univ.image v := by rw [hab]
      _ = {v b, v (finSuccMod b)} := hInter b
  unfold HasStrongTriangle HasStrongCycle
  exact ⟨by norm_num, v, hvinj, E, hEinj, hEmem, hInter⟩

