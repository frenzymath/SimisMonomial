/-- The displayed intersection of block components equals their product. -/
theorem prop62_weightedIdeal_eq_finsetProd {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    {a : σ → ℕ} :
    (prop62_weightedIdeal (K := K) B a : Ideal (MvPolynomial σ K)) =
      ∏ h, (purePower (B h) a : Ideal (MvPolynomial σ K)) := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  let S : ι → Set (σ →₀ ℕ) := fun h ↦
    {e | ∃ i ∈ B h, e = Finsupp.single i (a i)}
  have hsupp : ∀ h e, e ∈ S h → e.support ⊆ B h := by
    intro h e he x hx
    rcases he with ⟨i, hiB, rfl⟩
    have hxi : x = i := by
      by_contra hnexi
      have hxnonzero : Finsupp.single i (a i) x ≠ 0 := by
        simpa [Finsupp.mem_support_iff] using hx
      exact hxnonzero (by simp [hnexi])
    simpa [hxi] using hiB
  simpa [prop62_weightedIdeal, S, purePower] using
    (prop62_iInf_eq_finsetProd_monomialIdeal (K := K) hdisj hsupp)

