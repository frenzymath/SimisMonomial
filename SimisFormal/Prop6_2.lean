/-- Block supports form an antichain. -/
theorem prop62_supportsAntichain {B : ι → Finset σ} (hB : prop62_BlockFamily B) {a : σ → ℕ} :
    SupportsAntichain B (fun _ : ι ↦ a) := by
  rcases hB with ⟨hne, hdisj, hcover⟩
