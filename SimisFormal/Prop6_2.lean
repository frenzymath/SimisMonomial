/-- The support complex of the weighted ideal is the transversal complex. -/
theorem prop62_supportComplex_weighted {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    {a : σ → ℕ} (ha : ∀ x, 0 < a x) :
    supportComplex (prop62_weightedIdeal (K := K) B a) = prop62_facets B := by
