/-- Every minimal monomial generator of a squarefree monomial ideal has exponents at most one. -/
theorem prop62_minGens_le_one_of_isSquarefreeMonomialIdeal
    {I : Ideal (MvPolynomial σ K)} (hI : IsSquarefreeMonomialIdeal I)
    {e : σ →₀ ℕ} (he : e ∈ minGens I) (x : σ) : e x ≤ 1 := by
  classical
  rcases hI with ⟨H, hrep⟩
  rcases mem_minGens.mp he with ⟨heI, hmin⟩
  have heRep : (monomial e (1 : K) : MvPolynomial σ K) ∈
      monomialIdeal (characteristicExp '' H) := by
    simpa [hrep] using heI
  rcases monomial_mem_monomialIdeal.mp heRep with ⟨u, hu, hue⟩
  rcases hu with ⟨T, hTH, rfl⟩
  have huI : (monomial (characteristicExp T) (1 : K) : MvPolynomial σ K) ∈ I := by
    rw [hrep]
    exact monomial_mem_monomialIdeal.mpr
      ⟨characteristicExp T, ⟨T, hTH, rfl⟩, le_rfl⟩
  have hchar : characteristicExp T = e := hmin (characteristicExp T) huI hue
  rw [← hchar]
  by_cases hx : x ∈ T
  · simp [characteristicExp_apply, hx]
  · simp [characteristicExp_apply, hx]

