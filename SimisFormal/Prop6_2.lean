/-- The shared existence hypothesis supplies exponent-one diagonal preservation for all monomial
ideals, using the current `DiagAssociatedPreserve` predicate by definitional equality. -/
theorem prop62_diagonalAssocPreservation_of_finiteDecomp {a : σ → ℕ}
    (hfin : ∀ L : Ideal (MvPolynomial σ K), IsMonomialIdeal L →
      HasFiniteIrredundantDecomp (K := K) L) :
    diagAssoc_PreservesAssociatedPrimes (K := K) a := by
  apply diagAssoc_preservesAssociatedPrimes_of_nontrivialFiniteDecompositions
  intro L hL _ _
  exact hfin L hL

/-- Root powers plus finite monomial decomposition existence imply the weighted power-Ass input. -/
theorem prop62_hasWeightedPowerAssociatedPrimes_of_rootPowerAss_and_finiteDecomp
    {B : ι → Finset σ} (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    (hroot : prop62_hasRootPowerAssociatedPrimes (K := K) B)
    (hfin : ∀ L : Ideal (MvPolynomial σ K), IsMonomialIdeal L →
      HasFiniteIrredundantDecomp (K := K) L) :
    prop62_hasWeightedPowerAssociatedPrimes (K := K) B a := by
  intro q hq
  have hpres : diagAssoc_PreservesAssociatedPrimes (K := K) a :=
    prop62_diagonalAssocPreservation_of_finiteDecomp (K := K) hfin
  have hJmon : IsMonomialIdeal (prop62_rootIdeal (K := K) B) := by
    rcases prop62_rootIdeal_isSquarefree (K := K) hB with ⟨H, hH⟩
    exact ⟨characteristicExp '' H, hH⟩
  have hpowPres : diagAssoc_PreservesAssociatedPrimesOfPowers (K := K)
      (prop62_rootIdeal (K := K) B) a :=
    diagAssoc_preservesAssociatedPrimesOfPowers_of_preservesAssociatedPrimes
      hJmon ha hpres
  calc
    associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ (prop62_weightedIdeal (K := K) B a) ^ q) =
      associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ (diagonal a (prop62_rootIdeal (K := K) B)) ^ q) := by
          rw [prop62_weightedIdeal_eq_diagonal_rootIdeal (K := K) hB]
    _ = associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ (prop62_rootIdeal (K := K) B) ^ q) :=
      hpowPres q (by omega)
    _ = Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K))) :=
      hroot q hq

/-- Weighted associated primes of positive powers from the root analogue and finite decompositions. -/
theorem prop62_weighted_associatedPrimes_pow_eq_range_of_rootPowerAss_and_finiteDecomp
    {B : ι → Finset σ} (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    (hroot : prop62_hasRootPowerAssociatedPrimes (K := K) B)
    (hfin : ∀ L : Ideal (MvPolynomial σ K), IsMonomialIdeal L →
      HasFiniteIrredundantDecomp (K := K) L)
    {q : ℕ} (hq : 1 ≤ q) :
    associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ prop62_weightedIdeal (K := K) B a ^ q) =
      Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K))) := by
  exact prop62_weighted_associatedPrimes_pow_eq_range_of_powerAss (K := K) hB ha
    (prop62_hasWeightedPowerAssociatedPrimes_of_rootPowerAss_and_finiteDecomp
      (K := K) hB ha hroot hfin) hq

/-- Weighted normal torsion-freeness from the root analogue and finite decompositions. -/
theorem prop62_weighted_isNormallyTorsionFree_of_rootPowerAss_and_finiteDecomp
    {B : ι → Finset σ} (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    (hroot : prop62_hasRootPowerAssociatedPrimes (K := K) B)
    (hfin : ∀ L : Ideal (MvPolynomial σ K), IsMonomialIdeal L →
      HasFiniteIrredundantDecomp (K := K) L) :
    prop21NormallyTorsionFree (prop62_weightedIdeal (K := K) B a) := by
  have hpres : diagAssoc_PreservesAssociatedPrimes (K := K) a :=
    prop62_diagonalAssocPreservation_of_finiteDecomp (K := K) hfin
  have hrootNT : prop21NormallyTorsionFree (prop62_rootIdeal (K := K) B) :=
    prop62_root_isNormallyTorsionFree_of_powerAss (K := K) hB hroot
  have hDiagNT : prop21NormallyTorsionFree (diagonal a (prop62_rootIdeal (K := K) B)) :=
    (diagAssoc_normallyTorsionFree_iff_of_associatedPreservation (K := K)
      (J := prop62_rootIdeal (K := K) B) (d := a) (prop62_rootIdeal_isSquarefree (K := K) hB)
      ha hpres).mpr hrootNT
  rw [← prop62_weightedIdeal_eq_diagonal_rootIdeal (K := K) hB]
  exact hDiagNT

/-- With finitely many ambient variables, root power-Ass yields weighted power-Ass. -/
theorem prop62_hasWeightedPowerAssociatedPrimes_of_rootPowerAss {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    (hroot : prop62_hasRootPowerAssociatedPrimes (K := K) B) :
    prop62_hasWeightedPowerAssociatedPrimes (K := K) B a := by
  exact prop62_hasWeightedPowerAssociatedPrimes_of_rootPowerAss_and_finiteDecomp
    (K := K) hB ha hroot
    (fun L hL ↦ hasFiniteIrredundantDecomp_of_isMonomialIdeal (K := K) hL)

/-- Weighted associated primes of positive powers from the root power-Ass analogue alone. -/
theorem prop62_weighted_associatedPrimes_pow_eq_range_of_rootPowerAss
    {B : ι → Finset σ} (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    (hroot : prop62_hasRootPowerAssociatedPrimes (K := K) B)
    {q : ℕ} (hq : 1 ≤ q) :
    associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ prop62_weightedIdeal (K := K) B a ^ q) =
      Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K))) := by
  exact prop62_weighted_associatedPrimes_pow_eq_range_of_rootPowerAss_and_finiteDecomp
    (K := K) hB ha hroot
    (fun L hL ↦ hasFiniteIrredundantDecomp_of_isMonomialIdeal (K := K) hL) hq

/-- Weighted normal torsion-freeness from the root power-Ass analogue alone. -/
theorem prop62_weighted_isNormallyTorsionFree_of_rootPowerAss {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    (hroot : prop62_hasRootPowerAssociatedPrimes (K := K) B) :
    prop21NormallyTorsionFree (prop62_weightedIdeal (K := K) B a) := by
  exact prop62_weighted_isNormallyTorsionFree_of_rootPowerAss_and_finiteDecomp
    (K := K) hB ha hroot
    (fun L hL ↦ hasFiniteIrredundantDecomp_of_isMonomialIdeal (K := K) hL)

/-- Unconditionally, every positive power of the squarefree block ideal has the displayed
associated primes. -/
theorem prop62_root_associatedPrimes_pow_eq_range {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {q : ℕ} (hq : 1 ≤ q) :
    associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ prop62_rootIdeal (K := K) B ^ q) =
      Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K))) := by
  refine associatedPrimes_pow_eq_range_of_componentSimis_antichain
    (K := K) (I := prop62_rootIdeal (K := K) B) (A := B)
    (a := fun _ : ι ↦ fun _ : σ ↦ 1) ?_ ?_ ?_ ?_ (by omega)
  · change HasComponents (prop62_weightedIdeal (K := K) B (fun _ : σ ↦ 1)) B
      (fun _ : ι ↦ fun _ : σ ↦ 1)
    exact prop62_hasComponents_weighted (K := K)
  · exact prop62_isIrredundant (K := K) hB (a := fun _ : σ ↦ 1)
      (fun _ ↦ Nat.zero_lt_one)
  · exact prop62_supportsAntichain (a := fun _ : σ ↦ 1) hB
  · change ComponentSimis (prop62_weightedIdeal (K := K) B (fun _ : σ ↦ 1))
      (fun h ↦ (purePower (B h) (fun _ : σ ↦ 1) : Ideal (MvPolynomial σ K)))
    exact prop62_weighted_componentSimis (K := K) hB (a := fun _ : σ ↦ 1)

/-- The squarefree block ideal is unconditionally normally torsion-free. -/
theorem prop62_root_isNormallyTorsionFree {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) :
    prop21NormallyTorsionFree (prop62_rootIdeal (K := K) B) := by
  refine normallyTorsionFree_of_powerAssociatedPrimes_eq_range
    (I := prop62_rootIdeal (K := K) B)
    (P := fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K)))
    (prop62_associatedPrimes_root_eq_range (K := K) hB) ?_
  intro q hq
  exact prop62_root_associatedPrimes_pow_eq_range (K := K) hB (by omega)

/-- Unconditionally, every positive power of the weighted block ideal has the displayed
associated primes. -/
theorem prop62_weighted_associatedPrimes_pow_eq_range {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    {q : ℕ} (hq : 1 ≤ q) :
    associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ prop62_weightedIdeal (K := K) B a ^ q) =
      Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K))) := by
  exact prop62_weighted_associatedPrimes_pow_eq_range_of_rootPowerAss (K := K) hB ha
    (fun r hr ↦ prop62_root_associatedPrimes_pow_eq_range (K := K) hB (by omega)) hq

/-- The weighted block ideal is unconditionally normally torsion-free. -/
theorem prop62_weighted_isNormallyTorsionFree {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x) :
    prop21NormallyTorsionFree (prop62_weightedIdeal (K := K) B a) := by
  exact prop62_weighted_isNormallyTorsionFree_of_rootPowerAss (K := K) hB ha
    (fun r hr ↦ prop62_root_associatedPrimes_pow_eq_range (K := K) hB (by omega))

