/-- The unit-weight display is a component decomposition of the root ideal. -/
theorem prop62_hasComponents_root (B : ι → Finset σ) :
    HasComponents (prop62_rootIdeal (K := K) B) B (fun _ : ι ↦ fun _ : σ ↦ 1) := by
  change HasComponents (prop62_weightedIdeal (K := K) B (fun _ : σ ↦ 1)) B
    (fun _ : ι ↦ fun _ : σ ↦ 1)
  exact prop62_hasComponents_weighted (K := K)

