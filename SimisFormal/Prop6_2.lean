omit [Fintype σ] in
/-- The displayed weighted decomposition is irredundant when weights are positive. -/
theorem prop62_isIrredundant {B : ι → Finset σ} (hB : prop62_BlockFamily B)
    {a : σ → ℕ} (ha : ∀ x, 0 < a x) :
    IsIrredundant (K := K) B (fun _ : ι ↦ a) := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  choose z hz using hne
  intro j
  let κ := {k : ι // k ≠ j}
  let Bj : κ → Finset σ := fun k ↦ B k.1
  let zj : κ → σ := fun k ↦ z k.1
  have hzj : ∀ k, zj k ∈ Bj k := fun k ↦ hz k.1
  have hdisj' : ∀ k l x, x ∈ Bj k → x ∈ Bj l → k = l := by
    intro k l x hxk hxl
    apply Subtype.ext
    exact hdisj k.1 l.1 x hxk hxl
  let w : σ →₀ ℕ := prop62_weightedTransversalExp a zj
  have hwomit : (monomial w (1 : K) : MvPolynomial σ K) ∈
      decompOmit (K := K) B (fun _ : ι ↦ a) j := by
    rw [decompOmit]
    refine Ideal.mem_iInf.mpr ?_
    intro k
    refine monomial_mem_purePower.mpr ⟨z k.1, hz k.1, ?_⟩
    have hcoord : w (z k.1) = a (z k.1) := by
      change prop62_weightedTransversalExp a zj (zj k) = a (zj k)
      exact prop62_weightedTransversalExp_apply_choice hdisj' hzj k
    exact le_of_eq hcoord.symm
  have hwnot : (monomial w (1 : K) : MvPolynomial σ K) ∉
      (purePower (B j) a : Ideal (MvPolynomial σ K)) := by
    intro hw
    rcases monomial_mem_purePower.mp hw with ⟨i, hiB, hai⟩
    have hnotchoice : ∀ k : κ, zj k ≠ i := by
      intro k hki
      change z k.1 = i at hki
      have hkj : k.1 = j := hdisj k.1 j (z k.1) (hz k.1) (by simpa [hki] using hiB)
      exact k.2 hkj
    have hzero : w i = 0 := by
      change prop62_weightedTransversalExp a zj i = 0
      exact prop62_weightedTransversalExp_apply_eq_zero hnotchoice
    exact (not_le_of_gt (ha i)) (hai.trans_eq hzero)
  intro hle
  exact hwnot (hle hwomit)

