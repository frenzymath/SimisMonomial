  ∀ q : ℕ, 2 ≤ q →
    associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ prop62_rootIdeal (K := K) B ^ q) =
      Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K)))

/-- The associated primes of the weighted block ideal are exactly its displayed block primes. -/
theorem prop62_associatedPrimes_weighted_eq_range {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x) :
    associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ prop62_weightedIdeal (K := K) B a) =
      Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K))) := by
  exact prop21_associatedPrimes_eq_range_of_supportsAntichain
    (prop62_hasComponents_weighted (K := K) (B := B) (a := a))
    (prop62_isIrredundant (K := K) hB ha)
    (prop62_supportsAntichain (a := a) hB)

/-- The associated primes of the squarefree block ideal are exactly its displayed block primes. -/
theorem prop62_associatedPrimes_root_eq_range {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) :
    associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ prop62_rootIdeal (K := K) B) =
      Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K))) := by
  change associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ prop62_weightedIdeal (K := K) B (fun _ : σ ↦ 1)) =
      Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K)))
  exact prop62_associatedPrimes_weighted_eq_range (K := K) hB
    (a := fun _ : σ ↦ 1) (fun _ ↦ Nat.zero_lt_one)

/-- Associated primes of every positive weighted power, modulo the explicit power-Ass input. -/
theorem prop62_weighted_associatedPrimes_pow_eq_range_of_powerAss {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x)
    (hpow : prop62_hasWeightedPowerAssociatedPrimes (K := K) B a)
    {q : ℕ} (hq : 1 ≤ q) :
    associatedPrimes (MvPolynomial σ K)
        (MvPolynomial σ K ⧸ prop62_weightedIdeal (K := K) B a ^ q) =
      Set.range (fun h : ι ↦ (primeOf (B h) : Ideal (MvPolynomial σ K))) := by
  by_cases hq1 : q = 1
  · subst q
    rw [pow_one]
    exact prop62_associatedPrimes_weighted_eq_range (K := K) hB ha
  · exact hpow q (by omega)

