/-- Every ordinary power equals the componentwise intersection power. -/
theorem prop62_weightedIdeal_pow_eq_componentSymbolic {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (q : ℕ) :
    (prop62_weightedIdeal (K := K) B a : Ideal (MvPolynomial σ K)) ^ q =
      componentSymbolic (fun h ↦ (purePower (B h) a : Ideal (MvPolynomial σ K))) q := by
  classical
  rcases hB with ⟨hne, hdisj, hcover⟩
  let S : ι → Set (σ →₀ ℕ) := fun h ↦
    {e | ∃ i ∈ B h, e = Finsupp.single i (a i)}
  let Q : ι → Ideal (MvPolynomial σ K) := fun h ↦ purePower (B h) a
  change prop62_weightedIdeal (K := K) B a ^ q = componentSymbolic Q q
  have hsupp : ∀ h e, e ∈ S h → e.support ⊆ B h := by
    intro h e he x hx
    rcases he with ⟨i, hiB, rfl⟩
    have hxi : x = i := by
      by_contra hnexi
      have hxnonzero : Finsupp.single i (a i) x ≠ 0 := by
        simpa [Finsupp.mem_support_iff] using hx
      exact hxnonzero (by simp [hnexi])
    simpa [hxi] using hiB
  have hsuppPow : ∀ h e, e ∈ powGens (S h) q → e.support ⊆ B h := by
    intro h
    exact prop62_powGens_support_subset (A := B h) (S := S h) (hsupp h) q
  have hprod0 : prop62_weightedIdeal (K := K) B a = ∏ h, Q h := by
    simpa [Q, prop62_weightedIdeal, S, purePower] using
      (prop62_iInf_eq_finsetProd_monomialIdeal (K := K) hdisj hsupp)
  have hprodq : (⨅ h, Q h ^ q) = ∏ h, Q h ^ q := by
    simpa [Q, S, purePower, monomialIdeal_pow] using
      (prop62_iInf_eq_finsetProd_monomialIdeal (K := K) hdisj hsuppPow)
  calc
    prop62_weightedIdeal (K := K) B a ^ q = (∏ h, Q h) ^ q := by rw [hprod0]
    _ = ∏ h, Q h ^ q := by
      simpa using (Finset.prod_pow (s := (Finset.univ : Finset ι)) q
        (fun h ↦ Q h)).symm
    _ = ⨅ h, Q h ^ q := hprodq.symm
    _ = componentSymbolic Q q := rfl

