/-- Under the block-covering hypothesis, \(I_a\) is squarefree precisely for unit weights. -/
theorem prop62_weightedIdeal_isSquarefree_iff {B : ι → Finset σ}
    (hB : prop62_BlockFamily B) {a : σ → ℕ} (ha : ∀ x, 0 < a x) :
    IsSquarefreeMonomialIdeal (prop62_weightedIdeal (K := K) B a) ↔
      a = fun _ : σ ↦ 1 := by
  classical
  constructor
  · intro hsq
    rcases hB with ⟨hne, hdisj, hcover⟩
    choose z₀ hz₀ using hne
    have hBz : prop62_BlockFamily B :=
      ⟨fun h ↦ ⟨z₀ h, hz₀ h⟩, hdisj, hcover⟩
    funext x
    rcases hcover x with ⟨h, hxB⟩
    let z : ι → σ := fun k ↦ if k = h then x else z₀ k
    have hz : ∀ k, z k ∈ B k := by
      intro k
      by_cases hk : k = h
      · simpa [z, hk] using hxB
      · simpa [z, hk] using hz₀ k
    let e : σ →₀ ℕ := prop62_weightedTransversalExp a z
    have heMin : e ∈ minGens (prop62_weightedIdeal (K := K) B a) := by
      rw [prop62_minGens_weightedIdeal (K := K) hBz ha]
      exact ⟨z, hz, rfl⟩
    have hle : e x ≤ 1 :=
      prop62_minGens_le_one_of_isSquarefreeMonomialIdeal hsq heMin x
    have hzh : z h = x := by simp [z]
    have hcoord : e (z h) = a (z h) := by
      change prop62_weightedTransversalExp a z (z h) = a (z h)
      exact prop62_weightedTransversalExp_apply_choice hdisj hz h
    have hcoordx : e x = a x := by simpa [hzh] using hcoord
    rw [hcoordx] at hle
    have hax : 0 < a x := ha x
    omega
  · intro ha1
    rw [ha1, prop62_weightedIdeal_one]
    exact prop62_rootIdeal_isSquarefree (K := K) hB

